	<property name="ireport.zoom" value="1.4641000000000044"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<queryString>
		<![CDATA[SELECT ZM.ZONE_NM,
  MS.STATE_NM,
  MOM.OFF_NAME1,
  MD.DISTRICT_NAME,
  MOM.OFF_TYPE_CD,
  MOM.AGENCY_TYPE,
  MOM.OFF_CD,
  MOM.OFF_NAME,
  NVL(PMT.PRJ_NO_TGT,0) AS PRJ_NO_TGT,
  NVL(PMT.MM_TGT,0) AS MM_TGT
FROM MAS_OFF_MAST MOM,
  M_DISTRICT MD,
  M_STATE MS,
  ZONE_MAST ZM,
  PMEGP_MMTARGET PMT
WHERE MOM.DISTRICT_CD = MD.DISTRICT_CD
AND MD.STATE_CD       = MS.STATE_CD
AND MS.ZONE_CD        = ZM.ZONE_CD
AND MOM.OFF_CD        = PMT.OFF_CD(+)
AND MOM.OFF_TYPE_CD  IN (2, 3, 5, 22)
AND MOM.ACT_YN        = 'Y']]>
	</queryString>
