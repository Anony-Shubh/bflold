	<queryString>
		<![CDATA[SELECT AD.APP_ID,
  AD.APP_NAME,
  AD.BENF_CATAGORY_CD,
  AD.GENDER,
  TO_CHAR(AD.DOB,'DD-MON-RRRR') AS DOB
FROM APP_DETAIL AD,
  BANK_DATAENTRY BD,
  M_DISTRICT MD,
  M_STATE MS,
  MAS_OFF_MAST MOM
WHERE AD.APP_ID    = BD.APP_ID(+)
AND AD.OFF_CD      = MOM.OFF_CD
AND AD.APP_DIST_CD = MD.DISTRICT_CD
AND MD.STATE_CD    = MS.STATE_CD
$P!{vwhercls}
$P!{vwherclspara}]]>
	</queryString>
