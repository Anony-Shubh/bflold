	<summary>
		<band height="20" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="264" height="20" backcolor="#CCCCCC" uuid="9472b2f7-49ee-4973-bc72-d763e514b4c3"/>
				<box leftPadding="4">
					<pen lineWidth="0.5"/>
