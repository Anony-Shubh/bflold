<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DLTFCDashboard" pageWidth="595" pageHeight="842" columnWidth="553" leftMargin="22" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d460efaf-ea7b-40c0-8a97-39e83215cd46">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT AMM.MTG_ID,MS.STATE_NM,MT_DATE,MT.DISTRICT_NAME,amm.MTG_PLACE,
COUNT(DISTINCT(AD.MTG_ID)) AS NO_OF_MTG, COUNT(*) AS APP_NO_PLACED FROM APP_DETAIL AD,
app_meeting_mast amm,
MAS_OFF_MAST mom,M_STATE MS ,M_DISTRICT MD,
M_DISTRICT MT
WHERE AD.MTG_ID=amm.MTG_ID
AND AD.OFF_CD=MOM.OFF_CD
AND AD.MTG_ID IS NOT NULL
AND MOM.DISTRICT_CD=MD.DISTRICT_CD
AND AMM.DISTRICT_CD=MT.DISTRICT_CD
AND MD.STATE_CD=MS.STATE_CD
GROUP BY
AMM.MTG_ID,MS.STATE_NM,MT_DATE,MT.DISTRICT_NAME,amm.MTG_PLACE
ORDER BY STATE_NM, MT_DATE]]>
	</queryString>
	<field name="MTG_ID" class="java.math.BigDecimal"/>
	<field name="STATE_NM" class="java.lang.String"/>
	<field name="MT_DATE" class="java.sql.Timestamp"/>
	<field name="DISTRICT_NAME" class="java.lang.String"/>
	<field name="MTG_PLACE" class="java.lang.String"/>
	<field name="NO_OF_MTG" class="java.math.BigDecimal"/>
	<field name="APP_NO_PLACED" class="java.math.BigDecimal"/>
	<variable name="APP_NO_PLACED_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{APP_NO_PLACED}]]></variableExpression>
	</variable>
	<variable name="NO_OF_MTG_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{NO_OF_MTG}]]></variableExpression>
	</variable>
	<variable name="APP_NO_PLACED_2" class="java.math.BigDecimal" resetType="Group" resetGroup="STATEWISE" calculation="Sum">
		<variableExpression><![CDATA[$F{APP_NO_PLACED}]]></variableExpression>
	</variable>
	<variable name="NO_OF_MTG_2" class="java.math.BigDecimal" resetType="Group" resetGroup="STATEWISE" calculation="Sum">
		<variableExpression><![CDATA[$F{NO_OF_MTG}]]></variableExpression>
	</variable>
