	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT GENDER,SUM(GEND_COUNT)  AS GEND_COUNT FROM
(
SELECT
CASE WHEN GENDER IN ('Women','NA') then
'Non-Individual'
ELSE
GENDER
END GENDER

,COUNT(*) AS GEND_COUNT FROM APP_DETAIL
GROUP BY
GENDER) GROUP BY GENDER]]>
	</queryString>
	<field name="GENDER" class="java.lang.String"/>
	<field name="GEND_COUNT" class="java.math.BigDecimal"/>
