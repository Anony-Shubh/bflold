	<queryString>
		<![CDATA[SELECT
  MOM.AGENCY_TYPE AS AGENCY_TYPE,
  COUNT(*) AS AGENCY_NO
FROM APP_DETAIL AD,
  MAS_OFF_MAST MOM
WHERE AD.OFF_CD = MOM.OFF_CD
GROUP BY MOM.AGENCY_TYPE]]>
	</queryString>
	<field name="AGENCY_TYPE" class="java.lang.String"/>
	<field name="AGENCY_NO" class="java.math.BigDecimal"/>
	<variable name="AGENCY_NO_1" class="java.math.BigDecimal" calculation="Sum">
