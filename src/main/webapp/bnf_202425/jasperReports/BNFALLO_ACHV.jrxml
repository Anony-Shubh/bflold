	<field name="NO_OF_PRJ_B" class="java.math.BigDecimal"/>
	<field name="MM_AMT_B" class="java.math.BigDecimal"/>
	<variable name="MM_ACHV" class="java.math.BigDecimal" calculation="Average">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
