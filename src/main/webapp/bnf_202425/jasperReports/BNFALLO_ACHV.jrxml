	<property name="ireport.x" value="1131"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,
  BNF_HDID,
  OFF_NAME1,
  ZONE_NM,
  CASE
    WHEN BNF_HDID = 17
    THEN 'DEO'
    ELSE BNF_MAIN_HEAD_SH_DESC
  END              AS BNF_MAIN_HEAD_SH_DESC,
  SUM(NO_OF_PRJ)   AS NO_OF_PRJ,
  SUM(MM_AMT)      AS MM_AMT,
  SUM(NO_OF_PRJ_B) AS NO_OF_PRJ_B,
  SUM(MM_AMT_B)    AS MM_AMT_B
FROM (
  (SELECT OFF_CD,
    BNF_HDID,
    OFF_NAME1,
    ZONE_NM,
    BNF_MAIN_HEAD_SH_DESC,
    NO_OF_PRJ,
    ROUND(MM_AMT / 100000, 2) AS MM_AMT,
    0                         AS NO_OF_PRJ_B,
    0                         AS MM_AMT_B
  FROM
    (SELECT OFF_CD,
      OFF_NAME1,
      ZONE_NM,
      BNF_MAIN_HEAD_SH_DESC,
      BNF_HDID,
      SUM(NVL(
      CASE
        WHEN BNF_HDID BETWEEN 3 AND 10
        THEN 1
        ELSE PH_KVIC + PH_KVIB + PH_DIC
      END, 0))                           AS NO_OF_PRJ,
      SUM(FIN_KVIC + FIN_KVIB + FIN_DIC) AS MM_AMT
    FROM
      (SELECT BOM.OFF_CD,
        BHM.BNF_HDID,
        BOM.OFF_NAME1,
        BOM.ZONE_NM,
        BHM.BNF_MAIN_HEAD_SH_DESC,
        NVL(BFT.PH_KVIC, 0)  AS PH_KVIC,
        NVL(BFT.FIN_KVIC, 0) AS FIN_KVIC,
        NVL(BFT.PH_KVIB, 0)  AS PH_KVIB,
        NVL(BFT.FIN_KVIB, 0) AS FIN_KVIB,
        NVL(BFT.PH_DIC, 0)   AS PH_DIC,
        NVL(BFT.FIN_DIC, 0)  AS FIN_DIC,
        BFT.YEAR_ID
      FROM BNF_FO_TRANS BFT,
        BNF_OFF_MAST BOM,
        BNF_HEAD_MAST BHM
      WHERE BFT.OFF_CD(+) = BOM.OFF_CD
      AND BHM.BNF_HDID    = BFT.BUD_ID
       AND BFT.YEAR_ID=$P{YEAR_ID}
      )
    GROUP BY OFF_CD,
      OFF_NAME1,
      ZONE_NM,
      BNF_MAIN_HEAD_SH_DESC,
      BNF_HDID
    )
  )
UNION ALL
  (SELECT OFF_CD,
    BNF_HDID,
    OFF_NAME1,
    ZONE_NM,
    BNF_MAIN_HEAD_SH_DESC,
    0                                                 AS NO_OF_PRJ,
    0                                                 AS MM_AMT,
    (PHY_NO_KVIC_B  + PHY_NO_KVIB_B + PHY_NO_DIC_B)   AS NO_OF_PRJ_B,
    (FIN_AMT_KVIC_B + FIN_AMT_KVIB_B + FIN_AMT_DIC_B) AS MM_AMT_B
  FROM
    (SELECT BBM.OFF_CD,
      BHM.BNF_HDID,
      BOM.OFF_NAME1,
      BOM.ZONE_NM,
      BHM.BNF_MAIN_HEAD_SH_DESC,
      NVL(BBM.PHY_NO_KVIC, 0)  AS PHY_NO_KVIC_B,
      NVL(BBM.PHY_NO_KVIB, 0)  AS PHY_NO_KVIB_B,
      NVL(BBM.PHY_NO_DIC, 0)   AS PHY_NO_DIC_B,
      NVL(BBM.FIN_AMT_KVIC, 0) AS FIN_AMT_KVIC_B,
      NVL(BBM.FIN_AMT_KVIB, 0) AS FIN_AMT_KVIB_B,
      NVL(BBM.FIN_AMT_DIC, 0)  AS FIN_AMT_DIC_B,
      BBM.YEAR_ID
    FROM BNF_BUDGET_MAST BBM,
      BNF_OFF_MAST BOM,
      BNF_HEAD_MAST BHM
    WHERE BBM.OFF_CD = BOM.OFF_CD
    AND BHM.BNF_HDID = BBM.BNF_HDID
    AND BBM.YEAR_ID=$P{YEAR_ID}
    )
  ))
WHERE $P!{wrcls}
GROUP BY OFF_CD,
  BNF_HDID,
  OFF_NAME1,
  ZONE_NM,
  BNF_MAIN_HEAD_SH_DESC]]>
	</queryString>
	<field name="OFF_CD" class="java.math.BigDecimal"/>
	<field name="BNF_HDID" class="java.math.BigDecimal"/>
	<field name="OFF_NAME1" class="java.lang.String"/>
