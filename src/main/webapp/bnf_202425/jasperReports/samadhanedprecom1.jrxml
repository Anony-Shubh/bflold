<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="samadhanedprecom" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d4ffd9ce-c3be-4c5b-a531-e9090e237350">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="66"/>
	<parameter name="PINVUPID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="POFFCD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PMONTHDT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TO_CHAR(SQ.MONTH_DT,'MON-RRRR') AS EDPMONTH, MOM.OFF_NAME1, MOM.OFF_CD, sq.INVUPID, sq.UPDOC_EDP, sq.TOTAL_AMT, sq.TOTAL_INV_AMT,
sq.month_dt, sq.GST_AMT, NVL(sq.edp_no, 0) AS EDP_NO, sq.INV_NO, sq.inv_date, sq.FIVEDAYTRGINVNO, sq.TENDAYTRGINVNO, sq.FIVEDAYTRGINVAMT,
sq.EDPARRPAY, sq.EDPARR_REM, sq.TENDAYTRGINVAMT, sq.TENDAYTRGINVAMT_OLD, sq.FIVEDAYTRGINVAMT_OLD, sq.TENDAYTRGINVNO_OLD, sq.FIVEDAYTRGINVNO_OLD,
sq.FIVEDAYTRGRECOMNO_OLD, sq.TENDAYTRGRECOMNO_OLD, sq.FIVEDAYTRGRECOMAMT_OLD, sq.TENDAYTRGRECOMAMT_OLD, sq.TOTALEDPRECOMAMT, sq.TOTALEDPRECOMNO,
sq.DISALLOW_REASON, sq.GST_AMT_RECOM, sq.TOTALRECOMAMT, sq.EDPARRPAYRECOM, sq.TENDAYTRGRECOMAMT, sq.FIVEDAYTRGRECOMAMT, sq.TENDAYTRGRECOMNO,
sq.FIVEDAYTRGRECOMNO, sq.EDPARRRECOM_REM ,


FIVEDAYTRGINVAMT-FIVEDAYTRGRECOMAMT as  dis5dayamt,
FIVEDAYTRGINVNO-FIVEDAYTRGRECOMNO as dis5dayno,
TENDAYTRGINVAMT-TENDAYTRGRECOMAMT as  dis10dayamt,
TENDAYTRGINVNO-TENDAYTRGRECOMNO as dis10dayno,


FIVEDAYTRGINVAMT_OLD-FIVEDAYTRGRECOMAMT_OLD as  dis5dayOLDamt,
FIVEDAYTRGINVNO_OLD-FIVEDAYTRGRECOMNO_OLD as dis5daynoOLD,

TENDAYTRGINVAMT_OLD-TENDAYTRGRECOMAMT_OLD as  dis10dayamtOLD,
TENDAYTRGINVNO_OLD-TENDAYTRGRECOMNO_OLD as dis10daynoOLD


FROM BNF_ONLINEEDP_INF SQ, MAS_OFF_MAST MOM
WHERE SQ.OFF_CD=MOM.OFF_CD
AND SQ.INVUPID=$P{PINVUPID}
AND SQ.OFF_CD=$P{POFFCD}
AND TRUNC(SQ.MONTH_DT)=$P{PMONTHDT}
AND SQ.UPDOC_EDP IS NOT NULL]]>
	</queryString>
