	<subDataset name="New Dataset 1" uuid="aebf675d-62fb-4bb7-b6d5-e1d1acda15ad">
		<parameter name="MONTH_DT" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT rownum as srno, boi.INVUPID,
  ms.STATE_NM,
  mom.OFF_NAME1,
  boi.OFF_CD,
  boi.GST_AMT,
  boi.TOTAL_INV_AMT,
  boi.TOTAL_AMT,
  boi.FOPAY_AMT,
TO_CHAR(boi.MONTH_DT,'MON-RRRR')MONTH_DT,
--boi.MONTH_DT,
  boi.UPDOC_EDP,
  boi.EDP_NO,
  boi.FIVEDAYTRGRECOMNO,
  boi.TENDAYTRGRECOMNO,
  boi.FIVEDAYTRGRECOMAMT,
  boi.TENDAYTRGRECOMAMT,
  boi.FIVEDAYTRGRECOMNO_OLD,
  boi.TENDAYTRGRECOMNO_OLD,
  boi.TENDAYTRGRECOMAMT_OLD,
  boi.FIVEDAYTRGRECOMAMT_OLD,
  boi.DISALLOW_REASON,
  boi.TOTALEDPRECOMNO,
  boi.TOTALEDPRECOMAMT,boi.INV_NO,
  to_char(boi.INV_DATE,'DD-MON-RRRR')INV_DATE
FROM bnf_onlineedp_inf boi,
  mas_off_mast mom,
  m_district md,
  m_state ms
WHERE mom.DISTRICT_CD = md.DISTRICT_CD
AND md.STATE_CD       = ms.STATE_CD
AND mom.OFF_CD        = boi.OFF_CD
AND boi.MONTH_DT      = $P{MONTH_DT}]]>
		</queryString>
		<field name="SRNO" class="java.math.BigDecimal"/>
		<field name="INVUPID" class="java.math.BigDecimal"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="OFF_NAME1" class="java.lang.String"/>
		<field name="OFF_CD" class="java.lang.String"/>
		<field name="GST_AMT" class="java.math.BigDecimal"/>
		<field name="TOTAL_INV_AMT" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMT" class="java.math.BigDecimal"/>
		<field name="FOPAY_AMT" class="java.math.BigDecimal"/>
		<field name="MONTH_DT" class="java.lang.String"/>
		<field name="UPDOC_EDP" class="java.lang.String"/>
		<field name="EDP_NO" class="java.math.BigDecimal"/>
		<field name="FIVEDAYTRGRECOMNO" class="java.math.BigDecimal"/>
		<field name="TENDAYTRGRECOMNO" class="java.math.BigDecimal"/>
		<field name="FIVEDAYTRGRECOMAMT" class="java.math.BigDecimal"/>
		<field name="TENDAYTRGRECOMAMT" class="java.math.BigDecimal"/>
		<field name="FIVEDAYTRGRECOMNO_OLD" class="java.math.BigDecimal"/>
		<field name="TENDAYTRGRECOMNO_OLD" class="java.math.BigDecimal"/>
		<field name="TENDAYTRGRECOMAMT_OLD" class="java.math.BigDecimal"/>
		<field name="FIVEDAYTRGRECOMAMT_OLD" class="java.math.BigDecimal"/>
		<field name="DISALLOW_REASON" class="java.lang.String"/>
		<field name="TOTALEDPRECOMNO" class="java.lang.String"/>
		<field name="TOTALEDPRECOMAMT" class="java.lang.String"/>
		<field name="INV_NO" class="java.lang.String"/>
		<field name="INV_DATE" class="java.lang.String"/>
	</subDataset>
	<parameter name="MONTH_DT" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from dual]]>
	</queryString>
	<field name="DUMMY" class="java.lang.String"/>
