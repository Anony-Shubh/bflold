<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PUBLICITY" pageWidth="1440" pageHeight="595" orientation="Landscape" columnWidth="1400" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="aeced5ae-0a53-4f66-bb36-9ad6c2b9fee9">
	<property name="ireport.zoom" value="1.100000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PBUDID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,
  BUD_ID,
  STATE_NM,
  ZONE_NM,
  BNF_EVENT,
  SUM(PHY_NO_KVIC  + PHY_NO_KVIB + PHY_NO_DIC)   AS NO_OF_PRJ,
  SUM(FIN_AMT_KVIC + FIN_AMT_KVIB + FIN_AMT_DIC) AS MM_AMT,
  BNF_TYPPUBLICITY,
  TO_CHAR(BNF_AFROMDT, 'DD-MON-RRRR') AS BNF_AFROMDT,
  TO_CHAR(BNF_ATODT, 'DD-MON-RRRR')   AS BNF_ATODT,
  BNF_ATOURDYS,
  BNF_APLACE,
  ORGANIZER,
  BNF_APROGDTLS,
  NVL(SUM(
  CASE
    WHEN BNF_AGENCY = 'KV'
    THEN FIN_KVIC
    WHEN BNF_AGENCY = 'KB'
    THEN FIN_KVIB
    WHEN BNF_AGENCY = 'DI'
    THEN FIN_DIC
  END), 0) AS EXP,
  BNF_AGENCY,
  REMARK_ADD,
  YEAR_ID,
  YEAR_ID1
FROM
  (SELECT BOM.OFF_CD,
    BOM.STATE_NM,
    BOM.ZONE_NM,
    NVL(BBM.PHY_NO_KVIC, 0) AS PHY_NO_KVIC,
    NVL(BBM.FIN_AMT_KVIC, 0) FIN_AMT_KVIC,
    NVL(BBM.FIN_AMT_KVIB, 0) FIN_AMT_KVIB,
    NVL(BBM.FIN_AMT_DIC, 0) FIN_AMT_DIC,
    NVL(BBM.PHY_NO_KVIB, 0) PHY_NO_KVIB,
    NVL(BBM.PHY_NO_DIC, 0) PHY_NO_DIC,
    BFO.BNF_TYPPUBLICITY,
    BFO.BUD_ID,
    BFO.BNF_AFROMDT,
    BFO.BNF_ATODT,
    BFO.BNF_ATOURDYS,
    BFO.BNF_APLACE,
    BFO.BNF_ASTFFNME AS ORGANIZER,
    BFO.BNF_APROGDTLS,
    NVL(BFO.PH_KVIC, 0) PH_KVIC,
    NVL(BFO.FIN_KVIC, 0) FIN_KVIC,
    NVL(BFO.PH_KVIB, 0) PH_KVIB,
    NVL(BFO.FIN_KVIB, 0) FIN_KVIB,
    NVL(BFO.PH_DIC, 0) PH_DIC,
    NVL(BFO.FIN_DIC, 0) FIN_DIC,
    BFO.BNF_AGENCY,
    BFO.REMARK_ADD,
    BFO.BNF_EVENT,
    BFO.YEAR_ID,
    BBM.YEAR_ID AS YEAR_ID1
  FROM BNF_OFF_MAST BOM,
    BNF_BUDGET_MAST BBM,
    BNF_HEAD_MAST BHM,
    BNF_FO_TRANS BFO
  WHERE BOM.OFF_CD = BBM.OFF_CD
  AND BHM.BNF_HDID = BBM.BNF_HDID
  AND BOM.OFF_CD   = BFO.OFF_CD
  AND BHM.BNF_HDID = BFO.BUD_ID
  AND BBM.YEAR_ID=$P{YEAR_ID}
  )
WHERE $P!{wrcls}
AND BUD_ID   = $P{PBUDID}
AND YEAR_ID=$P{YEAR_ID}
GROUP BY OFF_CD,
  BUD_ID,
  STATE_NM,
  ZONE_NM,
  BNF_EVENT,
  BNF_TYPPUBLICITY,
  BNF_ATOURDYS,
  BNF_APLACE,
  ORGANIZER,
  BNF_APROGDTLS,
  BNF_AGENCY,
  REMARK_ADD,
  BNF_AFROMDT,
  BNF_ATODT,
  YEAR_ID,
  YEAR_ID1
ORDER BY ZONE_NM,
  STATE_NM]]>
	</queryString>
