		<variableExpression><![CDATA[$F{ZONE_NM}]]></variableExpression>
	</variable>
	<variable name="EXP_2" class="java.math.BigDecimal" resetType="Group" resetGroup="ZONE_NM" calculation="Sum">
		<variableExpression><![CDATA[$F{EXP}]]></variableExpression>
	</variable>
