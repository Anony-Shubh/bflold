<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reportbnf" pageWidth="720" pageHeight="842" columnWidth="680" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6d8bbcf9-a52d-4a25-b264-7df78d229598">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PBUDID" class="java.lang.String"/>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,
  STATE_NM,
  upper(ZONE_NM) AS zone_nm,
  BUD_ID,
  BNF_SUB_HEAD_SH_DESC                           AS BNF_EVENT,
  SUM(PHY_NO_KVIC  + PHY_NO_KVIB + PHY_NO_DIC)   AS NO_OF_PRJ,
  SUM(FIN_AMT_KVIC + FIN_AMT_KVIB + FIN_AMT_DIC) AS MM_AMT,
  BNF_AFROMDT,
  BNF_ATODT,
  BNF_ATOURDYS,
  BNF_ASTFFNME,
  BNF_ASTFFCNTCT,
  BNF_APLACE,
  BNF_NOOFPARTCPNTS,
  BNF_ACLBNAME,
  REMARK_ADD,
  UPPER(BNF_SUB_HEAD_SH_DESC) AS BNF_SUB_HEAD_SH_DESC,
  BNF_AGENCY,
  NVL(SUM(
  CASE
    WHEN BNF_AGENCY = 'KV'
    THEN FIN_KVIC
    WHEN BNF_AGENCY = 'KB'
    THEN FIN_KVIB
    WHEN BNF_AGENCY = 'DI'
    THEN FIN_DIC
  END), 0) AS EXP,
  CASE
    WHEN BNF_AGENCY = 'KV'
    THEN 'KVIC'
    WHEN BNF_AGENCY = 'KB'
    THEN 'KVIB'
    WHEN BNF_AGENCY = 'DI'
    THEN 'DIC'
  END AS BNFAGENCY,
  YEAR_ID
FROM
  (SELECT BOM.OFF_CD,
    BOM.STATE_NM,
    BOM.ZONE_NM,
    NVL(BBM.PHY_NO_KVIC, 0) AS PHY_NO_KVIC,
    NVL(BBM.FIN_AMT_KVIC, 0) FIN_AMT_KVIC,
    NVL(BBM.FIN_AMT_KVIB, 0) FIN_AMT_KVIB,
    NVL(BBM.FIN_AMT_DIC, 0) FIN_AMT_DIC,
    NVL(BBM.PHY_NO_KVIB, 0) PHY_NO_KVIB,
    NVL(BBM.PHY_NO_DIC, 0) PHY_NO_DIC,
    BFO.BUD_ID,
    TO_CHAR(BFO.BNF_AFROMDT, 'DD-MON-RRRR') AS BNF_AFROMDT,
    TO_CHAR(BFO.BNF_ATODT, 'DD-MON-RRRR')   AS BNF_ATODT,
    BFO.BNF_ATOURDYS,
    BFO.BNF_ASTFFNME,
    BFO.BNF_ASTFFCNTCT,
    BFO.BNF_APLACE,
    NVL(BFO.PH_KVIC, 0) PH_KVIC,
    NVL(BFO.FIN_KVIC, 0) FIN_KVIC,
    NVL(BFO.PH_KVIB, 0) PH_KVIB,
    NVL(BFO.FIN_KVIB, 0) FIN_KVIB,
    NVL(BFO.PH_DIC, 0) PH_DIC,
    NVL(BFO.FIN_DIC, 0) FIN_DIC,
    BFO.BNF_AGENCY,
    BFO.BNF_EVENT,
    BBM.FIN_AMT_KVIC AS FIN_AMT_KVIC1,
    BBM.PHY_NO_KVIC  AS PHY_NO_KVIC1,
    BBM.FIN_AMT_KVIB AS FIN_AMT_KVIB1,
    BBM.FIN_AMT_DIC  AS FIN_AMT_DIC1,
    BBM.PHY_NO_KVIB  AS PHY_NO_KVIB1,
    BBM.PHY_NO_DIC   AS PHY_NO_DIC1,
    BBM.BNF_HDID,
    BHM.BNF_SUB_HEAD_SH_DESC,
    BHM.BNF_HDID AS BNF_HDID1,
    BFO.TR_DATE,
    BFO.PH_KVIC  AS PH_KVIC1,
    BFO.FIN_KVIC AS FIN_KVIC1,
    BFO.PH_KVIB  AS PH_KVIB1,
    BFO.FIN_KVIB AS FIN_KVIB1,
    BFO.PH_DIC   AS PH_DIC1,
    BFO.FIN_DIC  AS FIN_DIC1,
    BFO.BNF_NOOFPARTCPNTS,
    BFO.BNF_ACLBNAME,
    BFO.REMARK_ADD,
    BFO.YEAR_ID,
    BBM.YEAR_ID AS YEAR_ID1
  FROM BNF_OFF_MAST BOM,
    BNF_BUDGET_MAST BBM,
    BNF_HEAD_MAST BHM,
    BNF_FO_TRANS BFO
  WHERE BOM.OFF_CD = BBM.OFF_CD
  AND BHM.BNF_HDID = BBM.BNF_HDID
  AND BOM.OFF_CD   = BFO.OFF_CD
  AND BHM.BNF_HDID = BFO.BUD_ID
  AND BBM.YEAR_ID=$P{YEAR_ID}
  )
WHERE $P!{wrcls}
AND BUD_ID   = $P{PBUDID} AND YEAR_ID=$P{YEAR_ID}
GROUP BY OFF_CD,
  STATE_NM,
  BUD_ID,
  BNF_SUB_HEAD_SH_DESC,
  BNF_AFROMDT,
  BNF_ATODT,
  BNF_ATOURDYS,
  BNF_ASTFFNME,
  BNF_ASTFFCNTCT,
  BNF_APLACE,
  BNF_NOOFPARTCPNTS,
  BNF_ACLBNAME,
  REMARK_ADD,
  BNF_AGENCY,
  BNF_EVENT,
  ZONE_NM,
  YEAR_ID
ORDER BY STATE_NM]]>
	</queryString>
