<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MPR_BFL" pageWidth="1224" pageHeight="595" orientation="Landscape" columnWidth="1184" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="88080ee7-2ac5-40a7-adc8-0463d55e52ce">
	<property name="ireport.zoom" value="0.8467108950806659"/>
	<property name="ireport.x" value="191"/>
	<property name="ireport.y" value="0"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT BNF_SUB_HEAD_LONG_DESC,
  ZONE_NM,
  STATE_NM,
  NVL(TOT_AMT_RCV, 0) - NVL(TOT_AMT, 0) AS AMT_UNSPENT,
  OFF_CD,
  FIN_AMT_KVIC,
  NVL(PHY_NO_KVIC, 0) + NVL(PHY_NO_KVIB, 0) + NVL(PHY_NO_DIC, 0) AS TARGET,
  TOT_AMT_RCV,
  PH_KVIB,
  PH_KVIC,
  FIN_KVIB,
  FIN_KVIC,
  PH_DIC,
  FIN_DIC,
  TOT_AMT,
  TOT_NO_OF_PRJ,
  FIN_AMT_DIC,
  FIN_AMT_KVIB,
  YEAR_ID
FROM
  (SELECT BHM.BNF_SUB_HEAD_LONG_DESC,
    BOM.STATE_NM,
    BOM.ZONE_NM,
    BOM.OFF_CD,
    SUM(NVL(BBM.FIN_AMT_KVIC, 0)) FIN_AMT_KVIC,
    SUM(NVL(BBM.FIN_AMT_KVIB, 0)) FIN_AMT_KVIB,
    SUM(NVL(BBM.FIN_AMT_DIC, 0)) FIN_AMT_DIC,
    SUM(NVL(BBM.PHY_NO_KVIC, 0)) PHY_NO_KVIC,
    SUM(NVL(BBM.PHY_NO_KVIB, 0)) PHY_NO_KVIB,
    SUM(NVL(BBM.PHY_NO_DIC, 0)) PHY_NO_DIC,
    (SUM(NVL(BBM.FIN_AMT_KVIC, 0) + NVL(BBM.FIN_AMT_KVIB, 0) + NVL(BBM.FIN_AMT_DIC, 0)) * 100000) AS TOT_AMT_RCV,
    SUM(NVL(BFO.FIN_KVIC, 0)) FIN_KVIC,
    SUM(NVL(BFO.PH_KVIB, 0)) PH_KVIB,
    SUM(NVL(BFO.PH_KVIC, 0)) PH_KVIC,
    SUM(NVL(BFO.FIN_KVIB, 0)) FIN_KVIB,
    SUM(NVL(BFO.PH_DIC, 0)) PH_DIC,
    SUM(NVL(BFO.FIN_DIC, 0)) FIN_DIC,
    SUM(NVL(BFO.FIN_KVIC, 0) + NVL(BFO.FIN_KVIB, 0) + NVL(BFO.FIN_DIC, 0)) AS TOT_AMT,
    SUM(NVL(BFO.PH_KVIC, 0)  + NVL(BFO.PH_KVIB, 0) + NVL(BFO.PH_DIC, 0))   AS TOT_NO_OF_PRJ,
    BBM.YEAR_ID,
    BFO.YEAR_ID AS YEAR_ID1
  FROM BNF_OFF_MAST BOM,
    BNF_BUDGET_MAST BBM,
    BNF_HEAD_MAST BHM,
    BNF_FO_TRANS BFO
  WHERE BOM.OFF_CD = BBM.OFF_CD
  AND BHM.BNF_HDID = BBM.BNF_HDID
  AND BOM.OFF_CD   = BFO.OFF_CD
  AND BHM.BNF_HDID = BFO.BUD_ID
  AND BBM.YEAR_ID  = BFO.YEAR_ID
 -- AND BOM.OFF_CD   = 29 AND BBM.YEAR_ID='2018-19'
  GROUP BY BHM.BNF_SUB_HEAD_LONG_DESC, BOM.STATE_NM, BOM.ZONE_NM, BOM.OFF_CD, BBM.YEAR_ID,
BFO.YEAR_ID, BBM.PHY_NO_KVIC
  )
WHERE $P!{wrcls}
AND OFF_CD NOT IN (9999)
 AND YEAR_ID=$P{YEAR_ID}
ORDER BY ZONE_NM,
  STATE_NM]]>
	</queryString>
