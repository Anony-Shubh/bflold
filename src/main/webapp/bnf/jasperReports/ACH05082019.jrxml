<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ACH" language="groovy" pageWidth="1080" pageHeight="842" columnWidth="1040" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f7476a6-0481-4737-8acf-9bf57d960a07">
	<property name="ireport.zoom" value="3.138428376721016"/>
	<property name="ireport.x" value="2481"/>
	<property name="ireport.y" value="419"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,
  ZONE_NM,
  OFF_NAME1,
  EDP1,
  ROUND(EDP2 / 100000, 2) AS EDP2,
  P_V1,
  ROUND(P_V2 / 100000, 2) AS P_V2,
  D_L_A_C1,
  ROUND(D_L_A_C2 / 100000, 2) AS D_L_A_C2,
  S_L_W1,
  ROUND(S_L_W2 / 100000, 2) AS S_L_W2,
  D_L_E1,
  ROUND(D_L_E2 / 100000, 2) AS D_L_E2,
  S_L_E1,
  ROUND(S_L_E2 / 100000, 2) AS S_L_E2,
  Z_L_E1,
  ROUND(Z_L_E2 / 100000, 2) AS Z_L_E2,
  Z_L_R_M1,
  ROUND(Z_L_R_M2 / 100000, 2) AS Z_L_R_M2,
  Q_B_R_M1,
  ROUND(Q_B_R_M2 / 100000, 2) AS Q_B_R_M2,
  S_L_M_C_M1,
  ROUND(S_L_M_C_M2 / 100000, 2) AS S_L_M_C_M2,
  S_T_W1,
  ROUND(S_T_W2 / 100000, 2) AS S_T_W2,
  TA_DA1,
  ROUND(TA_DA2 / 100000, 2) AS TA_DA2,
  P_P1,
  ROUND(P_P2 / 100000, 2) AS P_P2,
  D_E_O1,
  ROUND(D_E_O2 / 100000, 2) AS D_E_O2,
  CONT1,
  ROUND(CONT2         / 100000, 2)                                                                                                                                                                                                                                                                      AS CONT2,
  ROUND((NVL(EDP2, 0) + NVL(P_V2, 0) + NVL(D_L_A_C2, 0) + NVL(S_L_W2, 0) + NVL(D_L_E2, 0) + NVL(S_L_E2, 0) + NVL(Z_L_E2, 0) + NVL(Z_L_R_M2, 0) + NVL(Q_B_R_M2, 0) + NVL(S_L_M_C_M2, 0) + NVL(S_T_W2, 0) + NVL(S_T_W2, 0) + NVL(TA_DA2, 0) + NVL(P_P2, 0) + NVL(D_E_O2, 0) + NVL(CONT2, 0)) / 100000, 2) AS tott,
  YEAR_ID
FROM
  (SELECT BOM.OFF_CD,
    BOM.ZONE_NM,
    BOM.OFF_NAME1,
    SUM(DECODE(BFT.BUD_ID, '1', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS EDP1,
    SUM(DECODE(BFT.BUD_ID, '1', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS EDP2,
    SUM(DECODE(BFT.BUD_ID, '2', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS P_V1,
    SUM(DECODE(BFT.BUD_ID, '2', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS P_V2,
    COUNT(DECODE(BFT.BUD_ID, '3', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS D_L_A_C1,
    SUM(DECODE(BFT.BUD_ID, '3', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_L_A_C2,
    COUNT(DECODE(BFT.BUD_ID, '4', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_L_W1,
    SUM(DECODE(BFT.BUD_ID, '4', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_W2,
    COUNT(DECODE(BFT.BUD_ID, '5', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS D_L_E1,
    SUM(DECODE(BFT.BUD_ID, '5', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_L_E2,
    COUNT(DECODE(BFT.BUD_ID, '6', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_L_E1,
    SUM(DECODE(BFT.BUD_ID, '6', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_E2,
    COUNT(DECODE(BFT.BUD_ID, '7', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS Z_L_E1,
    SUM(DECODE(BFT.BUD_ID, '7', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Z_L_E2,
    COUNT(DECODE(BFT.BUD_ID, '8', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS Z_L_R_M1,
    SUM(DECODE(BFT.BUD_ID, '8', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Z_L_R_M2,
    COUNT(DECODE(BFT.BUD_ID, '9', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS Q_B_R_M1,
    SUM(DECODE(BFT.BUD_ID, '9', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Q_B_R_M2,
    COUNT(DECODE(BFT.BUD_ID, '10', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_L_M_C_M1,
    SUM(DECODE(BFT.BUD_ID, '10', NVL(BFT.FIN_KVIC, 0) + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_M_C_M2,
    SUM(DECODE(BFT.BUD_ID, '11', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_T_W1,
    SUM(DECODE(BFT.BUD_ID, '11', NVL(BFT.FIN_KVIC, 0) + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_T_W2,
    SUM(DECODE(BFT.BUD_ID, '12', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS TA_DA1,
    SUM(DECODE(BFT.BUD_ID, '12', NVL(BFT.FIN_KVIC, 0) + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS TA_DA2,
    SUM(DECODE(BFT.BUD_ID, '13', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS P_P1,
    SUM(DECODE(BFT.BUD_ID, '13', NVL(BFT.FIN_KVIC, 0) + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS P_P2,
    SUM(DECODE(BFT.BUD_ID, '14', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS D_E_O1,
    SUM(DECODE(BFT.BUD_ID, '14', NVL(BFT.FIN_KVIC, 0) + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_E_O2,
    SUM(DECODE(BFT.BUD_ID, '15', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS CONT1,
    SUM(DECODE(BFT.BUD_ID, '15', NVL(BFT.FIN_KVIC, 0) + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS CONT2,
    BFT.YEAR_ID
  FROM BNF_FO_TRANS BFT,
    BNF_OFF_MAST BOM
  WHERE BOM.OFF_CD = BFT.OFF_CD(+)
  GROUP BY BOM.OFF_CD,
    BOM.ZONE_NM,
    BOM.OFF_NAME1,
    BFT.YEAR_ID
  )
WHERE $P!{wrcls} AND
YEAR_ID=$P{YEAR_ID}
ORDER BY ZONE_NM]]>
	</queryString>
