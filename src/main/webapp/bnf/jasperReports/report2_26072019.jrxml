	<subDataset name="Table Dataset 1" uuid="0b5039c3-e68d-4953-b6cb-e60915620cb9"/>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT K.*,
  L.*,
  NVL(K.avail_bal, 0) - NVL(L.UTILISE, 0) AS UNSPENT,
  K.YEAR_ID                               AS YEAR_ID1
FROM
  (SELECT O.ZONE_NM,
    O.OFF_CD,
    O.OFF_NAME1,
    M.OB_AMT,
    P.RET_REF_AMT,
    M.REL_AMT,
    T.RECV_AMT,
    ((NVL(M.OB_AMT, 0)) + (NVL(M.REL_AMT, 0)) + (NVL(T.RECV_AMT, 0))) - (NVL(P.RET_REF_AMT, 0)) AS avail_bal,
    M.YEAR_ID
  FROM
    (SELECT BOM.ZONE_NM,
      BOM.OFF_CD,
      BOM.OFF_NAME1
    FROM BNF_BUDGET_MAST BBM,
      BNF_OFF_MAST BOM
    WHERE BOM.OFF_CD = BBM.OFF_CD
    GROUP BY BOM.ZONE_NM,
      BOM.OFF_CD,
      BOM.OFF_NAME1
    ) O,
    (SELECT BFT.TR_OFFCDTO                                          AS OFF_CD,
      SUM(NVL(DECODE(BFT.TR_TYPE, 'OB', NVL(BFT.TR_AMT, 0), 0), 0)) AS OB_AMT,
      SUM(NVL(DECODE(BFT.TR_TYPE, 'RC', NVL(BFT.TR_AMT, 0), 0), 0)) AS REL_AMT,
      BFT.YEAR_ID
    FROM BNF_FUND BFT
    GROUP BY BFT.TR_OFFCDTO,
      BFT.YEAR_ID
    ) M,
    (SELECT BFT.TR_OFFCDFR AS OFF_CD,
      SUM(NVL(
      CASE
        WHEN BFT.TR_TYPE IN ('RT', 'TR')
        THEN BFT.TR_AMT
      END, 0)) AS RET_REF_AMT
    FROM BNF_FUND BFT
    GROUP BY BFT.TR_OFFCDFR
    ) P,
    (SELECT BFT.TR_OFFCDTO AS OFF_CD,
      SUM(NVL(
      CASE
        WHEN BFT.TR_TYPE IN ('RT', 'TR')
        THEN BFT.TR_AMT
      END, 0)) AS RECV_AMT
    FROM BNF_FUND BFT
    GROUP BY BFT.TR_OFFCDTO
    ) T
  WHERE O.OFF_CD = M.OFF_CD(+)
  AND M.OFF_CD   = P.OFF_CD(+)
  AND O.OFF_CD   = T.OFF_CD(+)
  ORDER BY O.ZONE_NM,
    O.OFF_CD
  ) K,
  (SELECT BFT1.OFF_CD,
    ROUND(SUM(NVL(BFT1.FIN_KVIC, 0) + NVL(BFT1.FIN_KVIB, 0) + NVL(BFT1.FIN_DIC, 0)) / 100000, 2) AS UTILISE
  FROM BNF_FO_TRANS BFT1
  GROUP BY BFT1.OFF_CD
  ) L
WHERE K.OFF_CD = L.OFF_CD(+) AND YEAR_ID=$P{YEAR_ID}]]>
	</queryString>
