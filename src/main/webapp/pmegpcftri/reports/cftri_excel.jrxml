	<subDataset name="New Dataset 1" uuid="3aa9b75d-efe9-47af-a22c-f467019be30c">
		<queryString>
			<![CDATA[SELECT
    ct.app_id,
    ad.app_name,
    ct.mob_no,
    ct.email_id,
    ct.annual_turnover,
    ct.sub_activity_cd,
    ct.mfg_product,
    ct.trng_month,
    decode(ct.cftri_visit_yn, 'Y', 'Yes', 'N', 'No')        AS cftri_visit_yn,
    decode(ct.food_process_yn, 'Y', 'Yes', '', 'No')        AS food_process_yn,
    decode(ct.flour_tech_yn, 'Y', 'Yes', '', 'No')          AS flour_tech_yn,
    decode(ct.food_eval_yn, 'Y', 'Yes', '', 'No')           AS food_eval_yn,
    decode(ct.food_micro_yn, 'Y', 'Yes', '', 'No')          AS food_micro_yn,
    decode(ct.food_pck_yn, 'Y', 'Yes', '', 'No')            AS food_pck_yn,
    decode(ct.food_safety_yn, 'Y', 'Yes', '', 'No')         AS food_safety_yn,
    decode(ct.infestation_control_yn, 'Y', 'Yes', '', 'No') AS infestation_control_yn,
    decode(ct.grain_processing_yn, 'Y', 'Yes', '', 'No')    AS grain_processing_yn,
    decode(ct.meat_marine_yn, 'Y', 'Yes', '', 'No')         AS meat_marine_yn,
    decode(ct.food_biotechnology_yn, 'Y', 'Yes', '', 'No')  AS food_biotechnology_yn,
    decode(ct.post_handling_yn, 'Y', 'Yes', '', 'No')       AS post_handling_yn,
    decode(ct.process_spices_yn, 'Y', 'Yes', '', 'No')      AS process_spices_yn,
    decode(ct.electri_in_yn, 'Y', 'Yes', '', 'No')          AS electri_in_yn,
    ct.any_remark,
    to_char(ct.app_timestamp,'DD-MM-YYYY') AS app_timestamp
FROM
    cftri_trg  ct,
    app_detail ad
WHERE
    ct.app_id = ad.app_id]]>
		</queryString>
		<field name="APP_ID" class="java.lang.String"/>
		<field name="APP_NAME" class="java.lang.String"/>
		<field name="MOB_NO" class="java.math.BigDecimal"/>
		<field name="EMAIL_ID" class="java.lang.String"/>
		<field name="ANNUAL_TURNOVER" class="java.lang.String"/>
		<field name="SUB_ACTIVITY_CD" class="java.lang.String"/>
