	<queryString>
		<![CDATA[SELECT  PROC_DT,USR_SH_NM,REF_CL,REF_CL_MM,'Refered' as REF_CLAIMED FROM
(SELECT TRUNC(PROC_DT) AS PROC_DT,USR_SH_NM,

    SUM(
    CASE
      WHEN ACT_ID = 30
      THEN 1
      ELSE 0
    END) AS REF_CL,
    SUM(
    CASE
      WHEN ACT_ID = 30
      THEN ROUND(MM_CLAIM_AMT / 100000, 2)
      ELSE 0
    END) AS REF_CL_MM,
    SUM(
    CASE
      WHEN ACT_ID IN (32,34)
      THEN 1
      ELSE 0
    END) AS RECOM_CL,
    SUM(
    CASE
      WHEN ACT_ID IN (32,34)
      THEN ROUND(MM_CLAIM_AMT / 100000, 2)
      ELSE 0
    END) AS RECOM_MM

  FROM
    (SELECT MOM.OFF_NAME1       AS AGENCY_STATE,
      AD.APP_ID                 AS PMEGP_APPLICANTION_ID,
      AD.APP_NAME               AS APPLICANT_NAME,
      BD.IFSC_CODE              AS IFSC_CODE,
      BD.FB_ACNO                AS TRANSIENT_ACCNT_NO,
      TO_CHAR(BD.APPLOAN_ACCNO) AS LOAN_ACCOUNT_NUMBER,
      BD.MM_CLAIM_AMT           AS MARGIN_MONEY_CLAIMED_AMOUNT,
      MRT.CO_REMARKS,MCU.USR_SH_NM,
      TRUNC(MRT.PROC_DT)                                AS PROC_DT,
      TRUNC(BD.MM_CLAIM_DT)                             AS MM_CLAIM_DT,
      NVL(BAS.ACT_ID, 0)                                AS ACT_ID,
      NVL(BAS.ACT_DESC, 'Pending for MM claim process') AS ACT_DESC,
      NVL(BD.MM_CLAIM_AMT, 0)                           AS MM_CLAIM_AMT,
      BBM.BR_NAME,
      BBM.BR_ADDR,
      BBM.EMAIL,
      BBM.BRANCH_NAME,
      BBM.CONT_NO,
      BBM.DESIG,
      BBM.CONT_NAME,
      BD.APPRV_YN,
      BD.PACT_ID,
      BD.PBATCH_ID,
      TO_CHAR(BD.BATCH_DATE, 'DD-MON-RRRR') AS BTACH_DATE,
      BD.EDP_CERT_DT,
      BD.PAY_STATUS,
      BD.UTRN_NO
    FROM APP_DETAIL AD,
      BANK_DATAENTRY BD,
      MAS_OFF_MAST MOM,
      M_DISTRICT MD,
      M_STATE MS,
      MM_REMARKS_TRANS MRT,MMCLAIM_USER MCU,
      BANK_APP_STATUS BAS,
      BANK_BR_MAST BBM
    WHERE AD.APP_ID       = BD.APP_ID
    AND AD.OFF_CD         = MOM.OFF_CD
    AND AD.UNIT_DIST_CD   = MD.DISTRICT_CD
    AND MS.STATE_CD       = MD.STATE_CD
    AND BD.REMTRID        = MRT.REMTR_ID
    AND MRT.USER_ID       = MCU.USER_ID
    AND BD.PACT_ID        = BAS.ACT_ID(+)
    AND BBM.BR_IFSL_CODE  = BD.IFSC_CODE
    AND BD.MM_CLAIM_AMT   > 0
    AND BD.LOAN_DOCFNAME IS NOT NULL
    )
    WHERE  TRUNC(PROC_DT)  BETWEEN $P{PFRDT} AND $P{PTODT}
  GROUP BY (TRUNC(PROC_DT)),USR_SH_NM)
  UNION
   SELECT PROC_DT,USR_SH_NM,REF_CL,REF_CL_MM,'Refered' as REF_CLAIMED FROM
(SELECT TRUNC(PROC_DT) AS PROC_DT,USR_SH_NM,

    SUM(
    CASE
      WHEN ACT_ID = 30
      THEN 1
      ELSE 0
    END) AS REF_CL,
    SUM(
    CASE
      WHEN ACT_ID = 30
      THEN ROUND(MM_CLAIM_AMT / 100000, 2)
      ELSE 0
    END) AS REF_CL_MM,
    SUM(
    CASE
      WHEN  ACT_ID IN (32,34)
      THEN 1
      ELSE 0
    END) AS RECOM_CL,
    SUM(
    CASE
      WHEN ACT_ID IN (32,34)
      THEN ROUND(MM_CLAIM_AMT / 100000, 2)
      ELSE 0
    END) AS RECOM_MM

  FROM
    (SELECT MOM.OFF_NAME1       AS AGENCY_STATE,
      AD.APP_ID                 AS PMEGP_APPLICANTION_ID,
      AD.APP_NAME               AS APPLICANT_NAME,
      BD.IFSC_CODE              AS IFSC_CODE,
      BD.FB_ACNO                AS TRANSIENT_ACCNT_NO,
      TO_CHAR(BD.APPLOAN_ACCNO) AS LOAN_ACCOUNT_NUMBER,
      BD.MM_CLAIM_AMT           AS MARGIN_MONEY_CLAIMED_AMOUNT,
      MRT.CO_REMARKS,MCU.USR_SH_NM,
      TRUNC(MRT.PROC_DT)                                AS PROC_DT,
      TRUNC(BD.MM_CLAIM_DT)                             AS MM_CLAIM_DT,
      NVL(BAS.ACT_ID, 0)                                AS ACT_ID,
      NVL(BAS.ACT_DESC, 'Pending for MM claim process') AS ACT_DESC,
      NVL(BD.MM_CLAIM_AMT, 0)                           AS MM_CLAIM_AMT,
      BBM.BR_NAME,
      BBM.BR_ADDR,
      BBM.EMAIL,
      BBM.BRANCH_NAME,
      BBM.CONT_NO,
      BBM.DESIG,
      BBM.CONT_NAME,
      BD.APPRV_YN,
      BD.PACT_ID,
      BD.PBATCH_ID,
      TO_CHAR(BD.BATCH_DATE, 'DD-MON-RRRR') AS BTACH_DATE,
      BD.EDP_CERT_DT,
      BD.PAY_STATUS,
      BD.UTRN_NO
    FROM APP_DETAIL AD,
      BANK_DATAENTRY BD,
      MAS_OFF_MAST MOM,
      M_DISTRICT MD,
      M_STATE MS,
      MM_REMARKS_TRANS MRT,MMCLAIM_USER MCU,
      BANK_APP_STATUS BAS,
      BANK_BR_MAST BBM
    WHERE AD.APP_ID       = BD.APP_ID
    AND AD.OFF_CD         = MOM.OFF_CD
    AND AD.UNIT_DIST_CD   = MD.DISTRICT_CD
    AND MS.STATE_CD       = MD.STATE_CD
    AND BD.REMTRID        = MRT.REMTR_ID
    AND MRT.USER_ID       = MCU.USER_ID
    AND BD.PACT_ID        = BAS.ACT_ID(+)
    AND BBM.BR_IFSL_CODE  = BD.IFSC_CODE
    AND BD.MM_CLAIM_AMT   > 0
    AND BD.LOAN_DOCFNAME IS NOT NULL
    )
    WHERE  TRUNC(PROC_DT) BETWEEN $P{PFRDT} AND $P{PTODT}
  GROUP BY (TRUNC(PROC_DT)),USR_SH_NM)
  union
   SELECT PROC_DT,USR_SH_NM,RECOM_CL,RECOM_MM,'Recom.' as REF_CLAIMED FROM
(SELECT TRUNC(PROC_DT) AS PROC_DT,USR_SH_NM,

    SUM(
    CASE
      WHEN ACT_ID = 30
      THEN 1
      ELSE 0
    END) AS REF_CL,
    SUM(
    CASE
      WHEN ACT_ID = 30
      THEN ROUND(MM_CLAIM_AMT / 100000, 2)
      ELSE 0
    END) AS REF_CL_MM,
    SUM(
    CASE
      WHEN ACT_ID IN (32,34)
      THEN 1
      ELSE 0
    END) AS RECOM_CL,
    SUM(
    CASE
      WHEN ACT_ID IN (32,34)
      THEN ROUND(MM_CLAIM_AMT / 100000, 2)
      ELSE 0
    END) AS RECOM_MM

  FROM
    (SELECT MOM.OFF_NAME1       AS AGENCY_STATE,
      AD.APP_ID                 AS PMEGP_APPLICANTION_ID,
      AD.APP_NAME               AS APPLICANT_NAME,
      BD.IFSC_CODE              AS IFSC_CODE,
      BD.FB_ACNO                AS TRANSIENT_ACCNT_NO,
      TO_CHAR(BD.APPLOAN_ACCNO) AS LOAN_ACCOUNT_NUMBER,
      BD.MM_CLAIM_AMT           AS MARGIN_MONEY_CLAIMED_AMOUNT,
      MRT.CO_REMARKS,MCU.USR_SH_NM,
      TRUNC(MRT.PROC_DT)                                AS PROC_DT,
      TRUNC(BD.MM_CLAIM_DT)                             AS MM_CLAIM_DT,
      NVL(BAS.ACT_ID, 0)                                AS ACT_ID,
      NVL(BAS.ACT_DESC, 'Pending for MM claim process') AS ACT_DESC,
      NVL(BD.MM_CLAIM_AMT, 0)                           AS MM_CLAIM_AMT,
      BBM.BR_NAME,
      BBM.BR_ADDR,
      BBM.EMAIL,
      BBM.BRANCH_NAME,
      BBM.CONT_NO,
      BBM.DESIG,
      BBM.CONT_NAME,
      BD.APPRV_YN,
      BD.PACT_ID,
      BD.PBATCH_ID,
      TO_CHAR(BD.BATCH_DATE, 'DD-MON-RRRR') AS BTACH_DATE,
      BD.EDP_CERT_DT,
      BD.PAY_STATUS,
      BD.UTRN_NO
    FROM APP_DETAIL AD,
      BANK_DATAENTRY BD,
      MAS_OFF_MAST MOM,
      M_DISTRICT MD,
      M_STATE MS,
      MM_REMARKS_TRANS MRT,MMCLAIM_USER MCU,
      BANK_APP_STATUS BAS,
      BANK_BR_MAST BBM
    WHERE AD.APP_ID       = BD.APP_ID
    AND AD.OFF_CD         = MOM.OFF_CD
    AND AD.UNIT_DIST_CD   = MD.DISTRICT_CD
    AND MS.STATE_CD       = MD.STATE_CD
    AND BD.REMTRID        = MRT.REMTR_ID
    AND MRT.USER_ID       = MCU.USER_ID
    AND BD.PACT_ID        = BAS.ACT_ID(+)
    AND BBM.BR_IFSL_CODE  = BD.IFSC_CODE
    AND BD.MM_CLAIM_AMT   > 0
    AND BD.LOAN_DOCFNAME IS NOT NULL
    )
    WHERE TRUNC(PROC_DT) BETWEEN $P{PFRDT} AND $P{PTODT}
  GROUP BY (TRUNC(PROC_DT)),USR_SH_NM)]]>
	</queryString>
	<field name="PROC_DT" class="java.sql.Timestamp"/>
	<field name="USR_SH_NM" class="java.lang.String"/>
	<field name="REF_CL" class="java.math.BigDecimal"/>
	<field name="REF_CL_MM" class="java.math.BigDecimal"/>
	<field name="REF_CLAIMED" class="java.lang.String"/>
