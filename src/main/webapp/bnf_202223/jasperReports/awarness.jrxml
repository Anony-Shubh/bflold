<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="awarness" pageWidth="612" pageHeight="1008" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="19d8e020-dc60-47e9-b966-daaa9b7eef79">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PBGTID" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  BOM.ZONE_NM,BBM.OFF_CD,
  BOM.OFF_NAME1,
  NVL(BBM.FIN_AMT_KVIC, 0) AS FIN_AMT_KVIC,
  NVL(BBM.PHY_NO_KVIC, 0)  AS PHY_NO_KVIC,
  NVL(BBM.FIN_AMT_KVIB, 0) AS FIN_AMT_KVIB,
  NVL(BBM.PHY_NO_KVIB, 0)  AS PHY_NO_KVIB,
  NVL(BBM.FIN_AMT_DIC, 0)  AS FIN_AMT_DIC,
  NVL(BBM.PHY_NO_DIC, 0)   AS PHY_NO_DIC,

   NVL(BBM.FIN_AMT_KVIC, 0)+ NVL(BBM.FIN_AMT_KVIB, 0)+ NVL(BBM.FIN_AMT_DIC, 0) AS TOTAL_FAMT,
  NVL(BBM.PHY_NO_KVIC, 0)+ NVL(BBM.PHY_NO_KVIB, 0) + NVL(BBM.PHY_NO_DIC, 0) AS TOTAL_PAMT,


  BBM.BNF_HDID,
  BBM.BNF_BUDID,
  BHM.BNF_SUB_HEAD_SH_DESC

FROM BNF_BUDGET_MAST BBM,
  BNF_HEAD_MAST BHM,
  BNF_OFF_MAST BOM
WHERE BBM.BNF_HDID = BHM.BNF_HDID
AND BBM.OFF_CD     = BOM.OFF_CD
AND BBM.BNF_HDID   = 3
AND BBM.YEAR_ID=$P{YEAR_ID}
 ORDER BY BOM.ZONE_NM]]>
	</queryString>
