	<parameter name="POFFICENAME" class="java.lang.String"/>
	<queryString>
		<![CDATA[select bu.UC_ID, bu.YEAR_ID,
case when mom.off_type_cd=2 then 'State Office'
when mom.off_type_cd=3 then 'Divisional Office'
else 'Zonal Office' end as off_type_cd,
 bu.OFF_CD,
 bu.HO_RECEIVED+bu.SODO_RECEIVED as HOSODO_RECEIVED ,
 bu.REFUND_TO_HO+bu.TRANSFER_TO_SODO as TOT_REF_TRANSF ,
 bu.UC_OPG_BAL,
 bu.INT_EARNED,
 bu.HO_RECEIVED,
 bu.SODO_RECEIVED,
 bu.TOT_AVL_FUND,
 bu.REFUND_TO_HO,
 bu.TRANSFER_TO_SODO,
 bu.REFUND_INT,
 bu.TOTAL_REFUND,
 bu.EXPENDITURE,
 bu.CLOSING_BAL,
decode(bu.off_cd,'9901','Zonal Office Central','9902','Zonal Office East','9903','Zonal Office North','9904','Zonal Office NorthEast','9905','Zonal Office South','9906','Zonal Office West',mom.off_name1)off_name1
 from bnf_uc bu, MAS_OFF_MAST MOM
 where
BU.OFF_CD=MOM.OFF_CD(+) AND
bu.UC_ID=$P{PUC_ID}]]>
	</queryString>
