	<subDataset name="EDP" uuid="8e93ca62-3154-47ca-8f83-61dc2228f91f">
		<queryString language="SQL">
			<![CDATA[SELECT ZONE_NM, STATE_NM,EDP_NO,
  SUM(TOTAL_AMT) total_amt,
  SUM(FOPAY_AMT) fopay_amt,
  SUM(pendingamt) pendingamt
FROM
  (SELECT mos.OFF_CD,
    boi.TOTAL_INV_AMT,
    boi.GST_AMT,
    boi.EDP_NO,
    boi.TOTAL_AMT,
    TO_CHAR(boi.MONTH_DT, 'DD-MON-RRRR') AS MONTH_DT,
    boi.FOPAY_AMT,
    (boi.TOTAL_AMT - boi.FOPAY_AMT) AS pendingamt,
    boi.FOPAY_DT,
    mos.OFF_NAME1,
    mos.STATE_NM,
    mos.ZONE_NM
  FROM bnf_onlineedp_inf boi,
    BNF_OFF_MAST mos
  WHERE boi.OFF_CD = mos.OFF_CD
  AND boi.MONTH_DT BETWEEN '31-MAR-2022' AND '31-MAY-2022'
  )
GROUP BY EDP_NO,

  STATE_NM,
  ZONE_NM]]>
		</queryString>
		<field name="ZONE_NM" class="java.lang.String"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="EDP_NO" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMT" class="java.math.BigDecimal"/>
		<field name="FOPAY_AMT" class="java.math.BigDecimal"/>
		<field name="PENDINGAMT" class="java.math.BigDecimal"/>
		<variable name="TOTAL_EDP" class="java.lang.String" incrementType="Report" calculation="Sum">
			<variableExpression><![CDATA[$F{EDP_NO}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="FROM_DT" class="java.lang.String"/>
	<parameter name="TO_DT" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM DUAL]]>
	</queryString>
	<field name="DUMMY" class="java.lang.String"/>
