	<subDataset name="Table Dataset 1" uuid="458c6401-5346-4570-a307-21ffca8a6757">
		<parameter name="PSINVNO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="PSTATECD" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="POFFCD" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.*  from(
SELECT
    mom.agency_type,
     ms.state_nm     AS state,
    mom.off_name2   AS off_name1,
    md.district_name,
    ad.app_id,
    ad.app_name,
    TO_CHAR(last_day(bsa.inv_date), 'DD-MON-RRRR') AS invoice_dt,
    TO_CHAR(BSA.cert_dt, 'DD-MON-RRRR') AS edp_cert_dt,
CASE WHEN BD.ACT_ID=11 THEN
 nvl(bd.WORKING_CAPITAL,0)+nvl(bd.MACHINARY_COST,0)
ELSE
 nvl(AD.WORKING_CAPITAL,0)+nvl(AD.MACHINARY_COST,0)
END PRJ_COST,
  to_char(bd.LOAN_SANC_DT,'DD-MON-RRRR') as LOAN_SANC_DT,
  to_char(bd.EDP_FR_DT,'DD-MON-RRRR') as EDP_FR_DT,
   to_char(bd.EDP_TO_DT,'DD-MON-RRRR') as EDP_TO_DT,
  nvl( bd.CE_SANC_FB,0)+nvl(bd.WC_SANC_FB,0) as ADMPRJ_COST,CASE WHEN NVL(bd.ACT_ID, 0) IN (0,8) THEN 'Under Process at Bank'  WHEN bd.ACT_ID = 3 THEN 'Returned' ELSE 'Sanctioned' END as CUR_STATUS,
  TRUNC(TO_DATE(bd.EDP_TO_DT))- TRUNC(TO_DATE(bd.EDP_FR_DT))+1 as NO_OF_DAYS,
FUNC_GETEDPDAYS(ad.app_id) edptobedays01

FROM
    app_detail                  ad,bank_dataentry bd,
    mas_off_mast                mom,
    m_state                     ms,
    zone_mast                   zm,
    m_district                  md,
    bnf_samadhanedp_appdetail   bsa
WHERE
ad.app_id=bd.app_id(+)
  and  ad.app_id = bsa.app_id
    AND ad.off_cd = mom.off_cd
    AND ms.zone_cd = zm.zone_cd
    AND md.district_cd = mom.district_cd
    AND ms.state_cd = md.state_cd
    AND last_day(trunc(bsa.inv_date)) = $P{PSINVNO}
    AND mom.off_type_cd IN (
        2,
        3,
        22,
        5,
        27
    )
and ms.state_cd=$P{PSTATECD}
AND MOM.MIS_OFF_CD2=$P{POFFCD}) a]]>
		</queryString>
		<field name="AGENCY_TYPE" class="java.lang.String"/>
		<field name="STATE" class="java.lang.String"/>
		<field name="OFF_NAME1" class="java.lang.String"/>
		<field name="DISTRICT_NAME" class="java.lang.String"/>
		<field name="APP_ID" class="java.lang.String"/>
		<field name="APP_NAME" class="java.lang.String"/>
		<field name="INVOICE_DT" class="java.lang.String"/>
		<field name="EDP_CERT_DT" class="java.lang.String"/>
		<field name="PRJ_COST" class="java.math.BigDecimal"/>
		<field name="LOAN_SANC_DT" class="java.lang.String"/>
		<field name="EDP_FR_DT" class="java.lang.String"/>
		<field name="EDP_TO_DT" class="java.lang.String"/>
		<field name="ADMPRJ_COST" class="java.math.BigDecimal"/>
		<field name="CUR_STATUS" class="java.lang.String"/>
		<field name="NO_OF_DAYS" class="java.math.BigDecimal"/>
		<field name="EDPTOBEDAYS01" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="PINVMONTH" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PSTATECD" class="java.lang.String"/>
	<parameter name="POFFCD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 1 from dual]]>
	</queryString>
