				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$V{SCSTTOT}==null?0:$V{SCSTTOT}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
