<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ACH" language="groovy" pageWidth="1080" pageHeight="842" columnWidth="1040" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f7476a6-0481-4737-8acf-9bf57d960a07">
	<property name="ireport.zoom" value="0.4665073802097365"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT *
FROM
  (SELECT BPV.OFF_CD,
    BPV.APR_NO,
    BPV.OFF_NAME, BOM.ZONE_NM
  FROM BNF_PHY_VERI BPV, BNF_OFF_MAST BOM
  WHERE BPV.OFF_CD=BOM.OFF_CD AND BPV.PHY_YR = $P{YEAR_ID}
  ) AW,
  (SELECT BOM.OFF_CD,
    BOM.OFF_NAME1,
    COUNT(BAD.APP_ID)                                              AS UNITS_VERIFIED,
    COUNT(DECODE(BAD.PHY_STATUS, 'W', NVL(BAD.APP_ID, 0)))         AS WORKING,
    COUNT(DECODE(BAD.PHY_STATUS, 'NW', NVL(BAD.APP_ID, 0)))        AS NOTWORKING,
    COUNT(DECODE(BAD.PHY_STATUS, 'NT', NVL(BAD.APP_ID, 0)))        AS NOTTRACEABLE,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'EX', NVL(BAD.APP_ID, 0)))  AS Ex_Servicemen,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'GEN', NVL(BAD.APP_ID, 0))) AS GENER,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'OBC', NVL(BAD.APP_ID, 0))) AS OBC,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'SC', NVL(BAD.APP_ID, 0)))  AS SC,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'ST', NVL(BAD.APP_ID, 0)))  AS ST,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'MN', NVL(BAD.APP_ID, 0)))  AS Minority,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'PH', NVL(BAD.APP_ID, 0)))  AS PH,
    COUNT(DECODE(BAD.BENF_CATEGORY_CD, 'HA', NVL(BAD.APP_ID, 0)))  AS HA,
    COUNT(BAD.APP_ID)                                              AS TOT,
    COUNT(DECODE(BAD.GENDER, 'Female', NVL(BAD.APP_ID, 0)))        AS WOMEN,
    COUNT(DECODE(BAD.MM_CALL_BACK, 'Y', NVL(BAD.APP_ID, 0)))       AS MM_CALL_BACK,
    SUM(BAD.CALL_BACK_AMT)                                         AS CALL_BACK_AMT,
    SUM(DECODE(BAD.PHY_STATUS, 'NW', NVL(BAD.MM_AMT, 0), 0))       AS NWMM,
    SUM(DECODE(BAD.PHY_STATUS, 'NT', NVL(BAD.MM_AMT, 0), 0))       AS NTMM
  FROM BNF_APP_DETAIL BAD,
    BNF_OFF_MAST BOM
  WHERE BOM.OFF_CD = BAD.OFF_CD
  AND BAD.PHY_YR   = $P{YEAR_ID}
  GROUP BY BOM.OFF_CD,
    BOM.OFF_NAME1

  ) mq
WHERE AW.OFF_CD = mq.OFF_CD(+)
AND AW.OFF_CD NOT IN (1,1570,9904,15,6030,9903,9905,6418,9999,41,9906,4,2,9901,304,8,7,9902)
 ORDER BY ZONE_NM]]>
	</queryString>
