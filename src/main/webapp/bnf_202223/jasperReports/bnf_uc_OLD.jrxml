	<parameter name="POFFICENAME" class="java.lang.String"/>
	<queryString>
		<![CDATA[select bu.UC_ID, bu.YEAR_ID,
 bu.OFF_CD,
 bu.HO_RECEIVED+bu.SODO_RECEIVED as HOSODO_RECEIVED ,
 bu.REFUND_TO_HO+bu.TRANSFER_TO_SODO as TOT_REF_TRANSF ,
 bu.UC_OPG_BAL,
 bu.INT_EARNED,
 bu.HO_RECEIVED,
 bu.SODO_RECEIVED,
 bu.TOT_AVL_FUND,
 bu.REFUND_TO_HO,
 bu.TRANSFER_TO_SODO,
 bu.REFUND_INT,
 bu.TOTAL_REFUND,
 bu.EXPENDITURE,
 bu.CLOSING_BAL
 from bnf_uc bu where $P!{wrclsuc}
AND bu.UC_ID=$P{PUC_ID} and bu.YEAR_ID=$P{PYEAR_ID}]]>
	</queryString>
