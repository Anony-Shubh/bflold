<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ACH" language="groovy" pageWidth="1080" pageHeight="842" columnWidth="1040" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f7476a6-0481-4737-8acf-9bf57d960a07">
	<property name="ireport.zoom" value="1.610510000000032"/>
	<property name="ireport.x" value="202"/>
	<property name="ireport.y" value="53"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,  ZONE_NM, OFF_NAME1, EDP1, P_V1, D_L_A_C1, S_L_W1, D_L_E1, S_L_E1, Z_L_E1,Z_L_E2, Z_L_R_M1, Q_B_R_M1,
  S_L_M_C_M1, DLMCN1, DLMCN2, S_T_W1, TA_DA1, P_P1, D_E_O1, CONT1,D_L_A_C2,P_P2,CONT2,  S_L_W2, D_L_E2, S_L_E2, Z_L_R_M2,

  PCCC,
PMM,
PIIE,
PFA,
BPV,
OFFEDP,
ONEDP,
BEONOFF,
TECHEXP,
MARKEXP,
RETDBANK,
EVOSTUDY,
PROFEXP,
ADVBODY,
CONCOFF,

  CASE WHEN OFF_CD=9999 THEN P_V2_HO ELSE P_V2 END AS P_V2,
  CASE WHEN OFF_CD=9999 THEN Q_B_R_M2_HO ELSE Q_B_R_M2 END AS Q_B_R_M2,
  CASE WHEN OFF_CD=9999 THEN S_L_M_C_M2_HO ELSE S_L_M_C_M2 END AS S_L_M_C_M2,
  CASE WHEN OFF_CD=9999 THEN S_T_W2_HO ELSE S_T_W2 END AS S_T_W2,
  CASE WHEN OFF_CD=9999 THEN TA_DA2_HO ELSE TA_DA2 END AS TA_DA2,
  CASE WHEN OFF_CD=9999 THEN D_E_O2_HO ELSE D_E_O2 END AS D_E_O2,
  CASE WHEN OFF_CD=9999 THEN CONT2_HO ELSE CONT2 END AS CONT2,
  CASE WHEN OFF_CD=9999 THEN EDP2_HO ELSE EDP2 END AS EDP2,
 tott,
  YEAR_ID
  FROM
  (SELECT OFF_CD,
    ZONE_NM,
    OFF_NAME1,
    EDP1,
    ROUND(EDP2 / 100000, 2) AS EDP2,
    P_V1,
    ROUND(P_V2 / 100000, 2) AS P_V2,
    D_L_A_C1,
    ROUND(D_L_A_C2 / 100000, 2) AS D_L_A_C2,
    S_L_W1,
    ROUND(S_L_W2 / 100000, 2) AS S_L_W2,
    D_L_E1,
    ROUND(D_L_E2 / 100000, 2) AS D_L_E2,
    S_L_E1,
    ROUND(S_L_E2 / 100000, 2) AS S_L_E2,
    Z_L_E1,
    ROUND(Z_L_E2 / 100000, 2) AS Z_L_E2,
    Z_L_R_M1,
    ROUND(Z_L_R_M2 / 100000, 2) AS Z_L_R_M2,
    Q_B_R_M1,
    ROUND(Q_B_R_M2 / 100000, 2) AS Q_B_R_M2,
    S_L_M_C_M1,
    ROUND(S_L_M_C_M2 / 100000, 2) AS S_L_M_C_M2,

    DLMCN1,
    ROUND(DLMCN2 / 100000, 2) AS DLMCN2,

    S_T_W1,
    ROUND(S_T_W2 / 100000, 2) AS S_T_W2,
    TA_DA1,
    ROUND(TA_DA2 / 100000, 2) AS TA_DA2,
    P_P1,
    ROUND(P_P2 / 100000, 2) AS P_P2,
    D_E_O1,
    ROUND(D_E_O2 / 100000, 2) AS D_E_O2,
    CONT1,
    ROUND(CONT2         / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS CONT2,
    ROUND(CONT2_HO      / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS CONT2_HO,
    ROUND(D_E_O2_HO     / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS D_E_O2_HO,
    ROUND(TA_DA2_HO     / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS TA_DA2_HO,
    ROUND(S_T_W2_HO     / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS S_T_W2_HO,
    ROUND(Q_B_R_M2_HO   / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS Q_B_R_M2_HO,
    ROUND(P_V2_HO       / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS P_V2_HO,
    ROUND(S_L_M_C_M2_HO / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS S_L_M_C_M2_HO,
    ROUND(CONT2_HO_2    / 100000, 2)                                                                                                                                                                                                                                                                                                                                                                                                                                           AS CONT2_HO_2,
    ROUND(EDP2_HO       / 100000, 2) AS EDP2_HO,

    ROUND(PCCC       / 100000, 2) AS PCCC,
    ROUND(PMM       / 100000, 2) AS PMM,
    ROUND(PIIE       / 100000, 2) AS PIIE,
    ROUND(PFA       / 100000, 2) AS PFA,
    ROUND(BPV       / 100000, 2) AS BPV,
    ROUND(OFFEDP       / 100000, 2) AS OFFEDP,
    ROUND(ONEDP       / 100000, 2) AS ONEDP,
    ROUND(BEONOFF       / 100000, 2) AS BEONOFF,
    ROUND(TECHEXP       / 100000, 2) AS TECHEXP,
    ROUND(MARKEXP       / 100000, 2) AS MARKEXP,
    ROUND(RETDBANK       / 100000, 2) AS RETDBANK,
    ROUND(EVOSTUDY       / 100000, 2) AS EVOSTUDY,
    ROUND(PROFEXP       / 100000, 2) AS PROFEXP,
    ROUND(ADVBODY       / 100000, 2) AS ADVBODY,
    ROUND(CONCOFF       / 100000, 2) AS CONCOFF,



    ROUND((NVL(EDP2, 0) + NVL(P_V2, 0) + NVL(D_L_A_C2, 0) + NVL(S_L_W2, 0) + NVL(D_L_E2, 0) + NVL(S_L_E2, 0) + NVL(Z_L_E2, 0)
    + NVL(Z_L_R_M2, 0) + NVL(Q_B_R_M2, 0) + NVL(S_L_M_C_M2, 0) + NVL(DLMCN2, 0) + NVL(S_T_W2, 0) + NVL(TA_DA2, 0) + NVL(P_P2, 0) + NVL(D_E_O2, 0)
    + NVL(CONT2, 0) + NVL(CONT2_HO, 0) + NVL(D_E_O2_HO, 0) + NVL(TA_DA2_HO, 0) + NVL(S_T_W2_HO, 0) + NVL(Q_B_R_M2_HO, 0)
    + NVL(P_V2_HO, 0) + NVL(S_L_M_C_M2_HO, 0) + NVL(CONT2_HO_2, 0) + NVL(EDP2_HO, 0)

    + NVL(PCCC, 0)
    + NVL(PMM, 0)
    + NVL(PIIE, 0)
    + NVL(PFA, 0)
    + NVL(BPV, 0)
    + NVL(OFFEDP, 0)
    + NVL(ONEDP, 0)
    + NVL(BEONOFF, 0)
    + NVL(TECHEXP, 0)
    + NVL(MARKEXP, 0)
    + NVL(RETDBANK, 0)
    + NVL(EVOSTUDY, 0)
    + NVL(PROFEXP, 0)
    + NVL(ADVBODY, 0)
    + NVL(CONCOFF, 0)
    ) / 100000, 2) AS tott,
    YEAR_ID
  FROM
    (SELECT BOM.OFF_CD,
      BOM.ZONE_NM,
      BOM.OFF_NAME1,
      SUM(DECODE(BFT.BUD_ID, '1', NVL(BFT.PH_KVIC, 0)    + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS EDP1,
      SUM(DECODE(BFT.BUD_ID, '1', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS EDP2,
      SUM(DECODE(BFT.BUD_ID, '2', NVL(BFT.PH_KVIC, 0)    + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS P_V1,
      SUM(DECODE(BFT.BUD_ID, '2', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS P_V2,
      COUNT(DECODE(BFT.BUD_ID, '3', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS D_L_A_C1,
      SUM(DECODE(BFT.BUD_ID, '3', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_L_A_C2,
      COUNT(DECODE(BFT.BUD_ID, '4', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_L_W1,
      SUM(DECODE(BFT.BUD_ID, '4', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_W2,
      COUNT(DECODE(BFT.BUD_ID, '5', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS D_L_E1,
      SUM(DECODE(BFT.BUD_ID, '5', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_L_E2,
      COUNT(DECODE(BFT.BUD_ID, '6', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_L_E1,
      SUM(DECODE(BFT.BUD_ID, '6', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_E2,
      COUNT(DECODE(BFT.BUD_ID, '7', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS Z_L_E1,
      SUM(DECODE(BFT.BUD_ID, '7', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Z_L_E2,
      COUNT(DECODE(BFT.BUD_ID, '8', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS Z_L_R_M1,
      SUM(DECODE(BFT.BUD_ID, '8', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Z_L_R_M2,
      COUNT(DECODE(BFT.BUD_ID, '9', NVL(BFT.PH_KVIC, 0)  + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS Q_B_R_M1,
      SUM(DECODE(BFT.BUD_ID, '9', NVL(BFT.FIN_KVIC, 0)   + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Q_B_R_M2,
      COUNT(DECODE(BFT.BUD_ID, '10', NVL(BFT.PH_KVIC, 0) + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_L_M_C_M1,
      SUM(DECODE(BFT.BUD_ID, '10', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_M_C_M2,

      COUNT(DECODE(BFT.BUD_ID, '45', NVL(BFT.PH_KVIC, 0) + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS DLMCN1,
      SUM(DECODE(BFT.BUD_ID, '45', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS DLMCN2,


      SUM(DECODE(BFT.BUD_ID, '11', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS S_T_W1,
      SUM(DECODE(BFT.BUD_ID, '11', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_T_W2,
      SUM(DECODE(BFT.BUD_ID, '12', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS TA_DA1,
      SUM(DECODE(BFT.BUD_ID, '12', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS TA_DA2,
      SUM(DECODE(BFT.BUD_ID, '13', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS P_P1,
      SUM(DECODE(BFT.BUD_ID, '13', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS P_P2,
      SUM(DECODE(BFT.BUD_ID, '14', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS D_E_O1,
      SUM(DECODE(BFT.BUD_ID, '14', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_E_O2,
      SUM(DECODE(BFT.BUD_ID, '15', NVL(BFT.PH_KVIC, 0)   + NVL(BFT.PH_KVIB, 0) + NVL(BFT.PH_DIC, 0)))   AS CONT1,
      SUM(DECODE(BFT.BUD_ID, '15', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS CONT2,
      SUM(DECODE(BFT.BUD_ID, '16', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS CONT2_HO,
      SUM(DECODE(BFT.BUD_ID, '17', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS D_E_O2_HO,
      SUM(DECODE(BFT.BUD_ID, '18', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS TA_DA2_HO,
      SUM(DECODE(BFT.BUD_ID, '19', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_T_W2_HO,
      SUM(DECODE(BFT.BUD_ID, '20', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS Q_B_R_M2_HO,
      SUM(DECODE(BFT.BUD_ID, '21', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS P_V2_HO,
      SUM(DECODE(BFT.BUD_ID, '22', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS S_L_M_C_M2_HO,
      SUM(DECODE(BFT.BUD_ID, '26', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS CONT2_HO_2,
      SUM(DECODE(BFT.BUD_ID, '27', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS EDP2_HO,

      SUM(DECODE(BFT.BUD_ID, '28', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS PCCC,
      SUM(DECODE(BFT.BUD_ID, '29', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS PMM,
      SUM(DECODE(BFT.BUD_ID, '30', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS PIIE,
      SUM(DECODE(BFT.BUD_ID, '31', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS PFA,
      SUM(DECODE(BFT.BUD_ID, '32', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS BPV,
      SUM(DECODE(BFT.BUD_ID, '33', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS OFFEDP,
      SUM(DECODE(BFT.BUD_ID, '34', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS ONEDP,
      SUM(DECODE(BFT.BUD_ID, '35', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS BEONOFF,
      SUM(DECODE(BFT.BUD_ID, '36', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS TECHEXP,
      SUM(DECODE(BFT.BUD_ID, '37', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS MARKEXP,
      SUM(DECODE(BFT.BUD_ID, '38', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS RETDBANK,
      SUM(DECODE(BFT.BUD_ID, '39', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS EVOSTUDY,
      SUM(DECODE(BFT.BUD_ID, '40', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS PROFEXP,
      SUM(DECODE(BFT.BUD_ID, '41', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS ADVBODY,
      SUM(DECODE(BFT.BUD_ID, '42', NVL(BFT.FIN_KVIC, 0)  + NVL(BFT.FIN_DIC, 0) + NVL(BFT.FIN_KVIB, 0))) AS CONCOFF,




      BFT.YEAR_ID
    FROM BNF_FO_TRANS BFT,
      BNF_OFF_MAST BOM
    WHERE BOM.OFF_CD = BFT.OFF_CD(+)
    GROUP BY BOM.OFF_CD,
      BOM.ZONE_NM,
      BOM.OFF_NAME1,
      BFT.YEAR_ID
    )   WHERE  $P!{wrcls} AND  YEAR_ID = $P{YEAR_ID}
  ORDER BY ZONE_NM
  )]]>
	</queryString>
	<field name="OFF_CD" class="java.math.BigDecimal"/>
	<field name="ZONE_NM" class="java.lang.String"/>
	<field name="OFF_NAME1" class="java.lang.String"/>
	<field name="EDP1" class="java.math.BigDecimal"/>
	<field name="P_V1" class="java.math.BigDecimal"/>
	<field name="D_L_A_C1" class="java.math.BigDecimal"/>
	<field name="S_L_W1" class="java.math.BigDecimal"/>
	<field name="D_L_E1" class="java.math.BigDecimal"/>
	<field name="S_L_E1" class="java.math.BigDecimal"/>
	<field name="Z_L_E1" class="java.math.BigDecimal"/>
	<field name="Z_L_E2" class="java.math.BigDecimal"/>
	<field name="Z_L_R_M1" class="java.math.BigDecimal"/>
	<field name="Q_B_R_M1" class="java.math.BigDecimal"/>
	<field name="S_L_M_C_M1" class="java.math.BigDecimal"/>
	<field name="DLMCN1" class="java.math.BigDecimal"/>
	<field name="DLMCN2" class="java.math.BigDecimal"/>
	<field name="S_T_W1" class="java.math.BigDecimal"/>
	<field name="TA_DA1" class="java.math.BigDecimal"/>
	<field name="P_P1" class="java.math.BigDecimal"/>
	<field name="D_E_O1" class="java.math.BigDecimal"/>
	<field name="CONT1" class="java.math.BigDecimal"/>
	<field name="D_L_A_C2" class="java.math.BigDecimal"/>
	<field name="P_P2" class="java.math.BigDecimal"/>
	<field name="CONT2" class="java.math.BigDecimal"/>
	<field name="S_L_W2" class="java.math.BigDecimal"/>
	<field name="D_L_E2" class="java.math.BigDecimal"/>
	<field name="S_L_E2" class="java.math.BigDecimal"/>
	<field name="Z_L_R_M2" class="java.math.BigDecimal"/>
	<field name="PCCC" class="java.math.BigDecimal"/>
	<field name="PMM" class="java.math.BigDecimal"/>
	<field name="PIIE" class="java.math.BigDecimal"/>
	<field name="PFA" class="java.math.BigDecimal"/>
	<field name="BPV" class="java.math.BigDecimal"/>
	<field name="OFFEDP" class="java.math.BigDecimal"/>
	<field name="ONEDP" class="java.math.BigDecimal"/>
	<field name="BEONOFF" class="java.math.BigDecimal"/>
	<field name="TECHEXP" class="java.math.BigDecimal"/>
	<field name="MARKEXP" class="java.math.BigDecimal"/>
	<field name="RETDBANK" class="java.math.BigDecimal"/>
	<field name="EVOSTUDY" class="java.math.BigDecimal"/>
	<field name="PROFEXP" class="java.math.BigDecimal"/>
	<field name="ADVBODY" class="java.math.BigDecimal"/>
	<field name="CONCOFF" class="java.math.BigDecimal"/>
	<field name="P_V2" class="java.math.BigDecimal"/>
	<field name="Q_B_R_M2" class="java.math.BigDecimal"/>
	<field name="S_L_M_C_M2" class="java.math.BigDecimal"/>
	<field name="S_T_W2" class="java.math.BigDecimal"/>
	<field name="TA_DA2" class="java.math.BigDecimal"/>
	<field name="D_E_O2" class="java.math.BigDecimal"/>
	<field name="EDP2" class="java.math.BigDecimal"/>
	<field name="TOTT" class="java.math.BigDecimal"/>
	<field name="YEAR_ID" class="java.lang.String"/>
	<variable name="EDP1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="zone_nm" calculation="Sum">
		<variableExpression><![CDATA[$F{EDP1}]]></variableExpression>
	</variable>
	<variable name="EDP2_1" class="java.math.BigDecimal" resetType="Group" resetGroup="zone_nm" calculation="Sum">
		<variableExpression><![CDATA[$F{EDP2}]]></variableExpression>
	</variable>
	<variable name="D_L_A_C1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="zone_nm" calculation="Sum">
