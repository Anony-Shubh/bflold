<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PMEGP_PERF_BANK_REPORT" language="groovy" pageWidth="595" pageHeight="842" columnWidth="553" leftMargin="42" rightMargin="0" topMargin="7" bottomMargin="0" uuid="0c0950c7-05ef-4026-9f34-321b0610cc88">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" forecolor="#FFFFFF" fontName="Arial" fontSize="26" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="SubTitle" forecolor="#666666" fontName="Arial" fontSize="18"/>
	<style name="Column header" forecolor="#666666" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="Detail" fontName="Arial" fontSize="12"/>
	<parameter name="PBANK_NM" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PFROMDT" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PTODT" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PCIRCLE_IFSL_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT INITCAP(HIRONE) AS ZONE_NM,INITCAP(HIRTWO) AS OFF_NAME1, sum( nvl(case when ad.act_id=5 then 1 end,0)) as bank_ford , sum( nvl(case when ad.act_id=5 then round(mminvolve(ad.app_id)/100000,2) end ,0)) as bankfordmminv, sum( nvl(case when bd.act_id>=11 then 1 end ,0)) as bank_sanc, sum( nvl(case when bd.act_id>=11 then round(mminvolvebank(bd.app_id)/100000,2) end ,0)) as bank_sanc_mm, sum( nvl(case when bd.act_id>=23 then 1 end ,0)) as mm_claim , sum( nvl(case when bd.act_id>=23 then nvl(round(bd.mm_claim_amt/100000,2),0) end ,0)) as mm_claim_amt , sum( nvl(case when bd.act_id>=24 then 1 end ,0)) as mm_rel , sum( nvl(case when bd.act_id>=24 then nvl(round(bd.mm_rel_amt/100000,2),0) end ,0)) as mm_rel_amt , sum( nvl(case when bd.act_id=3 then 1 end ,0)) as bank_rej, sum( nvl(case when bd.act_id=3 then round(mminvolve(bd.app_id)/100000,2) end ,0)) as b_rej_mm, sum( nvl(case when bd.act_id IS NULL OR bd.act_id=8 then 1 end ,0)) as pend_sanc_no, sum( nvl(case when bd.act_id IS NULL OR bd.act_id=8 then round(mminvolve(ad.app_id)/100000,2) end ,0)) as pend_san_mm, sum( nvl(case when bd.act_id=23 then 1 end ,0)) as pend_rel, sum( nvl(case when bd.act_id=23 then nvl(round(bd.mm_claim_amt/100000,2),0) end ,0)) as pend_mm FROM app_detail ad, bank_dataentry bd,bank_br_mast bbm where ad.app_id=bd.app_id (+) and ad.IFSC_CODE=bbm.br_ifsl_code and ad.bank_f_date between $P{PFROMDT} and $P{PTODT} AND AD.ACT_ID=5 AND bbm.CIRCLE_IFSC=$P{PCIRCLE_IFSL_CODE}
 group by ROLLUP(HIRONE,HIRTWO)]]>
	</queryString>
	<field name="ZONE_NM" class="java.lang.String"/>
	<field name="OFF_NAME1" class="java.lang.String"/>
	<field name="BANK_FORD" class="java.math.BigDecimal"/>
	<field name="BANKFORDMMINV" class="java.math.BigDecimal"/>
	<field name="BANK_SANC" class="java.math.BigDecimal"/>
	<field name="BANK_SANC_MM" class="java.math.BigDecimal"/>
	<field name="MM_CLAIM" class="java.math.BigDecimal"/>
	<field name="MM_CLAIM_AMT" class="java.math.BigDecimal"/>
	<field name="MM_REL" class="java.math.BigDecimal"/>
	<field name="MM_REL_AMT" class="java.math.BigDecimal"/>
	<field name="BANK_REJ" class="java.math.BigDecimal"/>
	<field name="B_REJ_MM" class="java.math.BigDecimal"/>
	<field name="PEND_SANC_NO" class="java.math.BigDecimal"/>
	<field name="PEND_SAN_MM" class="java.math.BigDecimal"/>
	<field name="PEND_REL" class="java.math.BigDecimal"/>
	<field name="PEND_MM" class="java.math.BigDecimal"/>
	<variable name="sr_no" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{OFF_NAME1}]]></variableExpression>
	</variable>
	<variable name="vtitle" class="java.lang.String">
		<variableExpression><![CDATA[]]></variableExpression>
		<initialValueExpression><![CDATA["PMEGP e-Tracking conolidated Bank Performance Report of "+$P{PBANK_NM}+" for the period from "+new SimpleDateFormat("dd-MMM-yyyy").format($P{PFROMDT})+" To " +new SimpleDateFormat("dd-MMM-yyyy").format($P{PTODT})]]></initialValueExpression>
	</variable>
