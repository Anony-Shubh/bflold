	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="ASSET" uuid="89bb1886-d8eb-4596-9789-1884c3ca7b1a">
		<parameter name="PVCUSTCODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="PVFROMDT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="PVTODT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="PVSESSIONID" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{PVSESSIONID}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT * FROM (SELECT AGM.ACGRP_NATURE,
  DRT.LEDGERID,
  DRT.ACGRP_ID,
CASE  WHEN AGM.ACGRP_ID=22   THEN DRT.DR_AMT_CL
  WHEN AGM.ACGRP_ID IN(52,53)
THEN (DRT.DR_AMT_CL-DRT.CR_AMT_CL)*-1

ELSE DRT.DR_AMT_CL-DRT.CR_AMT_CL

 END AS DR_AMT_CL,
 -- DRT.DR_AMT_CL-DRT.CR_AMT_CL AS DR_AMT_CL ,
  --DRT.CR_AMT_CL,
  AGM.ACGRP_DESC,
  ALM.LEDG_DESC,
 (SELECT TOT_LIABILITY FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{PVCUSTCODE},$P{PVFROMDT},$P{PVTODT},$P{PVSESSIONID}))) AS TOT_LIABILITY,
   (SELECT TOT_ASSETS FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{PVCUSTCODE},$P{PVFROMDT},$P{PVTODT},$P{PVSESSIONID}))) AS TOT_ASSETS,
 (SELECT PNL_GROSS FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{PVCUSTCODE},$P{PVFROMDT},$P{PVTODT},$P{PVSESSIONID}))) AS PNL_GROSS,
(SELECT PNL_FLAG FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{PVCUSTCODE},$P{PVFROMDT},$P{PVTODT},$P{PVSESSIONID}))) AS PNL_FLAG
FROM
  (SELECT *
  FROM TABLE(FUNCT_LEDGER_ALL_TRAIL($P{PVCUSTCODE},$P{PVFROMDT},$P{PVTODT}))
  ) DRT,
  ACC_GROUP_MAST AGM,
  ACC_LEDG_MAST ALM
WHERE DRT.LEDGERID    = ALM.LEDGID
AND ALM.ACGRP_ID      = AGM.ACGRP_ID
AND (AGM.ACGRP_NATURE IN ('ASSETS','STOCK_IN_HAND') OR AGM.ACGRP_DESC IN ('NON TB DIRECT INCOME','NON TB INDIRECT INCOME'))
--AND AGM.ACGRP_NATURE IN ('ASSETS') AND AGM.ACGRP_DESC NOT LIKE'STOCK_IN_HAND'
)WHERE  NVL(DR_AMT_CL,0)<>0 ORDER BY  ACGRP_DESC ASC]]>
		</queryString>
		<field name="ACGRP_NATURE" class="java.lang.String"/>
		<field name="LEDGERID" class="java.math.BigDecimal"/>
		<field name="ACGRP_ID" class="java.math.BigDecimal"/>
		<field name="DR_AMT_CL" class="java.math.BigDecimal"/>
		<field name="ACGRP_DESC" class="java.lang.String"/>
		<field name="LEDG_DESC" class="java.lang.String"/>
		<field name="TOT_LIABILITY" class="java.math.BigDecimal"/>
		<field name="TOT_ASSETS" class="java.math.BigDecimal"/>
		<field name="PNL_GROSS" class="java.math.BigDecimal"/>
		<field name="PNL_FLAG" class="java.lang.String"/>
		<variable name="TOT_ASSETS" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{DR_AMT_CL}]]></variableExpression>
		</variable>
		<variable name="ASSET_TOT_DR" class="java.math.BigDecimal" resetType="Group" resetGroup="ACGRP_DESC" calculation="Sum">
			<variableExpression><![CDATA[$F{DR_AMT_CL}]]></variableExpression>
		</variable>
		<group name="ACGRP_DESC">
			<groupExpression><![CDATA[$F{ACGRP_DESC}]]></groupExpression>
		</group>
		<group name="LEDG_DESC">
			<groupExpression><![CDATA[$F{LEDG_DESC}]]></groupExpression>
		</group>
		<group name="DR_AMT_CL">
			<groupExpression><![CDATA[$F{DR_AMT_CL}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="LIABILITY" uuid="ac846fad-bbe6-4290-9281-34dcf74b4c27">
		<parameter name="LPCUSTCODE" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="LPFROMDT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="LPTODT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="PVSESSIONID" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{PVSESSIONID}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT * FROM (SELECT AGM.ACGRP_NATURE,
  DRT.LEDGERID,
  DRT.ACGRP_ID,
CASE WHEN AGM.ACGRP_NATURE IN ('LIABILITIES') THEN
   DRT.CR_AMT_CL-DRT.DR_AMT_CL
  ELSE
  (DRT.CR_AMT_CL-DRT.DR_AMT_CL)*-1
  END CR_AMT_CL,
  --DRT.DR_AMT_CL-DRT.CR_AMT_CL AS DR_AMT_CL ,
  --DRT.CR_AMT_CL-DRT.DR_AMT_CL AS CR_AMT_CL,
  AGM.ACGRP_DESC,
  ALM.LEDG_DESC,
 (SELECT TOT_LIABILITY FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{LPCUSTCODE},$P{LPFROMDT},$P{LPTODT},$P{PVSESSIONID}))) AS TOT_LIABILITY,
   (SELECT TOT_ASSETS FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{LPCUSTCODE},$P{LPFROMDT},$P{LPTODT},$P{PVSESSIONID}))) AS TOT_ASSETS,
 (SELECT PNL_GROSS FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{LPCUSTCODE},$P{LPFROMDT},$P{LPTODT},$P{PVSESSIONID}))) AS PNL_GROSS,
(SELECT PNL_FLAG FROM TABLE(FUNCT_TRADINGACC_PNL_CALC($P{LPCUSTCODE},$P{LPFROMDT},$P{LPTODT},$P{PVSESSIONID}))) AS PNL_FLAG
FROM
  (SELECT *
  FROM TABLE(FUNCT_LEDGER_ALL_TRAIL($P{LPCUSTCODE},$P{LPFROMDT},$P{LPTODT}))
  ) DRT,
  ACC_GROUP_MAST AGM,
  ACC_LEDG_MAST ALM
WHERE DRT.LEDGERID    = ALM.LEDGID
AND ALM.ACGRP_ID      = AGM.ACGRP_ID
AND( AGM.ACGRP_NATURE IN ('LIABILITIES')OR AGM.ACGRP_DESC IN ('NON TB DIRECT EXPENDITURE','NON TB INDIRECT EXPENDITURE')) AND AGM.ACGRP_DESC NOT LIKE'STOCK_IN_HAND'
--AND AGM.ACGRP_NATURE IN ('LIABILITIES') AND AGM.ACGRP_DESC NOT LIKE'STOCK_IN_HAND'
)WHERE  NVL(CR_AMT_CL,0)<>0 ORDER BY  ACGRP_DESC ASC]]>
		</queryString>
		<field name="ACGRP_NATURE" class="java.lang.String"/>
		<field name="LEDGERID" class="java.math.BigDecimal"/>
		<field name="ACGRP_ID" class="java.math.BigDecimal"/>
		<field name="CR_AMT_CL" class="java.math.BigDecimal"/>
		<field name="ACGRP_DESC" class="java.lang.String"/>
		<field name="LEDG_DESC" class="java.lang.String"/>
		<field name="TOT_LIABILITY" class="java.math.BigDecimal"/>
		<field name="TOT_ASSETS" class="java.math.BigDecimal"/>
		<field name="PNL_GROSS" class="java.math.BigDecimal"/>
		<field name="PNL_FLAG" class="java.lang.String"/>
		<variable name="LIABILITY_TOT_CR" class="java.math.BigDecimal" resetType="Group" resetGroup="ACGRP_DESC" calculation="Sum">
			<variableExpression><![CDATA[$F{CR_AMT_CL}]]></variableExpression>
		</variable>
		<variable name="LIABILITY_TOT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CR_AMT_CL}]]></variableExpression>
		</variable>
		<group name="ACGRP_NATURE">
			<groupExpression><![CDATA[$F{ACGRP_NATURE}]]></groupExpression>
		</group>
		<group name="ACGRP_DESC">
			<groupExpression><![CDATA[$F{ACGRP_DESC}]]></groupExpression>
		</group>
		<group name="LEDG_DESC">
			<groupExpression><![CDATA[$F{LEDG_DESC}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="PCUSTCODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PFROMDT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PTODT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PSESSIONID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[(SELECT AGM.ACGRP_NATURE,
  DRT.LEDGERID,
  DRT.ACGRP_ID,
(SELECT  KI.KINAME FROM  KIMAST KI ,CUSTMAST CM WHERE  KI.KIID=CM.BASEID AND CM.CUSTCODE=$P{PCUSTCODE}) AS KINAME ,
   (SELECT  CM.NAME FROM  KIMAST KI ,CUSTMAST CM WHERE  KI.KIID=CM.BASEID AND CM.CUSTCODE=$P{PCUSTCODE}) AS NAME,
    (SELECT  CM.ADDR1
  || ','
  || 'Pincode:'
  || CM.PINCODE
  || ','
  || CM.CITY
  || ',State:'
  ||
  MAX((SELECT statemaster.STATENAME
  FROM statemaster
  WHERE statemaster.STATEID = CM.STATE
  )) AS BR_ADDRESS FROM  KIMAST KI ,CUSTMAST CM WHERE  KI.KIID=CM.BASEID AND CM.CUSTCODE=$P{PCUSTCODE}
  GROUP BY    CM.ADDR1, CM.PINCODE, CM.CITY,   CM.PHONE_STD, CM.PHONE_NO1,CM.BASEID ) AS ADDR,
  DRT.DR_AMT_CL-DRT.CR_AMT_CL AS DR_AMT_CL ,
  --DRT.CR_AMT_CL,
  AGM.ACGRP_DESC,
  ALM.LEDG_DESC
FROM
  (SELECT *
  FROM TABLE(FUNCT_LEDGER_ALL_TRAIL($P{PCUSTCODE}, $P{PFROMDT},$P{PTODT} ))
  ) DRT,
  ACC_GROUP_MAST AGM,
  ACC_LEDG_MAST ALM
WHERE DRT.LEDGERID    = ALM.LEDGID
AND ALM.ACGRP_ID      = AGM.ACGRP_ID
AND AGM.ACGRP_NATURE IN ('ASSETS') AND AGM.ACGRP_DESC NOT LIKE'STOCK_IN_HAND'
--GROUP BY
)order by AGM.ACGRP_DESC]]>
	</queryString>
	<field name="ACGRP_NATURE" class="java.lang.String"/>
	<field name="LEDGERID" class="java.math.BigDecimal"/>
	<field name="ACGRP_ID" class="java.math.BigDecimal"/>
	<field name="KINAME" class="java.lang.String"/>
	<field name="NAME" class="java.lang.String"/>
	<field name="ADDR" class="java.lang.String"/>
	<field name="DR_AMT_CL" class="java.math.BigDecimal"/>
	<field name="ACGRP_DESC" class="java.lang.String"/>
	<field name="LEDG_DESC" class="java.lang.String"/>
