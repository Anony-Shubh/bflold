<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="4trail_balance" language="groovy" pageWidth="648" pageHeight="842" columnWidth="608" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="eb120302-4265-42ba-bbf4-16719df62bdf">
	<property name="ireport.zoom" value="1.7715610000000013"/>
	<property name="ireport.x" value="414"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PCUSTCODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PFROMDT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PTODT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select *  from (SELECT
KI.KINAME,
  CM.NAME,
  CM.ADDR1
  || ','
  || 'Pincode:'
  || CM.PINCODE
  || ','
  || CM.CITY
  || ',State:'
  ||
  (SELECT statemaster.STATENAME
  FROM statemaster
  WHERE statemaster.STATEID = CM.STATE
  ) AS BR_ADDRESS,
  'Phone no.'
  || CM.PHONE_STD
  || '-'
  || CM.PHONE_NO1 AS PHONE_NO,
 ALM.LEDGID,
 AGM.ACGRP_NATURE,
 AGM.ACGRP_DESC,
(SELECT   CASE WHEN (SUM(DR_AMT_CL)-SUM(CR_AMT_CL)) <0 THEN 'NEG' ELSE 'POS' END  FROM
TABLE (FUNCT_LEDGER_ALL_TRAIL($P{PCUSTCODE},$P{PFROMDT},$P{PTODT}))) as val,
  UPPER(ALM.LEDG_DESC) AS LEDG_DESC,A.DR_AMT_OPG,A.CR_AMT_OPG,A.DR_AMT_TRANS,A.CR_AMT_TRANS,A.DR_AMT_CL,A.CR_AMT_CL
  FROM  TABLE (FUNCT_LEDGER_ALL_TRAIL($P{PCUSTCODE},$P{PFROMDT},$P{PTODT}))A,ACC_LEDG_MAST ALM,
ACC_GROUP_MAST AGM ,CUSTMAST CM,KIMAST KI
 WHERE
 A.LEDGERID=ALM.LEDGID
 AND ALM.ACGRP_ID = AGM.ACGRP_ID
 AND CM.BASEID    = KI.KIID
 AND CM.CUSTCODE=$P{PCUSTCODE}
 AND AGM.ACGRP_ID NOT IN (51,52,53,54))
order by acgrp_nature]]>
	</queryString>
