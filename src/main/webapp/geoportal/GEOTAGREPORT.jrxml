	<parameter name="PAPPID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
'PMEGP IST LOAN' AS LOAN_TYPE,
AD.APP_NAME,
  AD.GENDER,
  AD.BENF_CATAGORY_CD,
  AD.BENF_SPECAT_CD,
  AD.E_MAIL,
  AD.MOB_NO1,
  AD.UNIT_LOC,
  MD.DISTRICT_NAME AS UNIT_DISTRICT,
  MOM.OFF_NAME,
  MOM.AGENCY_TYPE,
  AD.UNIT_POST_ADDR,
  AD.UNIT_TALUK_BLOCK,
  AD.UNIT_PIN,
  MD.DISTRICT_NAME,
  MS.STATE_NM,
  AD.IND_TYPE,
  IGM.IND_GRP_LONG_DESC,
  AM.ACTIVITY_NAME,
  AD.PROD_DESC,
  BD.EDP_TRG_NAME,
  TO_CHAR(BD.EDP_FR_DT,'DD-MON-RRRR') AS EDP_FR_DT,
  TO_CHAR(BD.EDP_TO_DT,'DD-MON-RRRR') AS EDP_TO_DT,
  BD.LOAN_SANC_DT,
  BD.WC_SANC_FB,
  BD.CE_SANC_FB,
  BD.MACHINARY_COST,
  BD.WORKING_CAPITAL,
  BD.OWN_CONTRIBUTION,
  RBL.BANK_NAME,
  RBL.BRANCHNAME,
  RBL.ADDRESS,
  RBL.IFSC_CODE,
  BD.MM_REL_DT,
  BD.MM_REL_AMT,
  BD.UTRN_NO,
  BD.PAY_STATUS,
  BD.IST_LOAN_AMT,
  BD.IST_LOAN_DT,
  GT.PMEGPGEOTAGID,
  GT.LATITUDE,
  GT.UNIT_ADDRESS,
  GT.LONGITUDE,
  GT.MARGIN_MONEY_ADJUSTMENT_AMOUNT,
  GT.PERIOD_OF_INTEREST,
  GT.RATE_OF_INTEREST,
  GT.REPAYMENT_PERIOD,
  GT.CGTMSE_COVERAGE,
  GT.CALLBACK_REASON,
  GT.VALUE_OF_COLLATERAL_SECURITY,
  GT.TDR_NUMBER,
  GT.IS_MARGIN_MONEY_CALLBACK_,
  GT.IS_MARGIN_MONEY_ELIGIBLE_FOR_A,
  GT.OUTSTANDING_LOAN_AMOUNT,
  GT.PENDING_LOAN_AMOUNT,
  GT.MARGIN_MONEY_ADJUSTMENT_DATE,
  GT.NATURE_OF_COLLATERAL_SECURITY,
  GT.TDR_DATE,
  GT.ROI_LOAN,
  GT.CALLBACK_AMOUNT,
  GT.TDR_AMOUNT,
  GT.DATE_OF_ISSUE,
  GT.IS_INTEREST_CHARGED,
  GT.NPA_PERIOD,
  GT.IS_REPAYMENT_REGULAR,
  GT.IS_COLLATERAL_SECURITY,
  GT.INTEREST_AMOUNT,
  GT.MAIN_PRODUCT,
  GT.PRESENT_SALES_QUANTITY,
  GT.EXPORT_VALUE,
  GT.RAW_MATERIAL_IMPORT_COUNTRY,
  GT.PRESENT_SALES_VALUE,
  GT.ANNUAL_PRODUCTION_QUANTITY,
  GT.PRESENT_PRODUCTION_VALUE,
  GT.MACHINERY_TYPE,
  GT.MODE_OF_EXPORT,
  GT.ANNUAL_PRODUCTION_VALUE,
  GT.COUNTRY_OF_EXPORT,
  GT.EXPORT_QUANTITY,
  GT.BY_PRODUCT,
  GT.RAW_MATERIAL_DETAILS,
  GT.PRESENT_PRODUCTION_QUANTITY,
  GT.PRODUCTION_SALES_YEAR,
  GT.RAW_MATERIAL_IMPORT,
  GT.ANNUAL_SALES_VALUE,
  GT.COUNTRY_OF_IMPORT,
  GT.ANNUAL_SALES_QUANTITY,
  GT.DATE_OF_VERIFICATION,
  GT.PROMINENT_SIGN_BOARD_INSTALLED,
  GT.VERIFICATION_STATUS,
  GT.VERIFICATION_BY,
  GT.VERIFIER_REMARKS,
  GT.PER_CAPITA_INVESTMENT_NORM_SAT,
  GT.APP_ID,
  GT.TOTAL_EMPLOYEES,
  GT.KVIC_REGISTRATION_NUMBER,
  GT.OTHER_CLEARANCE,
  GT.TRANSGENDER_EMPLOYEES,
  GT.SC,
  GT.OBC,
  GT.UNIT_ESTABLISHMENT_DATE,
  GT.DATE_OF_WATER_CONNECTION,
  GT.MALE_EMPLOYEES,
  GT.FULLTIME_EMPLOYEES,
  GT.PHYSICALLY_CHALLENGED_EMPLOYEE,
  GT.KVIC_REGISTRATION_DATE,
  GT.MINORITY,
  GT.GST_REGISTRATION_NUMBER,
  GT.PART_TIME_EMPLOYEES,
  GT.REGISTERED_BRAND_NAME,
  GT.UDYAM_REGISTRATION_NUMBER,
  GT.UNIT_SETUP_ON,
  GT.ST,
  GT.UNIT_NAME,
  GT.DATE_OF_ELECTRIC_CONNECTION,
  GT.HANDHOLDING_DETAILS,
  GT.UDYAM_REGISTRATION_DATE,
  GT.PRODUCTION_COMMENCEMENT_DATE,
  GT.PATENT_OWNERSHIP,
  GT.PAN_OR_TAN_NUMBER,
  GT.CERTIFICATION,
  GT.POLLUTION_CLEARANCE_BOARD,
  GT.SEASONAL_EMPLOYEES,
  GT.SEMI_SKILLED_EMPLOYEES,
  GT.SKILLED_EMPLOYEES,
  GT.GST_REGISTRATION_DATE,
  GT.UNSKILLED_EMPLOYEES,
  GT.GENERAL,
  GT.AVERAGE_WAGES_PAID,
  GT.FEMALE_EMPLOYEES,
  GT.CAPITAL_COST_OF_BUILDING,
  GT.CAPITAL_COST_OF_MACHINERY,
  GT.FINISHED_RAW_MATERIAL_STOCK,
  GT.SEMI_FIN_RM_STOCK,
  GT.RAW_MATERIAL_STOCK_VALUE,
  GT.VERIFICATION_DATETIME,
  GT.LAST_UPDATE_DT,
NVL( BD.MACHINARY_COST,0)+ NVL(BD.WORKING_CAPITAL,0) AS BANK_APPRV_PRJCOST,
 NVL( BD.WC_SANC_FB,0)+ NVL(BD.CE_SANC_FB,0) AS BANK_SANC_PRJCOST,
AD.UNIT_PIN
FROM APP_DETAIL AD,
  BANK_DATAENTRY BD,
  MAS_OFF_MAST MOM,
  M_DISTRICT MD,
  M_STATE MS,
  ACTIVITY_MAST AM,
  GEOTAG_TRANS GT,
  RBIBANKLIST RBL,
  IND_GRP_MAST IGM
WHERE AD.APP_ID     = BD.APP_ID
AND AD.OFF_CD       = MOM.OFF_CD
AND AD.UNIT_DIST_CD = MD.DISTRICT_CD
AND MS.STATE_CD     = MD.STATE_CD
AND AM.ACTIVITY_CD  = AD.ACTIVITY_CD
AND AD.IFSC_CODE    = RBL.IFSC_CODE
AND AD.APP_ID       = GT.APP_ID
AND AM.IND_GRP_CD   = IGM.IND_GRP_CD
AND BD.PACT_ID      = 34
AND GT.PMEGPGEOTAGID=$P{PAPPID}]]>
	</queryString>
