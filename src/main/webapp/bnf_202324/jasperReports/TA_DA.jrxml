<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TA_DA" language="groovy" pageWidth="1296" pageHeight="595" orientation="Landscape" columnWidth="1256" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7426a13f-b017-4a02-a137-80587d4de19d">
	<property name="ireport.zoom" value="0.8264462809917359"/>
	<property name="ireport.x" value="225"/>
	<property name="ireport.y" value="0"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PBUDID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,
  BUD_ID,
  ZONE_NM,
  BNF_EVENT,
  SUM(PHY_NO_KVIC  + PHY_NO_KVIB + PHY_NO_DIC)   AS NO_OF_PRJ,
  SUM(FIN_AMT_KVIC + FIN_AMT_KVIB + FIN_AMT_DIC) AS MM_AMT,
  BNF_ASTFFNME
  || ','
  || BNF_ASTFFDSGNTN AS STAFF_DETAILS,
  BNF_APLACE,
  BNF_APROGDTLS,
  BNF_ATOURDYS,
  CASE
    WHEN BNF_AGENCY = 'KV'
    THEN 'KVIC'
    WHEN BNF_AGENCY = 'KB'
    THEN 'KVIB'
    WHEN BNF_AGENCY = 'DI'
    THEN 'DIC'
  END AS AGENCY_TYPE,
  ORGANIZER,
  SUM(NVL(BNF_ATA, 0)) AS TA,
  SUM(NVL(BNF_ADA, 0)) AS DA,
  NVL(SUM(
  CASE
    WHEN BNF_AGENCY = 'KV'
    THEN FIN_KVIC
    WHEN BNF_AGENCY = 'KB'
    THEN FIN_KVIB
    WHEN BNF_AGENCY = 'DI'
    THEN FIN_DIC
  END), 0) AS TOT_EXP,
  REMARK_ADD,
  STATE_NM,
  BNF_SUB_HEAD_SH_DESC,
  YEAR_ID,
  YEAR_ID1
FROM
  (SELECT BOM.OFF_CD,
    BOM.ZONE_NM,
    NVL(BBM.PHY_NO_KVIC, 0) AS PHY_NO_KVIC,
    NVL(BBM.FIN_AMT_KVIC, 0) FIN_AMT_KVIC,
    NVL(BBM.FIN_AMT_KVIB, 0) FIN_AMT_KVIB,
    NVL(BBM.FIN_AMT_DIC, 0) FIN_AMT_DIC,
    NVL(BBM.PHY_NO_KVIB, 0) PHY_NO_KVIB,
    NVL(BBM.PHY_NO_DIC, 0) PHY_NO_DIC,
    BFO.BUD_ID,
    BFO.BNF_AFROMDT,
    BFO.BNF_ATODT,
    BFO.BNF_ATOURDYS,
    BFO.BNF_APLACE,
    BFO.BNF_ASTFFNME,
    BFO.BNF_APROGDTLS,
    NVL(BFO.PH_KVIC, 0) PH_KVIC,
    NVL(BFO.FIN_KVIC, 0) FIN_KVIC,
    NVL(BFO.PH_KVIB, 0) PH_KVIB,
    NVL(BFO.FIN_KVIB, 0) FIN_KVIB,
    NVL(BFO.PH_DIC, 0) PH_DIC,
    NVL(BFO.FIN_DIC, 0) FIN_DIC,
    BFO.BNF_AGENCY,
    BFO.REMARK_ADD,
    BFO.BNF_EVENT,
    BBM.FIN_AMT_KVIC AS FIN_AMT_KVIC1,
    BBM.FIN_AMT_KVIB AS FIN_AMT_KVIB1,
    BBM.FIN_AMT_DIC  AS FIN_AMT_DIC1,
    BBM.PHY_NO_KVIB  AS PHY_NO_KVIB1,
    BBM.PHY_NO_DIC   AS PHY_NO_DIC1,
    BBM.PHY_NO_KVIC  AS PHY_NO_KVIC1,
    BFO.BNF_ASTFFDSGNTN,
    BFO.BNF_ATA,
    BFO.BNF_ADA,
    BFO.FIN_KVIB     AS FIN_KVIB1,
    BFO.FIN_KVIC     AS FIN_KVIC1,
    BFO.PH_KVIB      AS PH_KVIB1,
    BFO.PH_DIC       AS PH_DIC1,
    BFO.FIN_DIC      AS FIN_DIC1,
    BFO.PH_KVIC      AS PH_KVIC1,
    BFO.BNF_ACLBNAME AS ORGANIZER,
    BOM.STATE_NM,
    BHM.BNF_SUB_HEAD_SH_DESC,
    BBM.YEAR_ID,
    BFO.YEAR_ID AS YEAR_ID1
  FROM BNF_OFF_MAST BOM,
    BNF_BUDGET_MAST BBM,
    BNF_HEAD_MAST BHM,
    BNF_FO_TRANS BFO
  WHERE BOM.OFF_CD = BBM.OFF_CD
  AND BHM.BNF_HDID = BBM.BNF_HDID
  AND BOM.OFF_CD   = BFO.OFF_CD
  AND BHM.BNF_HDID = BFO.BUD_ID
 AND BBM.YEAR_ID=$P{YEAR_ID}
  AND BFO.YEAR_ID=$P{YEAR_ID}
  )
WHERE $P!{wrcls}
AND BUD_ID   = $P{PBUDID}
GROUP BY OFF_CD,
  BUD_ID,
  ZONE_NM,
  BNF_EVENT,
  BNF_APLACE,
  BNF_APROGDTLS,
  BNF_ATOURDYS,
  ORGANIZER,
  REMARK_ADD,
  STATE_NM,
  BNF_ASTFFNME,
  BNF_ASTFFDSGNTN,
  BNF_AGENCY,
  BNF_SUB_HEAD_SH_DESC,
  YEAR_ID,
  YEAR_ID1
ORDER BY ZONE_NM,
  STATE_NM]]>
	</queryString>
