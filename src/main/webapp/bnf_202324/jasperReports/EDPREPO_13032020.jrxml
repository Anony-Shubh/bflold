<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EDPREPO" pageWidth="1080" pageHeight="842" columnWidth="1040" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f7476a6-0481-4737-8acf-9bf57d960a07">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="238"/>
	<property name="ireport.y" value="0"/>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PBUDID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="YEAR_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT OFF_CD,
  BUD_ID,
  STATE_NM,
  ZONE_NM,
  FIN_AMT_KVIC,
  FIN_AMT_KVIB,
  FIN_AMT_DIC,
  PHY_NO_KVIC,
  PHY_NO_KVIB,
  PHY_NO_DIC,
  TR_DATE,
  BNF_TRID,
  PH_KVIC,
  PH_KVIB,
  PH_DIC,
  FIN_KVIB,
  FIN_KVIC,
  FIN_DIC,
  CASE
    WHEN PH_KVIC IS NOT NULL
    AND FIN_KVIC IS NOT NULL
    THEN 'KVIC'
    WHEN PH_KVIB IS NOT NULL
    AND FIN_KVIB IS NOT NULL
    THEN 'KVIB'
    WHEN PH_DIC IS NOT NULL
    AND FIN_DIC IS NOT NULL
    THEN 'DIC'
  END AS AGENCY,
  REMARK_ADD,
  BNF_EVENT,
  SUM(FIN_AMT_KVIC + FIN_AMT_KVIB + FIN_AMT_DIC) AS TOT_AMT,
  SUM(PHY_NO_KVIC  + PHY_NO_KVIB + PHY_NO_DIC)   AS NO_OF_PROJ,
  SUM(PH_KVIC      + PH_KVIB + PH_DIC)           AS NO_TRANS,
  SUM(FIN_KVIB     + FIN_KVIC + FIN_DIC)         AS AMT_TRANS,
  YEAR_ID
FROM
  (SELECT BOM.OFF_CD,
    BHM.BNF_SUB_HEAD_LONG_DESC AS BNF_EVENT,
    BFO.BUD_ID,
    BOM.STATE_NM,
    BOM.ZONE_NM,
    NVL(BBM.FIN_AMT_KVIC, 0)            AS FIN_AMT_KVIC,
    NVL(BBM.PHY_NO_KVIC, 0)             AS PHY_NO_KVIC,
    NVL(BBM.FIN_AMT_KVIB, 0)            AS FIN_AMT_KVIB,
    NVL(BBM.FIN_AMT_DIC, 0)             AS FIN_AMT_DIC,
    NVL(BBM.PHY_NO_KVIB, 0)             AS PHY_NO_KVIB,
    NVL(BBM.PHY_NO_DIC, 0)              AS PHY_NO_DIC,
    TO_CHAR(BFO.TR_DATE, 'DD-MON-RRRR') AS TR_DATE,
    BFO.BNF_TRID,
    NVL(BFO.PH_KVIC, 0)  AS PH_KVIC,
    NVL(BFO.FIN_KVIC, 0) AS FIN_KVIC,
    NVL(BFO.PH_KVIB, 0)  AS PH_KVIB,
    NVL(BFO.FIN_KVIB, 0) AS FIN_KVIB,
    NVL(BFO.PH_DIC, 0)   AS PH_DIC,
    NVL(BFO.FIN_DIC, 0)  AS FIN_DIC,
    BFO.BNF_AGENCY,
    BFO.REMARK_ADD,
    BBM.YEAR_ID AS YEAR_ID1,
    BFO.YEAR_ID
  FROM BNF_OFF_MAST BOM,
    BNF_BUDGET_MAST BBM,
    BNF_HEAD_MAST BHM,
    BNF_FO_TRANS BFO
  WHERE BOM.OFF_CD = BBM.OFF_CD
  AND BHM.BNF_HDID = BBM.BNF_HDID
  AND BOM.OFF_CD   = BFO.OFF_CD
  AND BHM.BNF_HDID = BFO.BUD_ID
  )
WHERE $P!{wrcls}
AND BUD_ID   = $P{PBUDID} AND YEAR_ID=$P{YEAR_ID}
GROUP BY OFF_CD,
  BUD_ID,
  STATE_NM,
  ZONE_NM,
  FIN_AMT_KVIC,
  FIN_AMT_KVIB,
  FIN_AMT_DIC,
  PHY_NO_KVIC,
  PHY_NO_KVIB,
  PHY_NO_DIC,
  TR_DATE,
  BNF_TRID,
  PH_KVIC,
  PH_KVIB,
  PH_DIC,
  FIN_KVIB,
  FIN_KVIC,
  FIN_DIC,
  REMARK_ADD,
  BNF_EVENT,
  BNF_AGENCY,
  YEAR_ID
ORDER BY ZONE_NM,
  STATE_NM]]>
	</queryString>
