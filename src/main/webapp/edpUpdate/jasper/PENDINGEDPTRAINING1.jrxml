<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PENDINGEDPTRAINING" pageWidth="2880" pageHeight="609" orientation="Landscape" columnWidth="2852" leftMargin="10" rightMargin="18" topMargin="19" bottomMargin="19" isIgnorePagination="true" uuid="b702cba4-451a-4c62-ba9f-f4d6ad9ea34a">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="1252"/>
	<property name="ireport.y" value="0"/>
	<parameter name="WHERECLS" class="java.lang.String">
		<defaultValueExpression><![CDATA["   "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT AGENCY_STATE,
  OFF_NAME,
  PMEGP_APPLICANTION_ID,
  APPLICANT_NAME,
  DISTRICT_NAME,
  APP_POST_ADDR,
  APP_TALUK_BLOCK,
  APP_PIN,
  MOB_NO1,
  DOB,
  GENDER,
LPAD(SUBSTR(AADHAR_NO,-4),LENGTH(AADHAR_NO),'X') AS AADHAR_NO,
  E_MAIL,
  IFSC_CODE,
  BANK_NAME,
  BRANCH_NAME,
  BANK_DISTRICT,
  PROJ_ADMIT_BANK,
  LOAN_SANCTIONED_DATE,
  LOAN_YR,
  IND_TYPE,
  edp_cert_dt,
  PROD_DESC,
  edp_fr_dt,
  edp_to_dt,
  EDP_TRG_NAME,
  BANK_VER_YN,
  CASE WHEN EDPUPLOADED_YN=0 THEN 'N' ELSE 'Y' END AS EDPUPLOADED_YN
FROM(
SELECT MS.STATE_NM AS AGENCY_STATE,
MOM.OFF_NAME,
MD.DISTRICT_NAME,

  AD.APP_ID        AS PMEGP_APPLICANTION_ID,
  AD.APP_NAME      AS APPLICANT_NAME,
  AD.APP_POST_ADDR,
  AD.APP_TALUK_BLOCK,
  AD.APP_PIN,
   AD.MOB_NO1,
  AD.DOB,
  AD.GENDER,
  AD.AADHAR_NO,
  AD.E_MAIL,
  BD.IFSC_CODE     AS IFSC_CODE,
  AD.BANK_NAME,
  AD.BRANCH_NAME,
  AD.BANK_DISTRICT,
  NVL(BD.WORKING_CAPITAL, 0)+NVL(BD.MACHINARY_COST, 0) AS PROJ_ADMIT_BANK,
  BD.LOAN_SANC_DT                               AS LOAN_SANCTIONED_DATE,
   GETFINYR(BD.LOAN_SANC_DT) AS LOAN_YR,
  CASE
    WHEN AD.IND_TYPE = 'S'
    THEN 'Service'
    WHEN AD.IND_TYPE = 'S'
    THEN 'Manufacturing'
    ELSE 'Trading'
  END AS IND_TYPE,
  AM.ACTIVITY_NAME
  || '('
  || AD.PROD_DESC
  || ')' AS PROD_DESC,
 TO_CHAR(bd.edp_cert_dt,'DD-MON-RRRR') AS edp_cert_dt,
 TO_CHAR(bd.edp_fr_dt,'DD-MON-RRRR') AS edp_fr_dt,
 TO_CHAR(bd.edp_to_dt,'DD-MON-RRRR') AS edp_to_dt,
 bd.edp_trg_name,
  CASE
      WHEN BD.EDP_CERT_DT IS NOT NULL
      AND BD.ACT_ID        = 11 THEN 'Y'
      ELSE 'N' END  AS BANK_VER_YN, (SELECT COUNT(DISTINCT (AUT.APP_ID))
    FROM APP_UPLOAD_TRANS AUT
    WHERE AUT.UPM_CD = 8
    AND AUT.APP_ID   = BD.APP_ID
    ) AS EDPUPLOADED_YN
FROM APP_DETAIL AD,
  BANK_DATAENTRY BD,
  MAS_OFF_MAST MOM,
  M_DISTRICT MD,
  M_STATE MS,
  ACTIVITY_MAST AM
WHERE AD.APP_ID                                   = BD.APP_ID
AND AD.ACTIVITY_CD                                = AM.ACTIVITY_CD
AND AD.OFF_CD                                     = MOM.OFF_CD
AND AD.UNIT_DIST_CD                               = MD.DISTRICT_CD
AND MS.STATE_CD                                   = MD.STATE_CD
AND BD.ACT_ID  =11
AND  BD.EDP_CERT_DT IS NULL  $P!{WHERECLS})]]>
	</queryString>
