<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pmegpaward_report" pageWidth="595" pageHeight="950" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9e1eede9-e700-415f-80ab-ea16d56f9855">
	<property name="ireport.zoom" value="0.8481952367449702"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="285"/>
	<parameter name="app_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    pa.unit_name               AS unit_name,
    pa.mob_no_n                AS mob_no_n,
    pa.email_n                 AS email_n,
    to_char(pa.est_date,'DD-MON-YYYY')  AS est_date,
    pa.anl_emp1                AS anl_emp1,
    pa.anl_sales_amt1          AS anl_sales_amt1,
    pa.anl_sales_amt2          AS anl_sales_amt2,
    pa.anl_emp2                AS anl_emp2,
    pa.anl_sales_amt3          AS anl_sales_amt3,
    pa.anl_emp3                AS anl_emp3,
   decode( pa.iso_cert_yn,'Y','YES','N','NO')  AS iso_cert_yn,
    decode(pa.gst_cert_yn,'Y','YES','N','NO')  AS gst_cert_yn,
    decode(pa.udyam_cert_yn,'Y','YES','N','NO') AS udyam_cert_yn,
    decode(pa.trademark_cert_yn,'Y','YES','N','NO') AS trademark_cert_yn,
    DECODE(pa.gem_cert_yn,'Y','YES','N','NO') AS gem_cert_yn,
    DECODE(pa.ecom_cert_yn,'Y','YES','N','NO') AS ecom_cert_yn,
  DECODE(pa.supply_cert_yn,'Y','YES','N','NO') AS supply_cert_yn,
  DECODE(pa.partic_cert_yn,'Y','YES','N','NO') AS partic_cert_yn,
    pv.gender                  AS gender,
    pv.agency_type             AS agency_type,
    pv.social_cat              AS social_cat,
    pv.benf_category_desc      AS benf_category_desc,
    pv.e_mail                  AS e_mail,
    pv.unit_loc                AS unit_loc,
    pv.off_name                AS off_name,
    pv.unit_addrs              AS unit_addrs,
    pv.unit_taluka             AS unit_taluka,
    pv.unit_dist               AS unit_dist,
    pv.unit_state              AS unit_state,
    pv.unit_pin                AS unit_pin,
    pv.ind_type                AS ind_type,
    pv.activity_name           AS activity_name,
    pv.prod_desc               AS prod_desc,
    to_char(pv.loan_sanc_dt ,'DD-MON-YYYY') AS loan_sanc_dt,
    pv.machinary_cost          AS machinary_cost,
    pv.ce_sanc_fb              AS ce_sanc_fb,
    pv.working_capital         AS working_capital,
    pv.wc_sanc_fb              AS wc_sanc_fb,
    pv.total_projectcost_fb    AS total_projectcost_fb,
    pv.total_sanction_bank     AS total_sanction_bank,
    pv.own_contribution        AS own_contribution,
    pv.mm_rel_amt              AS mm_rel_amt,
    to_char(pv.mm_rel_dt,'DD-MON-YYYY')  AS mm_rel_dt,
    pv.bank_name               AS bank_name,
    pv.branchname              AS branchname,
    pv.ifsc_code               ifsc_code,
    pv.address                 AS address,
    pv.legal_type              AS legal_type,
    pv.app_name                AS app_name,
    pv.scheme_type             AS scheme_type,
    pa.app_id   as  app_id,
    to_char(bd.ist_loan_dt,'DD-MON-YYYY') as ist_loan_dt
FROM
    pmegpaward_view  pv,
    pmegp_award      pa,
    bank_dataentry  bd
WHERE
        pa.app_id (+) = pv.app_id
    and pv.app_id=bd.app_id
    AND pv.app_id = $P{app_id}]]>
	</queryString>
