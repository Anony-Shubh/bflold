<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cftriReport" language="groovy" pageWidth="750" pageHeight="750" columnWidth="710" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="95beac09-7290-46ed-9231-0be5b401b1fe">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="325"/>
	<parameter name="app_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT am.activity_name,ad.app_id as app_id1, ad.app_name,  ct.app_id,  ct.mob_no,
ct.email_id,  decode(ct.annual_turnover, '10L','Less than 10Lacs','25L','10-25 lacs','50L','26-50 lacs','80L','51-80 lacs','80LM','More than 80 lacs') as annual_turnover,  ct.sub_activity_cd, ct.mfg_product,
ct.trng_month, decode(ct.cftri_visit_yn,'Y','Yes','N','No') as cftri_visit_yn ,
decode(ct.FOOD_PROCESS_YN,'Y','Food processing Machineries'||chr(13),null) ||
decode(ct.FOOD_EVAL_YN,'Y','Food flavours and sensory evaluations'||chr(13),null) ||
decode(ct.FOOD_MICRO_YN,'Y','Food microbiology and Fermentation'||chr(13),null)||
decode(ct.FOOD_PCK_YN,'Y','Food packaging'||chr(13),null) ||
decode(ct.FOOD_SAFETY_YN,'Y','Food safety and quality control'||chr(13),null) ||
decode(ct.INFESTATION_CONTROL_YN,'Y','Infestation control and pesticides'||chr(13),null) ||
decode(ct.FLOUR_TECH_YN,'Y','Flour Milling Baking and Confectionary Technology'||chr(13),null) ||
decode(ct.GRAIN_PROCESSING_YN,'Y','Grain processing'||chr(13),null)||
decode(ct.MEAT_MARINE_YN,'Y','Meat and Marine products'||chr(13),null)||
decode(ct.FOOD_BIOTECHNOLOGY_YN,'Y','Food biotechnology'||chr(13),null) ||
decode(ct.POST_HANDLING_YN,'Y','Post-harvest handling and processing of fresh produce'||chr(13),null) ||
decode(ct.PROCESS_SPICES_YN,'Y','Processing of Spices and plantation products'||chr(13),null)||
decode(ct.ELECTRI_IN_YN,'Y','Electrical Safety in Food Processing Industry'||chr(13),null) as trng, ct.any_remark
FROM app_detail ad,cftri_trg  ct,activity_mast am
WHERE ad.app_id = ct.app_id (+) AND ad.app_id =$P{app_id} and am.activity_cd=ct.sub_activity_cd]]>
	</queryString>
