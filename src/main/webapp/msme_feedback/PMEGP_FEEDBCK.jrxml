<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PMEGP_FEEDBCK" language="groovy" pageWidth="612" pageHeight="800" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a9cf3974-106a-4abb-91ab-2e5ef4be4e5b">
	<property name="ireport.zoom" value="1.331000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PWHRCLS" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ROWNUM ||')' AS SRNO,
    ad.app_id,
    ad.app_name,
    mom.off_name1,
    mom.agency_type,
    md.district_name,
    bd.mm_rel_amt,
  TO_CHAR(  bd.mm_rel_dt,'DD-MON-YYYY') mm_rel_dt,
    bd.fail_reason,
    bd.utrn_no,
    mfo.FB_BEFORE_LOAN,
    mfo.FB_AFT_SETTING_UNIT,
    mfo.FB_IMPRV_SUGG,
   to_char( mfo.time_stamp,'dd-MON-yyyy') AS time_stamp
FROM
    app_detail               ad,
    bank_dataentry           bd,
    mas_off_mast             mom,
    m_district               md,
    m_state                  ms,
    msme_feedback_form_one   mfo
WHERE
    ad.app_id = bd.app_id
    AND ad.off_cd = mom.off_cd
    AND md.district_cd = ad.unit_dist_cd
    AND ad.app_id = mfo.app_id
    AND md.state_cd = ms.state_cd
    AND MFO.ACT_YN='Y'

$P!{PWHRCLS}]]>
	</queryString>
