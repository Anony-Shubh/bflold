<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EDPTRAINING" pageWidth="2880" pageHeight="609" orientation="Landscape" columnWidth="2852" leftMargin="10" rightMargin="18" topMargin="19" bottomMargin="19" isIgnorePagination="true" uuid="b702cba4-451a-4c62-ba9f-f4d6ad9ea34a">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="OFFCD" class="java.lang.String"/>
	<parameter name="Pwherecls" class="java.lang.String"/>
	<parameter name="WHERECLS" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT FREE_EDPYN,ACT_DESC,AGENCY_STATE, EDP_TYPE,EDPTIMESTAMP,
  OFF_NAME,OPT,
  PMEGP_APPLICANTION_ID,
  APPLICANT_NAME,
  DISTRICT_NAME,
  EDPOFF_CD,
  APP_POST_ADDR,
  APP_TALUK_BLOCK,
  APP_PIN,
  MOB_NO1,
  DOB,
  GENDER,
LPAD(SUBSTR(AADHAR_NO,-6),LENGTH(AADHAR_NO),'X') AS AADHAR_NO,
  E_MAIL,
  IFSC_CODE,
  BANK_NAME,
  BRANCH_NAME,
  BANK_DISTRICT,
  PROJ_ADMIT_BANK,
  LOAN_SANCTIONED_DATE,

  IND_TYPE,
  edp_cert_dt,
  PROD_DESC,
  edp_fr_dt,
  edp_to_dt,
  EDP_TRG_NAME,
   EDPUPLOADED_YN
FROM(

(
SELECT
CASE WHEN BD.ACT_ID=11 AND AD.ACT_YN='Y'  THEN 'YES'
ELSE 'NO' END AS FREE_EDPYN,
 CASE       WHEN AD.ACT_ID        <= 5  AND NVL(BD.ACT_ID, 0) = 0       THEN ASM.ACT_DESC
       WHEN BD.ACT_ID > 0
       THEN BAS.ACT_DESC
     END ACT_DESC,MS.STATE_NM AS AGENCY_STATE, ED.EDP_TYPE,ED.EDPTIMESTAMP,
MOM.OFF_NAME,CASE WHEN ED.EDP_TYPE = 1THEN 'Paid online EDP'
 WHEN ED.EDP_TYPE = 2  THEN 'free Online EDP'
 WHEN ED.EDP_TYPE = 3 THEN 'Paid offline EDP'
  ELSE 'free offline EDP '
  END AS OPT,
MD.DISTRICT_NAME,
 ED.EDPOFF_CD,
  AD.APP_ID        AS PMEGP_APPLICANTION_ID,
  AD.APP_NAME      AS APPLICANT_NAME,
  AD.APP_POST_ADDR,
  AD.APP_TALUK_BLOCK,
  AD.APP_PIN,
   AD.MOB_NO1,
  AD.DOB,
  AD.GENDER,
  AD.AADHAR_NO,
  AD.E_MAIL,
  AD.IFSC_CODE     AS IFSC_CODE,
  AD.BANK_NAME,
  AD.BRANCH_NAME,
  AD.BANK_DISTRICT,
MOM.OFF_TYPE_CD,
  NVL(BD.WORKING_CAPITAL, 0)+NVL(BD.MACHINARY_COST, 0) AS PROJ_ADMIT_BANK,
  TO_CHAR(BD.LOAN_SANC_DT ,'DD-MON-RRRR')                              AS LOAN_SANCTIONED_DATE,


  CASE
    WHEN AD.IND_TYPE = 'S'
    THEN 'Service'
    WHEN AD.IND_TYPE = 'S'
    THEN 'Manufacturing'
    ELSE 'Trading'
  END AS IND_TYPE,
  AM.ACTIVITY_NAME
  || '('
  || AD.PROD_DESC
  || ')' AS PROD_DESC,
 TO_CHAR(ED.edp_cert_dt,'DD-MON-RRRR') AS edp_cert_dt,
 TO_CHAR(ED.edp_fr_dt,'DD-MON-RRRR') AS edp_fr_dt,
 TO_CHAR(ED.edp_to_dt,'DD-MON-RRRR') AS edp_to_dt,
 ED.edp_trg_name,
  CASE
      WHEN ED.EDP_CERT_DT IS NOT NULL
      THEN 'Y'
      ELSE 'N' END  AS EDPUPLOADED_YN

FROM APP_DETAIL AD,
EDP_CONDUCT_TRANS ED,
  BANK_DATAENTRY BD,
  MAS_OFF_MAST MOM,
  M_DISTRICT MD,
  M_STATE MS,
  ACTIVITY_MAST AM,APP_STATUS_MAST ASM,BANK_APP_STATUS BAS
WHERE AD.APP_ID=ED.APP_ID
AND AD.APP_ID                                   = BD.APP_ID(+)
AND AD.ACTIVITY_CD                                = AM.ACTIVITY_CD
AND ED.EDPOFF_CD                                     = MOM.OFF_CD
AND AD.APP_DIST_CD                               = MD.DISTRICT_CD
AND MS.STATE_CD                                   = MD.STATE_CD
AND AD.ACT_ID       = ASM.ACT_ID
AND BD.ACT_ID       = BAS.ACT_ID(+)
AND ED.ACT_YN='Y'
 )

 )WHERE $P!{WHERECLS}]]>
	</queryString>
