	<detail>
		<band height="73" splitType="Stretch">
			<printWhenExpression><![CDATA[($F{BENF_TYPE_CD}.equals("1") ? true : false )]]></printWhenExpression>
			<staticText>
				<reportElement x="0" y="18" width="120" height="18" uuid="b7dd7ac8-6dc1-4949-bd5d-fcac4fcd5618"/>
				<box leftPadding="3">
					<pen lineWidth="1.0"/>
					<topPen lineWidth="1.0"/>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Applicant Name ]]></text>
