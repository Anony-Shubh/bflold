	<subDataset name="INTDES" uuid="34645a8a-02b1-4349-a7de-1e55d40957f9">
		<parameter name="PAPPID" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT ITR.APP_ID,
CASE WHEN ITR.COM_MODE='M' THEN 'Mobile'
WHEN   ITR.COM_MODE='E' THEN 'eMail'
ELSE
'Others'
END COM_MODE,
  ITR.NB_NAME,
  ITR.NB_DESIG,
  ITR.INT_TIME,
  ITR.INT_REMARK
FROM INTERACTION_TRANS ITR
WHERE ITR.APP_ID = $P{PAPPID}]]>
		</queryString>
		<field name="APP_ID" class="java.lang.String"/>
		<field name="COM_MODE" class="java.lang.String"/>
		<field name="NB_NAME" class="java.lang.String"/>
		<field name="NB_DESIG" class="java.lang.String"/>
		<field name="INT_TIME" class="java.sql.Timestamp"/>
		<field name="INT_REMARK" class="java.lang.String"/>
		<group name="APP_ID">
			<groupExpression><![CDATA[$F{APP_ID}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="PAPPID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDOCNM" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT a.TR_ID,
  b.APP_ID,
   CASE
    WHEN a.ACT_ID IS NULL AND b.ACT_YN='Y'
    THEN
      (SELECT APP_STATUS_MAST.ACT_DESC
      FROM APP_STATUS_MAST
      WHERE APP_STATUS_MAST.ACT_ID = b.ACT_ID
      )
    WHEN  b.ACT_YN='N' AND b.ACT_ID IS NOT NULL
    THEN 'Return For Fresh Appliccation Submission'
 when a.act_id=11 and a.pact_id=34 and a.mm_rel_dt is not null then 'MM RELEASED'
  WHEN a.act_id=11 and a.mm_claim_amt >0 and a.LOAN_DOCFNAME is not null AND a.PACT_ID IS NULL then 'MM CLAIMED'
    WHEN a.act_id=11 and a.PACT_ID=30 AND a.apprv_yn='A' and a.mm_claim_amt >0 and a.LOAN_DOCFNAME is not null then ' MM CLAIMED AND REFERRED BACK CASE'
     WHEN a.act_id=11 and a.PACT_ID=32 AND a.apprv_yn='A' then 'MM CLAIMED AND RECOMMENDED FOR DISBURSEMENT'

    ELSE
      (SELECT BANK_APP_STATUS.ACT_DESC
      FROM BANK_APP_STATUS
      WHERE BANK_APP_STATUS.ACT_ID = a.ACT_ID
      )
  END                                   AS CUR_APP_STATUS,
  TO_CHAR(a.BANK_REC_DT, 'DD-MON-YYYY') AS bank_rec_dt,
  mrt.co_remarks as ref_remarks,

  a.BANK_REMARKS,
  AM.ACTIVITY_NAME
  || '('
  || b.PROD_DESC
  || ')' AS ACTIVITY_NAME,
  b.GENDER,
  b.UNIT_LOC,
  C.BENF_CATEGORY_DESC,
  DECODE(b.IND_TYPE, 'M', 'Manufacturing', 'Service/Trading') AS ind_type,
  TO_CHAR(a.LOAN_SANC_DT, 'DD-MON-YYYY')                      AS loan_sanc_dt,
  NVL(a.WORKING_CAPITAL, 0)                                   AS PRJ_CE_BK,
  NVL(a.MACHINARY_COST, 0)                                    AS PRJ_WC_BK,
  NVL(a.MACHINARY_COST, 0) + NVL(a.WORKING_CAPITAL, 0)        AS PRJ_TOTAL_BK,
  a.CE_SANC_FB,
  a.WC_SANC_FB,
  NVL(a.CE_SANC_FB, 0) + NVL(a.WC_SANC_FB, 0) AS BK_TOTAL_SANC,
  NVL(a.OWN_CONTRIBUTION, 0)                  AS OWN_CONTRIBUTION,
  TO_CHAR(a.OWN_CONT_DT, 'DD-MON-YYYY')       AS own_cont_dt,
  a.IST_LOAN_AMT,
  TO_CHAR(a.IST_LOAN_DT, 'DD-MON-YYYY') AS ist_loan_dt,
  DECODE(a.CGTSI,'Y','YES','NO') AS CGTSI,
  TO_CHAR(a.MM_CLAIM_DT, 'DD-MON-YYYY') AS mm_claim_dt,
  a.MM_CLAIM_AMT,
  TO_CHAR(a.MM_REL_DT, 'DD-MON-YYYY') AS mm_rel_dt,
  a.MM_REL_AMT,
  UPPER(b.APP_NAME)                    AS APP_NAME,
  TO_CHAR(a.TDR_ADJ_DT, 'DD-MON-YYYY') AS tdr_adj_dt,
  TO_CHAR(SysDate, 'DD-MON-YYYY')      AS TODAYDT,
  b.IFSC_CODE,
  a.BANK_COMMENT,
  TO_CHAR(a.TIME_STAMP, 'DD-MON-YYYY:HH:MM:SS') AS time_stamp,
  b.BANK_NAME,
  b.BANK_POST_ADDR,
  b.BANK_TALUK_BLOCK,
  b.BANK_PINCD,
  b.BANK_DIST_CD,
  b.APP_PRIX,
  b.FH_NAME,
  b.MOB_NO1,
  b.E_MAIL,
  b.APP_POST_ADDR,
  b.APP_TALUK_BLOCK,
  b.APP_DIST_CD,
  b.APP_PIN,
  b.UNIT_POST_ADDR,
  b.UNIT_TALUK_BLOCK,
  b.UNIT_DIST_CD,
  b.UNIT_PIN,
  b.REGD_NO,
  b.TAN_NO,
  NVL(DLTFC_CE,0)                AS DLTFC_CE,
   NVL(b.DLTFC_WC, 0)                 AS DLTFC_WC,
  NVL(b.DLTFC_CE, 0) + NVL(b.DLTFC_WC, 0) AS DLTFC_TOTAL,
  b.BANK_F_DATE,
  b.BRANCH_NAME,
  b.AADHAR_NO,
  M.OFF_NAME,
  b.DOB,
  M.AGENCY_TYPE,
  S.BENF_CATEGORY_DESC AS SPE_CAT,
  b.PAN_NO,
  BTM.BENF_TYPE_DESC,
  MM_PER(b.APP_ID)                                                                                         AS MM_PER,
  OWNCONT_PER(b.APP_ID)                                                                                    AS OWNCONT_PER,
  100                               - OWNCONT_PER(b.APP_ID)                                                AS BANK_LOAN_PER,
  ROUND(((NVL(a.WORKING_CAPITAL, 0) + NVL(a.MACHINARY_COST, 0)) * OWNCONT_PER(b.APP_ID)) / 100, 0)         AS OWN_CONT_AMT_CALC,
  ROUND(((NVL(a.WORKING_CAPITAL, 0) + NVL(a.MACHINARY_COST, 0)) * MM_PER(b.APP_ID)) / 100, 0)              AS MM_AMT_CALC,
  ROUND(((NVL(a.WORKING_CAPITAL, 0) + NVL(a.MACHINARY_COST, 0)) * (100 - OWNCONT_PER(b.APP_ID))) / 100, 0) AS BANK_LOAN_CALC,
  NVL(a.WORKING_CAPITAL, 0)         + NVL(a.MACHINARY_COST, 0)                                             AS TOTAL_PRJ_BK,
  a.FB_ACNO,
  a.APPLOAN_ACCNO,
  a.EDP_TRG_NAME,
  a.EDP_CERT_DT,
  b.MACHINARY_COST,
  b.WORKING_CAPITAL,
  NVL(b.MACHINARY_COST, 0) + NVL(b.WORKING_CAPITAL, 0) AS TOTAL_PRJ,
  b.PROD_DESC,
  amm.MTG_ID,
  b.BENF_TYPE_CD,
  a.MACHINARY_COST                                     AS MACHINARY_COST_BK,
  a.WORKING_CAPITAL                                    AS WORKING_CAPITAL_BK,
  NVL(a.MACHINARY_COST, 0) + NVL(a.WORKING_CAPITAL, 0) AS TOTAL_SANC,
  a.LOAN_SANC_DT                                       AS LOAN_SANC_DT_BK,
  a.LOAN_PERIOD,
  a.RINT,
  a.LOAN_REMARKS,
  a.MOR_PER,
  a.OWN_CONT_DT      AS OWN_CONT_DT_BK,
  a.OWN_CONTRIBUTION AS OWN_CONTRIBUTION_BK,
  a.EDP_FR_DT,
  a.EDP_TO_DT,
  a.IST_LOAN_DT AS IST_LOAN_DT_BK,
  a.TDR_ADJ_DT  AS TDR_ADJ_DT_BK,
  a.TDR_ADJ_AMT,
  a.MM_ADJ_DT,
  a.TDR_ACNO,
  a.MM_ADJ_AMT,
  amm.MTG_PLACE,
  e.EDU_DESC,
  amm.MT_DATE

FROM bank_dataentry a,
  app_detail b,
  BENF_CATEGORY_MAST C,
  BENF_CATEGORY_MAST S,
  ACTIVITY_MAST AM,
  MAS_OFF_MAST M,
  BENF_TYPE_MAST BTM,
  app_meeting_mast amm,
  education_mast e,mm_remarks_trans MRT
WHERE b.BENF_SPECAT_CD = S.BENF_CATEGORY_CD
AND b.ACTIVITY_CD      = AM.ACTIVITY_CD
AND b.OFF_CD           = M.OFF_CD
AND b.APP_ID           = a.APP_ID(+)
AND b.MTG_ID           = amm.MTG_ID(+)
AND b.BENF_CATAGORY_CD = C.BENF_CATEGORY_CD
AND b.BENF_TYPE_CD     = BTM.BENF_TYPE_CD
AND b.EDU_ID           = e.EDU_ID
AND a.remtrid=mrt.remtr_id(+)
AND b.APP_ID           = $P{PAPPID}]]>
	</queryString>
