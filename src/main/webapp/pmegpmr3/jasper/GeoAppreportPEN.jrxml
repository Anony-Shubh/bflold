<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GeoAppreportPEN" language="groovy" pageWidth="4176" pageHeight="842" columnWidth="4136" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="da8f83be-05a3-4150-8f41-9ae743b6258f">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="3553"/>
	<property name="ireport.y" value="0"/>
	<parameter name="vcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select A.*  from
(
SELECT A.APP_ID,gt.ACT_ID,
  A.APP_NAME,A.STATE_NM,GETFINYR(A.MM_REL_DT) AS MM_FIN_YR,
  gt.UNIT_NAME,
  gt.LONGITUDE,
  gt.LATITUDE,A.ZONE_NM,
  A.IFSC_CODE,A.UNIT_DIST,
  A.BANK_NAME,A.AGENCY_TYPE,
  gt.pmegpgeotagid,
  TO_CHAR(A.MM_REL_DT,'DD-MON-RRRR') AS MM_REL_DT,
 TRUNC(A.MM_REL_DT) AS MM_RELDT,
  A.MM_REL_AMT,
  gt.VERIFICATION_STATUS,
gt.VERIFICATION_BY,
 decode(gt.VERIFICATION_STATUS,'Working',gt.TOTAL_EMPLOYEES,0) as TOTAL_EMPLOYEES,
  gt.VERIFIER_REMARKS,
   to_char(gt.VERIFICATION_DATETIME,'DD-MON-RRRR') AS DATE_OF_VERIFICATION,
  gt.MM_ADJUSTMENT_AMT_S,
    case when gt.MM_ADJUSTMENT_STATUS='RM' THEN 'Recommended For MM Adjustment' WHEN gt.MM_ADJUSTMENT_STATUS='RU' THEN 'Reverification of Unit'
  END AS  MM_ADJUSTMENT_STATUS ,
   case when gt.ACT_ID=1 THEN 'Approved' WHEN gt.ACT_ID=2 THEN 'Returned For Resubmission'
   END AS  APP_STATUS ,
 bbm.BRANCH_NAME,decode(bbm.EMAIL,NULL,bbm.CONF_Email,bbm.email) as BEMAIL, gt.NODAL_OFFICER_REMARK,gr.CO_REMARKS,gt.AGENCY_UPLOAD,nvl(gt.AGN_CALLBACK,0) as AGN_CALLBACK,gt.MM_ADJUSTMENT_STATUS as MM_ADJUSTMENTSTATUS,
DECODE(gt.IS_REPAYMENT_REGULAR,'N','YES','') as NPA_YN,A.apploan_accno,
to_char(gr.PROC_DT,'DD-MON-RRRR') AS PROC_DT,gt.annual_sales_value
FROM GEOTAGAPIDATA A,rbibanklist rbi,bank_br_mast bbm,
  geotag_trans gt,geotag_remarks gr
WHERE A.APP_ID=gt.APP_ID(+)
and A.IFSC_CODE=rbi.IFSC_CODE
and rbi.IFSC_CODE=bbm.BR_IFSL_CODE
and gt.remtrid=gr.remtrid(+))A
where A.app_id not in (select udf1 from  indbank_request ir where ir.STATUS = 'success' and ir.PRODUCTINFO = 'Margin Money Callback')
$P!{vcls}]]>
	</queryString>
