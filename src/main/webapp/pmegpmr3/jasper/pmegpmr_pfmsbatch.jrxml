	<subDataset name="New Dataset 1" uuid="5bf98546-9a02-4788-8d41-0521d9adc86a">
		<parameter name="PBATCH_ID" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
            bd.pbatch_id,
            ad.app_id       AS schemespecifictransactionid,
            NULL AS project,
            TO_CHAR(bd.batch_date, 'DDMMRRRR')
            || '-'
            || getfinyr(bd.batch_date)
            || '-'
            || bd.pbatch_id AS officeorderno,
            TO_CHAR(bd.batch_date, 'DD-MM-RRRR') AS officeorderdate,
            TO_CHAR(bd.mm_rel_dt, 'DD-MM-RRRR') AS actualtransactiondate,
            upper(ad.app_name) AS receivingpartyname,
            '01.A' AS componentcode,
            'R' AS expensetype,
            bd.mm_rel_amt   AS amount,
            NULL AS expenditureorrefund,
            getfinyr(bd.batch_date)
            || ' New' AS remarks,
  ( CASE WHEN  UPPER(BD.pay_status) LIKE '%FAIL%' OR UPPER(BD.FAIL_REASON) IS NOT NULL THEN 'F' ELSE 'S' END) AS F_S,
BD.PAY_STATUS,BD.FAIL_REASON,
BD.UTRN_NO,'xxxx'||SUBSTR(BD.FB_ACNO,4,LENGTH(BD.FB_ACNO)) AS FB_ACNO, BD.IFSC_CODE, RL.BANK_NAME
FROM
            bank_dataentry   bd,
            app_detail       ad,
            RBIBANKLIST RL
        WHERE
            ad.app_id = bd.app_id
            AND bd.pbatch_id > 0
            AND bd.mm_rel_amt > 0
            AND bd.pact_id = 34
            AND bd.mm_rel_dt IS NOT NULL
            AND bd.batch_date IS NOT NULL
            AND BD.IFSC_CODE = RL.IFSC_CODE
            AND  bd.pbatch_id=$P{PBATCH_ID}
        UNION ALL
        SELECT
            bd.pbatch_id,
            ad.app_id       AS schemespecifictransactionid,
            NULL AS project,
            TO_CHAR(bd.batch_date, 'DDMMRRRR')
            || '-'
            || getfinyr(bd.batch_date)
            || '-'
            || bd.pbatch_id AS officeorderno,
            TO_CHAR(bd.batch_date, 'DD-MM-RRRR') AS officeorderdate,
            TO_CHAR(bd.mm_rel_dt, 'DD-MM-RRRR') AS actualtransactiondate,
            upper(ad.app_name) AS receivingpartyname,
            '01.A' AS componentcode,
            'R' AS expensetype,
            bd.mm_rel_amt   AS amount,
            NULL AS expenditureorrefund,
            getfinyr(bd.batch_date)
            || ' 2nd Loan' AS remarks,
 ( CASE WHEN  UPPER(BD.pay_status) LIKE '%FAIL%' OR UPPER(BD.FAIL_REASON) IS NOT NULL THEN 'F' ELSE 'S' END) AS F_S,
BD.PAY_STATUS,BD.FAIL_REASON,
BD.UTRN_NO,'xxxx'||SUBSTR(BD.FB_ACNO,4,LENGTH(BD.FB_ACNO)) AS FB_ACNO, BD.IFSC_CODE, RL.BANK_NAME

        FROM
            bank_dataentry_second   bd,
            app_detail_second       ad,
             RBIBANKLIST RL
        WHERE
            ad.app_id = bd.app_id
            AND bd.pbatch_id > 0
            AND bd.pact_id = 34
            AND bd.mm_rel_dt IS NOT NULL
            AND mm_rel_amt > 0
            AND bd.batch_date IS NOT NULL
            AND BD.IFSC_CODE = RL.IFSC_CODE
            AND  bd.pbatch_id=$P{PBATCH_ID}]]>
		</queryString>
		<field name="PBATCH_ID" class="java.math.BigDecimal"/>
		<field name="SCHEMESPECIFICTRANSACTIONID" class="java.lang.String"/>
		<field name="PROJECT" class="java.lang.String"/>
		<field name="OFFICEORDERNO" class="java.lang.String"/>
		<field name="OFFICEORDERDATE" class="java.lang.String"/>
		<field name="ACTUALTRANSACTIONDATE" class="java.lang.String"/>
		<field name="RECEIVINGPARTYNAME" class="java.lang.String"/>
		<field name="COMPONENTCODE" class="java.lang.String"/>
		<field name="EXPENSETYPE" class="java.lang.String"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="EXPENDITUREORREFUND" class="java.lang.String"/>
		<field name="REMARKS" class="java.lang.String"/>
		<field name="F_S" class="java.lang.String"/>
		<field name="PAY_STATUS" class="java.lang.String"/>
		<field name="FAIL_REASON" class="java.lang.String"/>
		<field name="UTRN_NO" class="java.lang.String"/>
		<field name="FB_ACNO" class="java.lang.String"/>
		<field name="IFSC_CODE" class="java.lang.String"/>
		<field name="BANK_NAME" class="java.lang.String"/>
	</subDataset>
	<parameter name="PBATCH_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
