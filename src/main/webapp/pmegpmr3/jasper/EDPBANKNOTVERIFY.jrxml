<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EDPBANKNOTVERIFY" pageWidth="2880" pageHeight="609" orientation="Landscape" columnWidth="2852" leftMargin="10" rightMargin="18" topMargin="19" bottomMargin="19" isIgnorePagination="true" uuid="b702cba4-451a-4c62-ba9f-f4d6ad9ea34a">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="714"/>
	<property name="ireport.y" value="0"/>
	<parameter name="WHERECLS" class="java.lang.String">
		<defaultValueExpression><![CDATA["   "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT * FROM (
SELECT A.STATE_NM,
  A.OFF_NAME,
  A.DISTRICT_NAME,
  A.APPLICANT_NAME,A.ZONE_NM,
  A.PMEGP_APPLICANTION_ID,
   A.APP_POST_ADDR
  || ' '
  || A.APP_TALUK_BLOCK
  || ' Pin:'
  ||  A.APP_PIN    AS APP_POST_ADDR,
  A.MOB_NO1,
  A.DOB,
  A.GENDER,
 DECODE(A.AADHAR_NO,NULL,NULL, '*****'     || substr(A.AADHAR_NO,7,length(A.AADHAR_NO)-6)) AADHAR_NO ,
  A.E_MAIL,
  A.IFSC_CODE,
  A.BANK_NAME,
  A.BRANCH_NAME,
  A.BANK_DISTRICT,
  A.PROJ_ADMIT_BANK,
  A.LOAN_YR,
 A.LOAN_SANC_DT,
  A.IND_TYPE,
  A.PROD_DESC,
  A.edp_cert_dt,
  A.edp_fr_dt,
  A.EDP_TRG_NAME,
  A.edp_to_dt,A.OFF_TYPE_CD,
  A.UPLOAD_YN,A.OFF_CD,A.ACT_ID,A.OFF_NAME1,TO_CHAR(A.MM_REL_DT,'DD-MON-RRRR') AS MM_REL_DT,A.MM_REL_AMT

FROM
  (SELECT a.*,
    DECODE(b.DOC_NAME, NULL, 'N', 'Y') AS UPLOAD_YN,b.DOC_NAME
  FROM
    (SELECT ms.STATE_NM AS STATE_NM,MOM.AGENCY_TYPE,
      mom.OFF_NAME,ZM.ZONE_NM,bd.ACT_ID,BD.OFF_CD,MO.OFF_NAME AS OFF_NAME1,MO.OFF_TYPE_CD,
      md.DISTRICT_NAME,
      ad.APP_ID   AS PMEGP_APPLICANTION_ID,
      ad.APP_NAME AS APPLICANT_NAME,
      ad.APP_POST_ADDR,
      ad.APP_TALUK_BLOCK,
      ad.APP_PIN,
      ad.MOB_NO1,
      ad.DOB,
      ad.GENDER,
      ad.AADHAR_NO,
      ad.E_MAIL,
      bd.IFSC_CODE AS IFSC_CODE,
      ad.BANK_NAME,
      ad.BRANCH_NAME,
      ad.BANK_DISTRICT,
      NVL(bd.WORKING_CAPITAL, 0) + NVL(bd.MACHINARY_COST, 0) AS PROJ_ADMIT_BANK,
      bd.LOAN_SANC_DT,
      GETFINYR(bd.LOAN_SANC_DT)                              AS LOAN_YR,
      CASE
        WHEN ad.IND_TYPE = 'S'
        THEN 'Service'
        WHEN ad.IND_TYPE = 'S'
        THEN 'Manufacturing'
        ELSE 'Trading'
      END AS IND_TYPE,
      AM.ACTIVITY_NAME
      || '('
      || ad.PROD_DESC
      || ')'                                 AS PROD_DESC,
      TO_CHAR(bd.EDP_CERT_DT, 'DD-MON-RRRR') AS edp_cert_dt,
      TO_CHAR(bd.EDP_FR_DT, 'DD-MON-RRRR')   AS edp_fr_dt,
      TO_CHAR(bd.EDP_TO_DT, 'DD-MON-RRRR')   AS edp_to_dt,
      bd.EDP_TRG_NAME,bd.MM_REL_DT,bd.MM_REL_AMT
    FROM app_detail ad,
      bank_dataentry bd,
      mas_off_mast mom,MAS_OFF_MAST MO,
      m_district md,
      m_state ms,
      ACTIVITY_MAST AM,ZONE_MAST ZM
    WHERE ad.APP_ID     = bd.APP_ID
    AND ad.OFF_CD       = mom.OFF_CD
    AND ad.UNIT_DIST_CD = md.DISTRICT_CD
    AND md.STATE_CD     = ms.STATE_CD
    AND ad.ACTIVITY_CD  = AM.ACTIVITY_CD
AND MS.ZONE_CD=ZM.ZONE_CD
 AND BD.OFF_CD=MO.OFF_CD(+)
    ) a,
    (SELECT AUT.APP_ID,
      MAX(AUT.DOC_NAME) AS DOC_NAME
    FROM APP_UPLOAD_TRANS AUT
    WHERE AUT.UPM_CD = 8 AND AUT.DOC_ACTYN='Y'
    GROUP BY AUT.APP_ID
    ) b
  WHERE a.PMEGP_APPLICANTION_ID = b.APP_ID(+)
  ) A  where $P!{WHERECLS} )]]>
	</queryString>
	<field name="STATE_NM" class="java.lang.String"/>
	<field name="OFF_NAME" class="java.lang.String"/>
	<field name="DISTRICT_NAME" class="java.lang.String"/>
