	<subDataset name="PMEGPAWARD" uuid="457e90ef-0766-4867-afd0-53677d407e73">
		<parameter name="vcls" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT ad.off_cd,
  ad.app_id,
  ad.app_name,
  pa.unit_name,
  pa.mob_no_n,
  pa.email_n,
  md.district_name AS UNIT_DIST,
  ms.state_nm,
  ms.zone_cd,
  mom.off_name1,
  mom.agency_type,
  zm.ZONE_NM,
  pa.app_approv_yn,
  pa.app_approv_date,
  pa.final_sub_dt,
  pa.update_timestamp,
  pa.dco_approv_yn,
  pa.dco_approv_date,
  pa.dco_remark
FROM app_detail ad,
  pmegp_award pa,
  mas_off_mast mom,
  m_state ms,
  m_district md,
  zone_mast zm
WHERE ad.unit_dist_cd = md.district_cd
AND md.state_cd       = ms.state_cd
AND mom.off_cd        = ad.off_cd
AND ad.app_id         = pa.app_id
AND ms.zone_cd        =zm.zone_cd
$P!{vcls}]]>
		</queryString>
		<field name="OFF_CD" class="java.math.BigDecimal"/>
		<field name="APP_ID" class="java.lang.String"/>
		<field name="APP_NAME" class="java.lang.String"/>
		<field name="UNIT_NAME" class="java.lang.String"/>
		<field name="MOB_NO_N" class="java.lang.String"/>
		<field name="EMAIL_N" class="java.lang.String"/>
		<field name="UNIT_DIST" class="java.lang.String"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="ZONE_CD" class="java.lang.String"/>
		<field name="OFF_NAME1" class="java.lang.String"/>
		<field name="AGENCY_TYPE" class="java.lang.String"/>
		<field name="ZONE_NM" class="java.lang.String"/>
		<field name="APP_APPROV_YN" class="java.lang.String"/>
		<field name="APP_APPROV_DATE" class="java.sql.Timestamp"/>
		<field name="FINAL_SUB_DT" class="java.sql.Timestamp"/>
		<field name="UPDATE_TIMESTAMP" class="java.sql.Timestamp"/>
		<field name="DCO_APPROV_YN" class="java.lang.String"/>
		<field name="DCO_APPROV_DATE" class="java.sql.Timestamp"/>
		<field name="DCO_REMARK" class="java.lang.String"/>
	</subDataset>
