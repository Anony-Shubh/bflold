	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="MONTHWISE" uuid="283ee285-c188-4e6d-a7e2-31c8c20e44d0">
		<queryString>
			<![CDATA[SELECT bom.ZONE_NM,
  bom.STATE_NM,
  boi.MONTH_DT AS dtDIS,
  bom.OFF_NAME1,
  SUM(boi.EDP_NO)                                    AS NO_OF_EDP,
  SUM(boi.TOTAL_AMT)                                 AS total_amt,
  SUM(boi.FOPAY_AMT)                                 AS fopay_amt,
  SUM(NVL(boi.TOTAL_AMT, 0) - NVL(boi.FOPAY_AMT, 0)) AS pendingamt
FROM bnf_onlineedp_inf boi,
  bnf_off_mast bom
WHERE boi.OFF_CD = bom.OFF_CD
GROUP BY bom.ZONE_NM,
  bom.STATE_NM,
  boi.MONTH_DT,
  bom.OFF_NAME1]]>
		</queryString>
		<field name="ZONE_NM" class="java.lang.String"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="DTDIS" class="java.sql.Timestamp"/>
		<field name="OFF_NAME1" class="java.lang.String"/>
		<field name="NO_OF_EDP" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMT" class="java.math.BigDecimal"/>
		<field name="FOPAY_AMT" class="java.math.BigDecimal"/>
		<field name="PENDINGAMT" class="java.math.BigDecimal"/>
		<variable name="NO_OFF_EDP" class="java.lang.String" resetType="None" calculation="Sum">
			<variableExpression><![CDATA[$F{NO_OF_EDP}]]></variableExpression>
