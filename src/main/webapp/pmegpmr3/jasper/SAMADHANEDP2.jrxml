	<subDataset name="DATASET1" uuid="4cc10570-ccd6-4344-961a-efdc187fc25f">
		<parameter name="vcls" class="java.lang.String"/>
		<queryString>
			<![CDATA[select * from (SELECT
    mq.app_id,
    mq.app_name,
    mq.agency_type,
    mq.district_name,
    mq.off_name2,
    mq.state_nm,
    mq.zone_nm,
    mq.current_status,
    TO_CHAR(bsa.inv_date,'DD-MON-YYYY')AS inv_date,
    mq.cert_dt,mq.ACTUAL_EDP


FROM
    (
        SELECT
            ad.app_id,
            ad.app_name,
            mom.agency_type,
            md.district_name,
            mom.off_name2,
            ms.state_nm,
            zm.zone_nm,
            ser.cert_dt,
            CASE
                WHEN ser.rejbybank = 1     THEN
                    'Sanction Revoked by Bank and EDP Completed'
                WHEN ser.pre_edponline = 1 THEN
                    'Pre/Incompete Online EDP'
                ELSE
                    'POST SANCTION EDP'
            END current_status,
            (ser.totalonlinemis_edp)+(ser.rejbybank)-(ser.pre_edponline) AS ACTUAL_EDP
        FROM
            samadhan_edp_recons   ser,
            app_detail            ad,
            bank_dataentry        bd,
            mas_off_mast          mom,
            m_district            md,
            m_state               ms,
            zone_mast             zm
        WHERE
            ser.app_id = ad.app_id
            AND ad.app_id = bd.app_id (+)
            AND ad.off_cd = mom.off_cd
            AND ad.unit_dist_cd = md.district_cd
            AND md.state_cd = ms.state_cd
            AND ms.zone_cd = zm.zone_cd

    ) mq,
    bnf_samadhanedp_appdetail                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      bsa
WHERE
    mq.app_id = bsa.app_id (+))A
where $P!{vcls}]]>
		</queryString>
		<field name="APP_ID" class="java.lang.String"/>
		<field name="APP_NAME" class="java.lang.String"/>
		<field name="AGENCY_TYPE" class="java.lang.String"/>
		<field name="DISTRICT_NAME" class="java.lang.String"/>
		<field name="OFF_NAME2" class="java.lang.String"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="ZONE_NM" class="java.lang.String"/>
		<field name="CURRENT_STATUS" class="java.lang.String"/>
		<field name="INV_DATE" class="java.lang.String"/>
		<field name="CERT_DT" class="java.sql.Timestamp"/>
		<field name="ACTUAL_EDP" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="vcls" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM DUAL]]>
	</queryString>
	<field name="DUMMY" class="java.lang.String"/>
