<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="apr202223" language="groovy" pageWidth="936" pageHeight="842" columnWidth="896" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="907e1191-f130-4228-a1c0-ab7ee6f1f7b8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="57"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT
    MAX(ord_no) AS ORDNO,
     nvl(zone_nm,'zGrand Total') as zone_nm,
    nvl(state_nm,'Total') as state_nm,
    SUM(prj_no_tgt) AS PRJ_TGT,
     SUM(mm_tgt) AS MM_TGT,
     SUM(emp) AS EMP_TGT,
      SUM(no_of_prj) AS PRJ_NO,
    SUM(mm_rel) AS MM_REL,
     SUM(emp_estimate) AS EMP_EST
  ----   SUM(emp_ach) AS EMP_ACH,
  -----   SUM(loan_sanc) AS LOAN_SAN
FROM
    (
        SELECT
            pmo.ord_no,
            pmo.mis_off_cd,
            zm.zone_nm,
            ms.state_nm,
            pmo.off_name,
            nvl(pmo.prj_no_tgt, 0) + nvl(pmo.prj_no_tgt_ii, 0) AS prj_no_tgt,
             nvl(pmo.mm_tgt, 0) + nvl(pmo.mm_tgt_ii, 0) AS mm_tgt,
            nvl(pmo.emp, 0) + nvl(pmo.emp_ii, 0) AS emp,
             0 AS mm_rel,
            0 AS no_of_prj,
            0 AS emp_estimate,
            0 AS emp_ach,
            0 AS loan_sanc
        FROM
            mmtarget_online_2223   pmo,
            m_state                ms,
            zone_mast              zm
        WHERE
            pmo.state_cd = ms.state_cd
            AND ms.zone_cd = zm.zone_cd
        UNION ALL
        SELECT
            MAX(0) AS ord_no,
            mom.mis_off_cd,
            zm.zone_nm,
            ms.state_nm,
            mom.off_name1,
            0 AS mm_tgt,
            0 AS prj_tgt,
            0 AS emp_tgt,
            round(SUM(bd.mm_rel_amt) / 100000, 2) mm_rel,
            COUNT(*) AS no_of_prj,
            COUNT(bd.app_id) * 8 AS emp_estimate,
            SUM(ad.emp_env) AS emp,
            round(SUM(nvl(bd.wc_sanc_fb, 0) + nvl(bd.ce_sanc_fb, 0)) / 100000, 2) AS loan_sanc
        FROM
            bank_dataentry   bd,
            app_detail       ad,
            m_district       md,
            m_state          ms,
            zone_mast        zm,
            mas_off_mast     mom
        WHERE
            bd.app_id = ad.app_id
            AND ad.unit_dist_cd = md.district_cd
            AND md.state_cd = ms.state_cd
            AND ms.zone_cd = zm.zone_cd
            AND ad.off_cd = mom.off_cd
            AND bd.pact_id = 34
            AND trunc(bd.mm_rel_dt) BETWEEN '01-APR-2022' AND '31-MAR-2023'
        GROUP BY
            mom.mis_off_cd,
            zm.zone_nm,
            ms.state_nm,
            mom.off_name1
            UNION ALL

             SELECT
            MAX(0) AS ord_no,
            mom.mis_off_cd,
            zm.zone_nm,
            ms.state_nm,
            mom.off_name1,
            0 AS mm_tgt,
            0 AS prj_tgt,
            0 AS emp_tgt,
            round(SUM(bd.mm_rel_amt) / 100000, 2) mm_rel,
            COUNT(*) AS no_of_prj,
            COUNT(bd.app_id) * 8 AS emp_estimate,
            SUM(ad.emp_env) AS emp,
            round(SUM(nvl(bd.wc_sanc_fb, 0) + nvl(bd.ce_sanc_fb, 0)) / 100000, 2) AS loan_sanc
        FROM
            bank_dataentry_SECOND   bd,
            app_detail_SECOND       ad,
            m_district       md,
            m_state          ms,
            zone_mast        zm,
            mas_off_mast     mom
        WHERE
            bd.app_id = ad.app_id
            AND ad.unit_dist_cd = md.district_cd
            AND md.state_cd = ms.state_cd
            AND ms.zone_cd = zm.zone_cd
            AND ad.off_cd = mom.off_cd
            AND bd.pact_id = 34
            AND trunc(bd.mm_rel_dt) BETWEEN '01-APR-2022' AND '31-MAR-2023'
        GROUP BY
            mom.mis_off_cd,
            zm.zone_nm,
            ms.state_nm,
            mom.off_name1
    )
    GROUP BY
    ROLLUP(zone_nm,
    state_nm)
    ORDER BY   MAX(ord_no),zone_nm]]>
	</queryString>
	<field name="ORDNO" class="java.math.BigDecimal"/>
	<field name="ZONE_NM" class="java.lang.String"/>
	<field name="STATE_NM" class="java.lang.String"/>
	<field name="PRJ_TGT" class="java.math.BigDecimal"/>
	<field name="MM_TGT" class="java.math.BigDecimal"/>
	<field name="EMP_TGT" class="java.math.BigDecimal"/>
	<field name="PRJ_NO" class="java.math.BigDecimal"/>
	<field name="MM_REL" class="java.math.BigDecimal"/>
	<field name="EMP_EST" class="java.math.BigDecimal"/>
