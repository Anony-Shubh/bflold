	<subDataset name="intquery" uuid="68641c78-9fc3-4be6-8065-4ea46ca46612">
		<parameter name="BANK_NAME" class="java.lang.String">
			<property name="BANK_NAME" value="$F{BANK_NAME}"/>
			<parameterDescription><![CDATA[]]></parameterDescription>
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="STATE_NM" class="java.lang.String">
			<property name="STATE_NM" value="$F{STATE_NM}"/>
			<parameterDescription><![CDATA[]]></parameterDescription>
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT RBL.BANK_NAME,ms.state_nm,
getfinyr(BD.LOAN_SANC_DT) AS FINYEAR,
COUNT(*) AS APP_SANCTIONED,
MAX(BD.RINT) AS MAX_RINT, MIN(BD.RINT) AS MIN_RINT
FROM APP_DETAIL AD, BANK_DATAENTRY BD ,
RBIBANKLIST RBL,M_DISTRICT MD,M_STATE MS
WHERE AD.APP_ID=BD.APP_ID
AND AD.UNIT_DIST_CD=MD.DISTRICT_CD
AND MD.STATE_CD=MS.STATE_CD
AND AD.IFSC_CODE=RBL.IFSC_CODE
AND BD.ACT_ID=11 AND BD.RINT BETWEEN 6 AND 15
AND RBL.BANK_NAME=$P{BANK_NAME}
AND ms.state_nm=$P{STATE_NM}
GROUP BY
RBL.BANK_NAME,ms.state_nm,
getfinyr(BD.LOAN_SANC_DT)
order by FINYEAR desc]]>
		</queryString>
		<field name="BANK_NAME" class="java.lang.String"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="FINYEAR" class="java.lang.String"/>
		<field name="APP_SANCTIONED" class="java.math.BigDecimal"/>
		<field name="MAX_RINT" class="java.math.BigDecimal"/>
		<field name="MIN_RINT" class="java.math.BigDecimal"/>
		<group name="BANK_NAME">
			<groupExpression><![CDATA[$F{BANK_NAME}]]></groupExpression>
		</group>
	</subDataset>
	<queryString>
		<![CDATA[SELECT RBL.BANK_NAME,ms.state_nm,
getfinyr(BD.LOAN_SANC_DT) AS FINYEAR,
COUNT(*) AS APP_SANCTIONED,
MAX(BD.RINT) AS MAX_RINT, MIN(BD.RINT) AS MIN_RINT
FROM APP_DETAIL AD, BANK_DATAENTRY BD ,
RBIBANKLIST RBL,M_DISTRICT MD,M_STATE MS
WHERE AD.APP_ID=BD.APP_ID
AND AD.UNIT_DIST_CD=MD.DISTRICT_CD
AND MD.STATE_CD=MS.STATE_CD
AND AD.IFSC_CODE=RBL.IFSC_CODE
AND BD.ACT_ID=11 AND BD.RINT BETWEEN 6 AND 15
GROUP BY
RBL.BANK_NAME,ms.state_nm,
getfinyr(BD.LOAN_SANC_DT)
 order by FINYEAR desc]]>
	</queryString>
	<field name="BANK_NAME" class="java.lang.String"/>
	<field name="STATE_NM" class="java.lang.String"/>
	<field name="FINYEAR" class="java.lang.String"/>
	<field name="APP_SANCTIONED" class="java.math.BigDecimal"/>
	<field name="MAX_RINT" class="java.math.BigDecimal"/>
	<field name="MIN_RINT" class="java.math.BigDecimal"/>
