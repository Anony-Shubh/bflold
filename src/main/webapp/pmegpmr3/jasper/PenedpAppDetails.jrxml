<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PenedpAppDetails" language="groovy" pageWidth="5760" pageHeight="595" orientation="Landscape" columnWidth="5720" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="44826354-0498-4f0c-8e9b-8104c61159f4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="vcls" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ad.APP_ID,
     ad.APP_NAME,
     UPPER(ad.FH_NAME) AS FH_NAME,
     mo.AGENCY_TYPE,
     mo.OFF_NAME,
     ad.BANK_NAME,
     NVL(ad.REMARKS, '') AS Remraks_up_rej,
     ad.UNIT_LOC,
     ms.STATE_NM,
     DECODE(ad.mob_no2,NULL,NULL, '*****'    || substr(ad.mob_no2,6,length(ad.mob_no2)-5)) AS TEL_NO,
     ad.E_MAIL,
     DECODE(ad.aadhar_no,NULL,NULL, '*****'     || substr(ad.aadhar_no,7,length(ad.aadhar_no)-6)) AADHAR_NO,
     TO_CHAR(ad.ONLINE_SUBDT, 'DD-MON-RRRR') ONLINESUBDT,
     ad.BENF_SPECAT_CD,
     bd.PAY_STATUS,
     bd.UTRN_NO,
     bd.FAIL_REASON,
     ad.APP_POST_ADDR
     || ' , '
     || ad.APP_TALUK_BLOCK
     || ' '
     || ' Dist:'
     || bend.DISTRICT_NAME
     || ' Pin:'
     || ad.APP_PIN        AS app_addr,
     DECODE(ad.mob_no1,NULL,NULL, '*****'    || substr(ad.mob_no1,6,length(ad.mob_no2)-5)) AS ONLINEMOBNO,
     MMINVOLVE(ad.APP_ID) AS MM_INV,
     BTM.BENF_TYPE_DESC,
     bcm.BENF_CATEGORY_DESC,
     ad.GENDER,
     TO_CHAR(ad.DOB, 'dd-mon-RRRR') AS dob,
     DECODE(ad.ACT_ID, 1, asm.ACT_DESC
     || ' At Agency-'
     || ad.REMARKS) AS dltfc_remarks,
     CASE
       WHEN ad.DOB IS NOT NULL
       THEN ROUND(months_between(ad.APP_REC_DATE, ad.DOB) / 12, 0)
     END AS age,
     (
     CASE
       WHEN ad.ACT_ID = 7
       THEN '-No-'
       WHEN ad.ACT_ID = 5
       THEN '-Yes-'
     END)                             AS DLTFC_REJ_yn,
     DECODE(ad.ACT_ID, 7, ad.REMARKS) AS dltfc_status,
     CASE
        WHEN AD.ACT_ID       <= 5  AND NVL(bd.ACT_ID, 0) = 0
       THEN asm.ACT_DESC
       ELSE bas.ACT_DESC
     END               AS current_status,
     udm.DISTRICT_NAME AS Unit_district,
     edm.EDU_DESC,
     ad.UNIT_POST_ADDR
     || ' '
     || ad.UNIT_TALUK_BLOCK
     || ' Dist:'
     || udm.DISTRICT_NAME
     || ' Pin:'
     || ad.UNIT_PIN                                       AS unit_addr,
     UPPER(ad.UNIT_TALUK_BLOCK)                           AS UNIT_TALUK_BLOCK,
     DECODE(ad.IND_TYPE, 'S', 'Service', 'Manufacturing') AS ind_type,
     igm.IND_GRP_LONG_DESC,
     am.ACTIVITY_NAME
     || ' / '
     || ad.PROD_DESC                                                                                            AS activity_name,
     NVL(ad.WORKSHED_COST, 0) + NVL(ad.PRE_OPE_EXP, 0) + NVL(ad.MACHINARY_COST, 0) + NVL(ad.WORKING_CAPITAL, 0) AS proj_cost,
     ad.BANK_NAME
     || ' , '
     || ad.BANK_POST_ADDR
     || ','
     || ad.BANK_TALUK_BLOCK
     || 'IFSC Code:'
     || ad.IFSC_CODE AS bank_addr,
     (
     CASE
       WHEN bd.ACT_ID = 3
       THEN 'No'
       WHEN bd.ACT_ID = 11
       THEN '-Yes-'
       WHEN bd.ACT_ID = 8
       THEN '-'
     END) bank_Status,
     TO_CHAR(ad.APP_REC_DATE, 'dd-mon-RRRR') AS app_rec_date,
     TO_CHAR(amm.MT_DATE, 'dd-mon-RRRR')     AS mt_date,
     amm.MTG_PLACE,
     TO_CHAR(ad.BANK_F_DATE, 'dd-mon-RRRR')                   AS bank_f_date,
     TO_CHAR(bd.BANK_REC_DT, 'dd-mon-RRRR')                   AS bank_rec_date,
     DECODE(bd.ACT_ID, 3, bd.BANK_REMARKS, '')                AS bank_remarks,
     TO_CHAR(bd.LOAN_SANC_DT, 'dd-mon-RRRR')                  AS loan_sanc_dt,
     (NVL(bd.MACHINARY_COST, 0))                              AS CE,
     NVL(bd.WORKING_CAPITAL, 0)                               AS WORKING_CAPITAL,
     (NVL(bd.MACHINARY_COST, 0) + NVL(bd.WORKING_CAPITAL, 0)) AS total_sanc,
     bd.OWN_CONTRIBUTION,
     0 AS bank_loan,
     bd.MM_CLAIM_AMT,
     bd.EDP_TRG_NAME                               AS edp_trg_nm,
     TO_CHAR(bd.EDP_FR_DT, 'dd-mon-RRRR')          AS edp_fr_dt,
     TO_CHAR(bd.EDP_TO_DT, 'dd-mon-RRRR')          AS edp_to_dt,
     TO_CHAR(bd.EDP_CERT_DT, 'dd-mon-RRRR')        AS EDP_CERT_DT,
     ''                                            AS Nodal_bank,
     NVL(bd.CE_SANC_FB, 0)                         AS CE_SANC_FB,
     NVL(bd.WC_SANC_FB, 0)                         AS WC_SANC_FB,
     NVL(bd.CE_SANC_FB, 0) + NVL(bd.WC_SANC_FB, 0) AS TOT_SANC_FB,
     bd.IST_LOAN_AMT,
     CASE
       WHEN bd.EDP_TO_DT IS NOT NULL
       THEN (bd.EDP_TO_DT - bd.EDP_FR_DT) + 1
     END                                    AS edp_days,
     TO_CHAR(bd.IST_LOAN_DT, 'dd-mon-RRRR') AS ist_loan_dt,
     bd.CGTSI,
     bd.MM_CLAIM_LRNO,
     TO_CHAR(bd.MM_CLAIM_DT, 'dd-mon-RRRR') AS mm_claim_dt,
     bd.MM_CLAIM_AMT,
     bd.MM_REL_AMT,
     TO_CHAR(bd.MM_REL_DT, 'dd-mon-RRRR') AS mm_rel_dt,
     bd.EMP,
     MRT.CO_REMARKS,
     bd.PROD,
     bd.SALES,
     TO_CHAR(bd.PV_DT, 'dd-mon-RRRR') AS pv_dt,
     bd.PV_VER_OFF,
     bd.MM_ADJ_BY,
     bd.MM_ADJ_AMT,
     TO_CHAR(bd.MM_ADJ_DT, 'dd-mon-RRRR') AS mm_adj_dt,
     bd.EDP_YN,
     bd.PH_YN,
     bd.PV_STATUS,
     bd.OWN_CONTRIBUTION,
     TO_CHAR(bd.OWN_CONT_DT, 'dd-mon-RRRR') AS OWN_CONT_DT,
     bd.PHY_PROD,
     bd.PHY_SALES,
     bd.PHY_EMP,
     bd.PHY_INV,bc.BENF_CATEGORY_DESC AS BENF_spec
   FROM app_detail  AD,
     bank_dataentry bd,

     m_district dm,

     m_state ms,
     app_meeting_mast amm,
     benf_type_mast BTM,
     benf_category_mast bcm,
 benf_category_mast bc,
     m_district bend,
     education_mast edm,
     m_district udm,
     app_status_mast asm,
     bank_app_status bas,
     activity_mast am,
     ind_grp_mast igm,
     MM_REMARKS_TRANS MRT,
     zone_mast zm,mas_off_mast mo
   WHERE
 ad.off_cd=mo.off_cd(+)
   AND ms.ZONE_CD          = zm.ZONE_CD
   AND bd.REMTRID          = MRT.REMTR_ID(+)
   AND ad.APP_ID           = bd.APP_ID(+)
   AND ad.app_dist_cd     = dm.DISTRICT_CD
   AND dm.STATE_CD         = ms.STATE_CD
   AND ad.MTG_ID           = amm.MTG_ID(+)
   AND ad.ACT_ID           = asm.ACT_ID
   AND bd.ACT_ID           = bas.ACT_ID(+)
   AND ad.APP_DIST_CD      = bend.DISTRICT_CD
   AND ad.BENF_TYPE_CD     = BTM.BENF_TYPE_CD
   AND ad.BENF_CATAGORY_CD = bcm.BENF_CATEGORY_CD
   AND ad.EDU_ID           = edm.EDU_ID
   AND ad.UNIT_DIST_CD     = udm.DISTRICT_CD
   AND ad.ACTIVITY_CD      = am.ACTIVITY_CD
   AND am.IND_GRP_CD       = igm.IND_GRP_CD
   AND AD.BENF_SPECAT_CD   = bc.BENF_CATEGORY_CD
AND BD.act_id=11 and BD.edp_cert_dt is null AND BD.LOAN_SANC_DT IS NOT NULL
 $P!{vcls}]]>
	</queryString>
