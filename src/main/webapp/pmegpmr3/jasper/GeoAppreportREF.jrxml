<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GeoAppreportREF" language="groovy" pageWidth="2304" pageHeight="842" columnWidth="2264" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="da8f83be-05a3-4150-8f41-9ae743b6258f">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="298"/>
	<property name="ireport.y" value="0"/>
	<parameter name="vcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select A.* ,B.TXNID,B.status,B.AMOUNT AS MM_REFUND from
(
SELECT A.APP_ID,
  A.APP_NAME,A.STATE_NM,GETFINYR(A.MM_REL_DT) AS MM_FIN_YR
 ,A.ZONE_NM,
  A.IFSC_CODE,A.UNIT_DIST,
  A.BANK_NAME,A.AGENCY_TYPE,

  TO_CHAR(A.MM_REL_DT,'DD-MON-RRRR') AS MM_REL_DT,
 TRUNC(A.MM_REL_DT) AS MM_RELDT,
  A.MM_REL_AMT,


 bbm.BRANCH_NAME,decode(bbm.EMAIL,NULL,bbm.CONF_Email,bbm.email) as BEMAIL
,A.apploan_accno
FROM PHYMMREFDATA A,rbibanklist rbi,bank_br_mast bbm

WHERE
 A.IFSC_CODE=rbi.IFSC_CODE
and rbi.IFSC_CODE=bbm.BR_IFSL_CODE
)A,
 (SELECT
     ir.UDF1 as app_id,ir.PRODUCTINFO,ir.AMOUNT,
     ir.TXNID,ir.STATUS
   FROM
     indbank_request ir
   WHERE   ir.STATUS = 'success')B
   where A.app_id(+)=B.app_id
$P!{vcls}]]>
	</queryString>
	<field name="APP_ID" class="java.lang.String"/>
	<field name="APP_NAME" class="java.lang.String"/>
	<field name="STATE_NM" class="java.lang.String"/>
	<field name="MM_FIN_YR" class="java.lang.String"/>
	<field name="ZONE_NM" class="java.lang.String"/>
	<field name="IFSC_CODE" class="java.lang.String"/>
	<field name="UNIT_DIST" class="java.lang.String"/>
	<field name="BANK_NAME" class="java.lang.String"/>
	<field name="AGENCY_TYPE" class="java.lang.String"/>
	<field name="MM_REL_DT" class="java.lang.String"/>
	<field name="MM_RELDT" class="java.sql.Timestamp"/>
	<field name="MM_REL_AMT" class="java.math.BigDecimal"/>
	<field name="BRANCH_NAME" class="java.lang.String"/>
	<field name="BEMAIL" class="java.lang.String"/>
	<field name="APPLOAN_ACCNO" class="java.lang.String"/>
	<field name="TXNID" class="java.lang.String"/>
	<field name="STATUS" class="java.lang.String"/>
	<field name="MM_REFUND" class="java.lang.String"/>
