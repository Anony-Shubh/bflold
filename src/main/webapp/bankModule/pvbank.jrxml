	<parameter name="APP_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TO_CHAR(BD.MM_REL_DT, 'DD-MON-RRRR') AS MM_REL_DT,
  AD.APP_ID,  AD.APP_NAME,   RBI.BANK_NAME,  RBI.IFSC_CODE,
  RBI.BRANCHNAME,  RBI.ADDRESS,   BD.IST_LOAN_AMT,(NVL(BD.CE_SANC_FB,0)+NVL(BD.WC_SANC_FB,0)) AS TOT_SANC,
  TO_CHAR(BD.IST_LOAN_DT, 'DD-MON-RRRR') AS IST_LOAN_DT,
  DECODE(GP.CE_SANC_FB,NULL,BD.CE_SANC_FB,GP.CE_SANC_FB) AS CE_SANC_FB,
  DECODE(GP.WC_SANC_FB,NULL,BD.WC_SANC_FB,GP.WC_SANC_FB) AS WC_SANC_FB,
  DECODE(GP.RINT,NULL,BD.RINT,GP.RINT) AS RINT,
  BD.MM_REL_AMT, TO_CHAR(DECODE(GP.TDR_ADJ_DT,NULL,BD.TDR_ADJ_DT,GP.TDR_ADJ_DT),'DD-MON-RRRR') AS TDR_ADJ_DT,
  DECODE(GP.TDR_ADJ_AMT,NULL,BD.mm_rel_amt,GP.TDR_ADJ_AMT) AS TDR_ADJ_AMT,
  DECODE(GP.TDR_ACNO,NULL,BD.TDR_ACNO,GP.TDR_ACNO) AS TDR_ACNO,
  DECODE(GP.CGTSI,NULL,BD.CGTSI,GP.CGTSI) AS CGTSI,
  GP.CE_DISB_FB,GP.WC_DISB_FB,GP.TOT_BAL_FB,  DECODE(GP.CC_AVAIL_100PER_YN,'Y','Yes','N','No','-') as CC_AVAIL_100PER_YN,
  GP.CC_UTILISE_3YR_PER,  DECODE(GP.INTCHARGE_ONMM,'Y','Yes','N','No','-') as INTCHARGE_ONMM,
  DECODE(GP.COL_SEC_YN,'Y','Yes','N','No','-') as COL_SEC_YN,  GP.COL_SEC_AMT,  DECODE(GP.REPAY_LOAN_YN,'Y','Yes','N','No','-') as REPAY_LOAN_YN ,
  DECODE(GP.NPA_YN,'Y','Yes','N','No','-') as NPA_YN,  TO_CHAR(GP.NPA_DT,'DD-MON-RRRR') AS NPA_DT,   GP.ANNL_PROD,
  DECODE(GP.UNIT_CUR_STATUS,'W','Working','D','Not Working/defunct','NT','Non-Traceable','-'  )AS UNIT_CUR_STATUS,
  GP.ANNL_SALE,
  TO_CHAR(GP.BUSINESS_COM_DT,'DD-MON-RRRR') AS BUSINESS_COM_DT,   GP.ANY_OTH_REMARKS,  GP.UPDATE_TIMESTAMPDT,
  GP.ACT_ID,  GP.GPV_ID,  DECODE(GP.MOB_NO1,NULL, AD.MOB_NO1,GP.MOB_NO1) AS MOB_NO1,
  DECODE(GP.BANK_PHONE_NO,NULL,RBI.MOBNO,GP.BANK_PHONE_NO) AS CONTACT_DETAIL
 FROM APP_DETAIL AD,
  BANK_DATAENTRY BD,
  RBIBANKLIST RBI,
  GEOTAG_PVBANKFORM GP  WHERE AD.APP_ID   = BD.APP_ID AND AD.IFSC_CODE  = RBI.IFSC_CODE AND BD.APP_ID     = GP.APP_ID(+)
 AND AD.APP_ID    = $P{APP_ID} AND BD.PACT_ID    = 34 AND BD.MM_REL_DT IS NOT NULL]]>
	</queryString>
