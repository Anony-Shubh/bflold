	<queryString language="SQL">
		<![CDATA[SELECT A.* FROM ( SELECT MAX('ALL') as zone_nm , MOM.AGENCY_TYPE as off_name1 ,COUNT(*) as TOTALDATAENTERED ,sum( nvl(case when ad.app_rec_date between '01-APR-2013' and '15-JAN-2014' then 1 end ,0)) as APP_REC ,sum( nvl(case when amm.mt_date between '01-APR-2013' and '15-JAN-2014' then 1 end ,0)) as dtfc_place ,sum( nvl(case when amm.mt_date between '01-APR-2013' and '15-JAN-2014' and ad.act_id<>7 then 1 end ,0)) as dtfc_sanction ,sum( nvl(case when ad.bank_f_date between '01-APR-2013' and '15-JAN-2014' and ad.act_id=5 then 1 end ,0)) as bank_ford ,sum( nvl(case when ad.bank_f_date between '01-APR-2013' and '15-JAN-2014' and ad.act_id=5 then round(mminvolve(bd.app_id)/100000,2) end ,0)) as bankfordmminv,sum( nvl(case when bd.loan_sanc_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then 1 end ,0)) as bank_sanc ,sum( nvl(case when bd.loan_sanc_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then round(bd.elig_mm/100000,2) end ,0)) as bank_sanc_mm,sum( nvl(case when bd.mm_claim_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then 1 end ,0)) as mm_claim ,sum( nvl(case when bd.mm_claim_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then round(bd.mm_claim_amt/100000,2) end ,0)) as mm_claim_amt ,sum( nvl(case when bd.mm_rel_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then 1 end ,0)) as mm_rel ,sum( nvl(case when bd.mm_rel_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then round(bd.mm_rel_amt/100000,2) end ,0)) as mm_rel_amt ,sum( nvl(case when bd.mm_rel_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then ad.emp_env end ,0)) as emp ,sum( nvl(case when bd.edp_cert_iss_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then 1 end ,0)) as edp_cert_iss ,sum( nvl(case when ad.bank_f_date between '01-APR-2013' and '15-JAN-2014' and bd.act_id=3 then round(mminvolve(bd.app_id)/100000,2) end ,0)) as bank_rej_mm,sum( nvl(case when ad.bank_f_date between '01-APR-2013' and '15-JAN-2014' and bd.act_id=3 then 1 end ,0)) as bank_reject ,sum( nvl(case when ad.bank_f_date between '01-APR-2013' and '15-JAN-2014' and bd.act_id=8 then 1 end ,0)) as pend_bank_sanc ,sum( nvl(case when ad.bank_f_date between '01-APR-2013' and '15-JAN-2014' and bd.act_id=8 then round(mminvolve(bd.app_id)/100000,2) end ,0)) as pend_bank_sanc_mm ,sum( nvl(case when bd.mm_claim_dt between '01-APR-2013' and '15-JAN-2014' and bd.mm_rel_dt is null and bd.act_id=11 then round(bd.mm_claim_amt/100000,2) end ,0)) as Pend_mmrel_amt ,sum( nvl(case when bd.mm_claim_dt between '01-APR-2013' and '15-JAN-2014' and bd.mm_rel_dt is null and bd.act_id=11 then 1 end ,0)) as Pend_mmrel ,sum( nvl(case when bd.pv_dt between '01-APR-2013' and '15-JAN-2014' and bd.act_id=11 then 1 end ,0)) as pv_no FROM app_detail ad, bank_detail bd, m_district dm, mas_off_mast mom,m_state ms,app_meeting_mast amm,ZONE_MAST ZM where ad.app_id=bd.app_id(+) and ad.unit_dist_cd=dm.district_cd and dm.state_cd=ms.state_cd and ad.mtg_id=amm.mtg_id(+) AND MOM.AGENCY_TYPE LIKE '%%' AND ZM.ZONE_NM LIKE '%%' AND MS.STATE_NM LIKE '%%' AND MOM.AGENCY_TYPE LIKE '%%' AND ZM.ZONE_NM LIKE '%%' AND MS.STATE_NM LIKE '%%' AND MOM.OFF_NAME1 LIKE '%%' and ad.off_cd=mom.off_cd(+) AND MS.zone_cd=ZM.zone_cd group by ROLLUP(MOM.AGENCY_TYPE) ORDER BY MOM.AGENCY_TYPE )A]]>
	</queryString>
	<field name="ZONE_NM" class="java.lang.String"/>
	<field name="OFF_NAME1" class="java.lang.String"/>
	<field name="TOTALDATAENTERED" class="java.math.BigDecimal"/>
