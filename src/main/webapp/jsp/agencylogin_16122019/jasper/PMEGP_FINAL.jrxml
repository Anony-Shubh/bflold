	<field name="BANK_REJ_MM" class="java.math.BigDecimal"/>
	<field name="BANK_REJECT" class="java.math.BigDecimal"/>
	<field name="PEND_BANK_SANC" class="java.math.BigDecimal"/>
	<field name="PEND_BANK_SANC_MM" class="java.math.BigDecimal"/>
	<field name="PEND_MMREL_AMT" class="java.math.BigDecimal"/>
	<field name="PEND_MMREL" class="java.math.BigDecimal"/>
	<field name="PV_NO" class="java.math.BigDecimal"/>
