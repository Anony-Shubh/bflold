	<subDataset name="New Dataset 1" uuid="fe6eaf85-a0d6-475a-8ab5-94e1f3c34140">
		<parameter name="wrcls" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT RBI.BANK_NAME,
  AD.APP_ID,
  AD.APP_NAME,
  AD.IFSC_CODE,
  MOM.AGENCY_TYPE,RBI.BRANCHNAME,
  CASE  WHEN NVL(bd.ACT_ID, 0) IN (0, 8)
  THEN ROUND(NVL(mminvolve(ad.APP_ID), 0) / 100000, 2)
  WHEN AD.ACT_ID=5 AND BD.ACT_ID=11 AND BD.LOAN_DOCFNAME IS NULL
  AND BD.MM_CLAIM_DT IS NULL
  THEN  ROUND(MMINV_BANKADMIT(AD.APP_ID)/100000,2) END
  AS MMINVOVE,
  CASE  WHEN NVL(bd.ACT_ID, 0) IN (0, 8)
  THEN (NVL(DLTFC_CE,0)+NVL(DLTFC_WC,0))
  WHEN AD.ACT_ID=5 AND BD.ACT_ID=11 AND BD.LOAN_DOCFNAME IS NULL
  AND BD.MM_CLAIM_DT IS NULL
  THEN NVL(BD.MACHINARY_COST,0)+NVL(BD.WORKING_CAPITAL,0) END AS PRJ_COST,
  MOM.OFF_NAME1,
  MD.DISTRICT_NAME,
  MS.STATE_NM,
  ZM.ZONE_NM
FROM APP_DETAIL AD,
  BANK_DATAENTRY BD,
  MAS_OFF_MAST MOM,
  RBIBANKLIST RBI,
  M_DISTRICT MD,
  M_STATE MS,
  ZONE_MAST ZM
WHERE AD.APP_ID        = BD.APP_ID(+)
AND MOM.OFF_CD         = AD.OFF_CD
AND AD.IFSC_CODE       = RBI.IFSC_CODE
AND AD.UNIT_DIST_CD    = MD.DISTRICT_CD
AND MD.STATE_CD        = MS.STATE_CD
AND MS.ZONE_CD         = ZM.ZONE_CD
AND AD.ACT_ID          = 5
$P!{wrcls}]]>
		</queryString>
		<field name="BANK_NAME" class="java.lang.String"/>
		<field name="APP_ID" class="java.lang.String"/>
		<field name="APP_NAME" class="java.lang.String"/>
		<field name="IFSC_CODE" class="java.lang.String"/>
		<field name="AGENCY_TYPE" class="java.lang.String"/>
		<field name="BRANCHNAME" class="java.lang.String"/>
		<field name="MMINVOVE" class="java.math.BigDecimal"/>
		<field name="PRJ_COST" class="java.math.BigDecimal"/>
		<field name="OFF_NAME1" class="java.lang.String"/>
		<field name="DISTRICT_NAME" class="java.lang.String"/>
		<field name="STATE_NM" class="java.lang.String"/>
		<field name="ZONE_NM" class="java.lang.String"/>
	</subDataset>
	<parameter name="wrcls" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 1 FROM DUAL]]>
	</queryString>
	<field name="1" class="java.math.BigDecimal"/>
