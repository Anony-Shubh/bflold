	<subDataset name="New Dataset 1" uuid="4bb09f14-15b0-4f3c-97c1-239e91b34219">
		<parameter name="PBATCHID" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="PBANK_NAME" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="POFF_CD" class="java.lang.String"/>
		<parameter name="PTXTSEARCH" class="java.lang.String"/>
		<queryString>
			<![CDATA[
SELECT ROWNUM AS SRNO, ad.app_id,ad.app_name,UPPER(ad.fh_name) AS FH_NAME,mom.agency_type, mom.off_name,ad.bank_name, NVL(ad.remarks,'') AS Remraks_up_rej ,AD.UNIT_LOC,
 ms.state_nm,ad.mob_no2 AS TEL_NO,ad.E_MAIL, to_char(ad.aadhar_no)  AADHAR_NO,TO_CHAR(AD.ONLINE_SUBDT,'DD-MON-RRRR') ONLINESUBDT,  AD.BENF_SPECAT_CD,BD.PAY_STATUS,BD.UTRN_NO,BD.FAIL_REASON,
 ad.app_post_addr||' , '||ad.app_taluk_block||' '|| ' Dist:'||bend.district_name||'
 Pin:'||ad.app_pin as app_addr,ad.mob_no1  AS ONLINEMOBNO ,MMINVOLVE(AD.APP_ID) AS MM_INV,
 BTM.benf_type_desc,bcm.benf_category_desc,ad.gender,to_char(ad.dob,'dd-mon-RRRR') as dob,
 decode (ad.act_id ,1,asm.act_desc||' At Agency-'||ad.remarks) as dltfc_remarks,
 case when ad.dob is not null then round(months_between(ad.app_rec_date,ad.dob)/12,0) end as age,
 (case when ad.act_id=7 then '-No-' when ad.act_id=5 then '-Yes-' end) as DLTFC_REJ_yn,decode
 (ad.act_id ,7,ad.remarks) as dltfc_status, case when ad.act_id<>5 then asm.act_desc else
 bas.act_desc end as current_status,udm.district_name as Unit_district, edm.edu_desc,
 ad.unit_post_addr||' '||ad.unit_taluk_block||' Dist:'||udm.district_name||' Pin:'||ad.unit_pin as unit_addr,UPPER(ad.unit_taluk_block) AS UNIT_TALUK_BLOCK,
 decode (ad.ind_type,'S','Service','Manufacturing') As ind_type,
 igm.ind_grp_long_desc,am.activity_name||' / '||PROD_DESC AS activity_name,nvl(ad.workshed_cost,0)+nvl(ad.pre_ope_exp,0)
 +nvl(ad.machinary_cost,0)+nvl(ad.working_capital,0) as proj_cost, ad.bank_name||' ,
 '||ad.bank_post_addr||','||ad.bank_taluk_block||'IFSC Code:'|| ad.IFSC_CODE as bank_addr,
 (case when bd.act_id=3 then 'No' when bd.act_id=11 then '-Yes-' when bd.act_id=8 then '-' end)
 bank_Status, to_char(ad.app_rec_date,'dd-mon-RRRR') as app_rec_date,to_char(amm.mt_date,'dd-mon-RRRR')
 as mt_date,amm.mtg_place,to_char(ad.bank_f_date,'dd-mon-RRRR') as bank_f_date, to_char(bd.bank_rec_dt,'dd-mon-RRRR')
 as bank_rec_date, DECODE(BD.ACT_ID,3,bd.bank_remarks,'') as bank_remarks, to_char(bd.loan_sanc_dt,'dd-mon-RRRR') as loan_sanc_dt,
 (Nvl(bd.machinary_cost,0)) AS
 CE, nvl(bd.working_capital,0) as WORKING_CAPITAL,(NVL(bd.machinary_cost,0)+ NVL(bd.working_capital,0))
 As total_sanc, bd.own_contribution, 0  AS bank_loan, bd.MM_CLAIM_AMT,edpom.off_name,
 BD.EDP_TRG_NAME AS edp_trg_nm, to_char(bd.edp_fr_dt,'dd-mon-RRRR') as edp_fr_dt, to_char(bd.edp_to_dt,'dd-mon-RRRR')
 as edp_to_dt, to_char(bd.EDP_CERT_DT,'dd-mon-RRRR') as
 EDP_CERT_DT,'' as Nodal_bank,NVL(BD.CE_SANC_FB,0) AS CE_SANC_FB ,NVL(BD.WC_SANC_FB,0) AS WC_SANC_FB ,NVL(BD.CE_SANC_FB,0)+NVL(BD.WC_SANC_FB,0) AS TOT_SANC_FB,
 bd.ist_loan_amt, case when bd.edp_to_dt is not null then (bd.edp_to_dt-bd.edp_fr_dt)+1 end as edp_days,
 to_char(bd.IST_LOAN_dt,'dd-mon-RRRR') AS ist_loan_dt, bd.cgtsi, bd.mm_claim_lrno, to_char(bd.mm_claim_dt,'dd-mon-RRRR')
 as mm_claim_dt, bd.mm_claim_amt, bd.mm_rel_amt,to_char(bd.MM_REL_dt,'dd-mon-RRRR') AS mm_rel_dt, bd.emp,MRT.CO_REMARKS,
 bd.prod, bd.sales, to_char(bd.pv_dt,'dd-mon-RRRR') as pv_dt , bd.pv_ver_off,bd.mm_adj_by, bd.mm_adj_amt,to_char(bd.MM_ADJ_DT,'dd-mon-RRRR')
 AS mm_adj_dt, bd.edp_yn, bd.ph_yn, bd.pv_status, bd.OWN_CONTRIBUTION, to_char(bd.OWN_CONT_DT,'dd-mon-RRRR') AS OWN_CONT_DT,
 bd.phy_prod, bd.phy_sales, bd.phy_emp, bd.phy_inv FROM app_detail ad, bank_dataentry bd, m_district dm,
 mas_off_mast mom,m_state ms,app_meeting_mast amm,benf_type_mast BTM, benf_category_mast bcm,m_district bend,
 education_mast edm,m_district udm,app_status_mast asm,bank_app_status bas, activity_mast am,
 ind_grp_mast igm,
 mas_off_mast edpom,MM_REMARKS_TRANS MRT,
 zone_mast zm where ms.zone_cd=zm.zone_cd and BD.REMTRID=MRT.REMTR_ID (+) AND
 ad.app_id=bd.app_id(+) and ad.unit_dist_cd=dm.district_cd and dm.state_cd=ms.state_cd and
 ad.mtg_id=amm.mtg_id(+) and ad.act_id=asm.act_id and bd.act_id=bas.act_id(+) and
  ad.app_dist_cd=bend.district_cd and AD.benf_type_cd=BTM.benf_type_cd
 and ad.benf_catagory_cd=bcm.benf_category_cd and ad.edu_id=edm.edu_id and ad.unit_dist_cd=udm.district_cd
 and bd.tr_id=edpom.off_cd(+)  and MOM.OFF_CD=$P{POFF_CD}

 $P!{PTXTSEARCH}


 and ad.off_cd=mom.off_cd and ad.activity_cd=am.activity_cd and am.ind_grp_cd=igm.ind_grp_cd
]]>
		</queryString>
