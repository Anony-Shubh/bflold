		<variableExpression><![CDATA[$F{NO_OF_APP}]]></variableExpression>
	</variable>
	<variable name="RET_BY_AGENCY_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{RET_BY_AGENCY}]]></variableExpression>
	</variable>
