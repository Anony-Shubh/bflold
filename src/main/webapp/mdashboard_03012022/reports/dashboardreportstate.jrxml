	<variable name="FOR_DECISION_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{FOR_DECISION}]]></variableExpression>
	</variable>
	<variable name="BANK_REJ_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{BANK_REJ}]]></variableExpression>
	</variable>
