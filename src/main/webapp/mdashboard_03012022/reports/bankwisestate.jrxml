<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TA_DA" language="groovy" pageWidth="1296" pageHeight="595" orientation="Landscape" columnWidth="1256" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7426a13f-b017-4a02-a137-80587d4de19d">
	<property name="ireport.zoom" value="0.9090909090909121"/>
	<property name="ireport.x" value="199"/>
	<property name="ireport.y" value="0"/>
	<parameter name="STATE_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="STATE_NM" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="FROMDT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="TODT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT BANK_NAME, BANK_FORD, LOAN_SANC, CLAIM_BY_BANK_NO, CLAIM_BY_BANK_MM, MM_REL_NO, MM_REL_AMT, FOR_DECISION, BANK_REJ FROM (SELECT
    RBL.BANK_NAME,
     SUM(
     CASE
       WHEN AD.ACT_ID = 5
       AND TRUNC(AD.BANK_F_DATE) BETWEEN $P{FROMDT} AND $P{TODT}
       THEN 1
       ELSE 0
     END) BANK_FORD,

     SUM(
     CASE
       WHEN BD.ACT_ID = 11
       AND TRUNC(BD.LOAN_SANC_DT) BETWEEN $P{FROMDT} AND $P{TODT}
       THEN 1
       ELSE 0
     END) LOAN_SANC,
     SUM(
     CASE
       WHEN BD.ACT_ID = 11
       AND TRUNC(BD.MM_CLAIM_DT) BETWEEN $P{FROMDT} AND $P{TODT}
       THEN 1
       ELSE 0
     END) CLAIM_BY_BANK_NO,
     ROUND(SUM(
     CASE
       WHEN BD.ACT_ID = 11
       AND TRUNC(BD.MM_CLAIM_DT)  BETWEEN $P{FROMDT} AND $P{TODT}
       THEN BD.MM_CLAIM_AMT
       ELSE 0
     END) / 10000000, 2) CLAIM_BY_BANK_MM,
     SUM(
     CASE
       WHEN BD.PACT_ID = 34
       AND TRUNC(BD.MM_REL_DT)  BETWEEN $P{FROMDT} AND $P{TODT}
       THEN 1
       ELSE 0
     END) MM_REL_NO,
     ROUND(SUM(
     CASE
       WHEN BD.PACT_ID = 34
       AND TRUNC(BD.MM_REL_DT) BETWEEN $P{FROMDT} AND $P{TODT}
       THEN BD.MM_REL_AMT
       ELSE 0
     END) / 10000000, 2) MM_REL_AMT,
     SUM(
     CASE
       WHEN AD.ACT_ID         = 5
       AND NVL(BD.ACT_ID, 0) IN (0, 8)
       AND TRUNC(AD.BANK_F_DATE) BETWEEN $P{FROMDT} AND $P{TODT}
       THEN 1
       ELSE 0
     END) FOR_DECISION,
     SUM(
     CASE
       WHEN AD.ACT_ID = 5
       AND BD.ACT_ID  = 3
       AND TRUNC(AD.BANK_F_DATE) BETWEEN $P{FROMDT} AND $P{TODT}
       THEN 1
       ELSE 0
     END) BANK_REJ

   FROM APP_DETAIL AD,
     BANK_DATAENTRY BD,
     M_DISTRICT MD,
     M_STATE MS,
     MAS_OFF_MAST MOM,
     RBIBANKLIST RBL
   WHERE AD.APP_ID    = BD.APP_ID(+)
   AND AD.OFF_CD      = MOM.OFF_CD
   AND AD.APP_DIST_CD = MD.DISTRICT_CD
   AND MD.STATE_CD    = MS.STATE_CD
   AND AD.IFSC_CODE   = RBL.IFSC_CODE
AND MS.STATE_CD=$P{STATE_CD}

   GROUP BY
     RBL.BANK_NAME
      ) ORDER BY BANK_FORD DESC]]>
	</queryString>
	<field name="BANK_NAME" class="java.lang.String"/>
	<field name="BANK_FORD" class="java.math.BigDecimal"/>
	<field name="LOAN_SANC" class="java.math.BigDecimal"/>
	<field name="CLAIM_BY_BANK_NO" class="java.math.BigDecimal"/>
	<field name="CLAIM_BY_BANK_MM" class="java.math.BigDecimal"/>
	<field name="MM_REL_NO" class="java.math.BigDecimal"/>
	<field name="MM_REL_AMT" class="java.math.BigDecimal"/>
	<field name="FOR_DECISION" class="java.math.BigDecimal"/>
	<field name="BANK_REJ" class="java.math.BigDecimal"/>
