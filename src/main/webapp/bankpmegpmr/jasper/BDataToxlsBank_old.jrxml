	<parameter name="PWHERECLS" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PFROMDT" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PTODT" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PSPONS_BANKNM" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT BM.hirone,BM.hirtwo,b.app_id,
om.agency_type,
OM.off_name1 AS AGENCY_STATE,
UPPER(b.app_name) AS APP_NAME,
b.fh_name,b.AADHAR_NO,B.E_MAIL,b.MOB_NO1 AS TEL_NO,
decode (upper(b.gender),'MALE','M','F') AS Gender,
C.benf_category_cd as cat,
(nvl(B.workshed_cost,0)+nvl(B.pre_ope_exp,0)+nvl(B.machinary_cost,0)+nvl(B.working_capital,0)) as Prop_proj_cost,
MMINVOLVE(B.app_id) AS MMINV_PRJCOST,
b.bank_f_date as bank_f_date ,b.IFSC_CODE AS br_code,
BM.br_name as bank_name,
B.branch_name,
case when nvl(a.act_id,0) in (0,8) then
'Forwarded'
when a.act_id=3 then
'Rejected'
else
'Sanctioned'
end as status,
 a.bank_rec_dt ,
 bank_remarks AS REJ_REASON,
 a.loan_sanc_dt AS loan_sanc_dt,
  nvl(a.workshed_cost,0)+ nvl( a.machinary_cost,0)+ nvl( a.pre_ope_cost,0) As SANC_TOTAL_CE,
   a.working_capital AS SANC_WC,
    nvl(a.workshed_cost,0)+ nvl( a.machinary_cost,0)+ nvl( a.pre_ope_cost,0)+ NVL(a.working_capital,0) As TOTAL_LOAN_SANC,
   a.own_contribution, to_char(a.own_cont_dt,'DD-MON-YYYY') AS own_cont_dt,
    to_char(a.ist_loan_dt,'DD-MON-YYYY') AS loan_rel_dt,
   a.ist_loan_amt as loan_rel_amt, a.cgtsi, a.mm_claim_lrno,
   to_char(a.mm_claim_dt,'DD-MON-YYYY') AS mm_claim_dt,
   a.mm_claim_amt, to_char(a.mm_rel_dt,'DD-MON-YYYY') as mm_rel_dt, a.mm_rel_amt,
   a.emp, a.prod, a.sales, to_char(a.tdr_adj_dt,'DD-MON-YYYY') as tdr_adj_dt,
    a.tdr_adj_amt,
    to_char(a.time_stamp,'DD-MON-YYYY:HH:MM:SS') as LAST_UPDATE_DT FROM
    bank_dataentry a, app_detail b,BENF_CATEGORY_MAST C,
     M_DISTRICT UD, M_STATE UST,
      bank_br_mast BM ,MAS_OFF_MAST OM WHERE b.app_id=a.app_id(+)
       and b.benf_catagory_cd=C.benf_category_cd and
       B.unit_dist_cd=UD.district_cd
       AND B.off_cd=OM.off_cd AND UD.state_cd=UST.state_cd
       AND B.IFSC_CODE=BM.BR_IFSL_CODE AND B.ACT_ID=5
        AND TRUNC(B.bank_f_date) BETWEEN $P{PFROMDT} AND $P{PTODT} AND
BM.br_name LIKE $P{PSPONS_BANKNM} $P!{PWHERECLS}]]>
	</queryString>
