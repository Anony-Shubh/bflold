	<parameter name="PWHERECLS" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PFROMDT" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PTODT" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PSPONS_BANKNM" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  /*+ PARALLEL(AUTO) */
  CASE
    WHEN NVL(a.ACT_ID, 0) IN (0)
    THEN 'Yet To Be Processed By Bank'
    WHEN a.ACT_ID = 8
    THEN 'Under Process at Bank'
    WHEN a.ACT_ID = 3
    THEN 'Rejected'
    ELSE 'Sanctioned'
  END AS status,
  b.APP_ID,
  OM.AGENCY_TYPE,
  OM.OFF_NAME1      AS AGENCY_STATE,
  UPPER(b.APP_NAME) AS APP_NAME,
  b.UNIT_POST_ADDR
  || ', '
  || b.UNIT_TALUK_BLOCK
  || ', '
  || UD.DISTRICT_NAME
  || ', '
  || b.UNIT_PIN AS communication_address,
  DECODE(b.aadhar_no,NULL,NULL, '*****' || substr(b.aadhar_no,7,length(b.aadhar_no)-6)) AADHAR_NO,
  DECODE(b.MOB_NO1,NULL,NULL, '*****'    || substr(b.MOB_NO1,6,length(b.MOB_NO1)-5)) AS TEL_NO,
DECODE(b.PAN_NO,NULL,NULL, '*****'     || substr(b.PAN_NO,6,length(b.PAN_NO)-5)) AS PAN_NO,
 REPLACE(b.E_MAIL,substr(b.E_MAIL, instr(b.E_MAIL, '@')-2,2),'**') AS E_MAIL,
  b.PAN_NO,
  b.UNIT_LOC,
  b.UNIT_POST_ADDR,
  b.UNIT_TALUK_BLOCK,
  UD.DISTRICT_NAME,
  b.UNIT_PIN,
  DECODE(upper(b.GENDER), 'MALE', 'M', 'F') AS Gender,
 C.BENF_CATEGORY_CD AS cat,
   b.BENF_SPECAT_CD,

    CASE
    WHEN  b.IND_TYPE = 'M'
    THEN 'MANNUFACTURING'
    WHEN b.IND_TYPE = 'T'
    THEN 'TRADING'
    WHEN b.IND_TYPE = 'S'
    THEN 'SERVICE'
    ELSE 'Sanctioned'
  END AS IND_TYPE,


   AM.ACTIVITY_NAME,
  b.PROD_DESC,
  CASE when nvl(b.dltfc_ce,0)+nvl(b.dltfc_wc,0) > 0 then
  nvl(b.dltfc_ce,0)+nvl(b.dltfc_wc,0)
  else
   NVL(b.MACHINARY_COST, 0) + NVL(b.WORKING_CAPITAL,0)
   end  Prop_proj_cost,
  MMINVOLVE(b.APP_ID)                                                                                      AS MMINV_PRJCOST,
  b.BANK_F_DATE                                                                                            AS bank_f_date,
  b.IFSC_CODE                                                                                              AS br_code,
  RBI.BANK_NAME                                                                                              AS bank_name,
  RBI.BRANCHNAME AS BRANCH_NAME,
  a.BANK_REC_DT,
  a.BANK_REMARKS                                       AS REJ_REASON,
  NVL(a.MACHINARY_COST, 0)                             AS ce_apprv_bank,
  NVL(a.WORKING_CAPITAL, 0)                            AS wc_apprv_bank,
  NVL(a.MACHINARY_COST, 0) + NVL(a.WORKING_CAPITAL, 0) AS total_apprv_bank,
  NVL(a.CE_SANC_FB, 0)                                 AS sanc_total_ce,
  NVL(a.WC_SANC_FB, 0)                                 AS sanc_wc,
  NVL(a.CE_SANC_FB, 0) + NVL(a.WC_SANC_FB, 0)          AS total_loan_sanc,
  a.LOAN_SANC_DT                                       AS loan_sanc_dt,
  TO_CHAR(a.OWN_CONT_DT, 'DD-MON-YYYY')                AS own_cont_dt,
  a.OWN_CONTRIBUTION,
  a.EDP_TRG_NAME,
  a.EDP_FR_DT,
  a.EDP_TO_DT,
  (TRUNC(a.EDP_TO_DT)-TRUNC(a.EDP_FR_DT)) AS EDP_TRAIN_DURATION,
  a.EDP_CERT_DT,
  TO_CHAR(a.IST_LOAN_DT, 'DD-MON-YYYY') AS loan_rel_dt,
  a.IST_LOAN_AMT                        AS loan_rel_amt,
  a.APPLOAN_ACCNO,
  a.CGTSI,
  TO_CHAR(a.MM_CLAIM_DT, 'DD-MON-YYYY') AS mm_claim_dt,
  a.MM_CLAIM_AMT,
  TO_CHAR(a.MM_REL_DT, 'DD-MON-YYYY') AS mm_rel_dt,
  a.MM_REL_AMT,
  a.PAY_STATUS AS MM_DIS_STATUS,
  a.UTRN_NO AS MM_DIS_REF_NO,
  a.FAIL_REASON,
  TO_CHAR(a.TDR_ADJ_DT, 'DD-MON-YYYY') AS tdr_adj_dt,
  a.TDR_ADJ_AMT,
a.FB_ACNO,BM.NEFT_IFSC,
  BM.HIRONE,
  BM.HIRTWO,
  TO_CHAR(a.TIME_STAMP, 'DD-MON-YYYY:HH:MM:SS') AS LAST_UPDATE_DT,
CASE WHEN NVL(a.PACT_ID,0)=30 AND a.APPRV_YN='A' THEN 'Y' ELSE 'N' END AS STATUS_ref,
CASE WHEN NVL(a.PACT_ID,0)=30 AND a.APPRV_YN='A' THEN MRT.CO_REMARKS ELSE '-' END AS ref_rem
  FROM bank_dataentry a,
  app_detail b,
  BENF_CATEGORY_MAST C,
  M_DISTRICT UD,
  M_STATE UST,
  bank_br_mast BM,
  MAS_OFF_MAST OM,
  ACTIVITY_MAST AM,RBIBANKLIST RBI,MM_REMARKS_TRANS MRT
WHERE b.APP_ID         = a.APP_ID(+)
AND b.BENF_CATAGORY_CD = C.BENF_CATEGORY_CD
AND b.UNIT_DIST_CD     = UD.DISTRICT_CD
AND b.OFF_CD           = OM.OFF_CD
AND UD.STATE_CD        = UST.STATE_CD
AND AM.ACTIVITY_CD      = B.ACTIVITY_CD
AND b.IFSC_CODE        = BM.BR_IFSL_CODE
AND BM.BR_IFSL_CODE=RBI.IFSC_CODE
AND a.REMTRID = MRT.REMTR_ID(+)
AND b.ACT_YN='Y'
AND b.ACT_ID           = 5
AND UPPER(BM.SPON_BANK_NAME) LIKE UPPER($P{PSPONS_BANKNM})
AND TRUNC(b.BANK_F_DATE) BETWEEN $P{PFROMDT} AND $P{PTODT}
$P!{PWHERECLS}]]>
	</queryString>
