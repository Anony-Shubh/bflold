	<subDataset name="EDPSAMADHANDS" uuid="f60eef62-7c66-4fcf-a263-d6fb3a6abb00">
		<parameter name="PINVMONTH" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
   mq.srno, mq.state,mq.off_name1, mq.off_cd, mq.zone,sq.invupid,
   mq.dt, mq.kvicedp,mq.kvibedp, mq.dicedp, mq.coiredp, mq.no_ofapp,
   sq.inv_no, sq.updoc_edp,sq.total_amt, TO_CHAR(sq.inv_date,'DD-MON-YYYY')inv_date, sq.forward_dt,
   sq.total_amt, sq.inv_date,sq.fopay_dt,sq.fopay_amt,sq.fo_disallowment,sq.tds_amt,sq.PAYDETAILS,sq.ANY_REMARKS
   FROM  ( SELECT  0 AS srno, ms.state_nm      AS state,
   mom.off_name2 AS OFF_NAME1,mom.mis_off_cd2   AS off_cd,zm.zone_nm       AS zone,
   to_char(last_day(BSA.inv_date),'DD-MON-RRRR') AS dt,
   SUM(decode(mom.agency_type, 'KVIC', 1, 0)) AS kvicedp,
   SUM(decode(mom.agency_type, 'KVIB', 1, 0)) AS kvibedp,
   SUM(decode(mom.agency_type, 'DIC', 1, 0)) AS dicedp,
   SUM(decode(mom.agency_type, 'COIR', 1, 0)) AS coiredp,
   COUNT(*) AS no_ofapp FROM app_detail       ad,
    mas_off_mast mom,   m_state ms, zone_mast   zm,
   m_district    md ,BNF_SAMADHANEDP_APPDETAIL BSA WHERE  ad.app_id =BSA.APP_ID  AND ad.off_cd = mom.off_cd

   AND ms.zone_cd = zm.zone_cd  AND md.district_cd = mom.district_cd
   AND ms.state_cd = md.state_cd AND last_day(trunc(bsa.inv_date)) = $P{PINVMONTH}
   AND mom.off_type_cd IN (2,3,22,5, 27 ) AND AD.ACT_ID=5
   GROUP BY   ms.state_nm,mom.off_name2,mom.mis_off_cd2,zm.zone_nm, last_day(BSA.inv_date)
   ) mq,( SELECT  boi.off_cd,boi.inv_no,DECODE(boi.updoc_edp,NULL,'NO','YES') AS UPDOC_EDP,boi.total_amt,
   boi.inv_date,to_char(boi.fopay_dt,'DD-MON-RRRR') as fopay_dt,boi.fopay_amt,boi.fo_disallowment,boi.tds_amt,boi.PAYDETAILS,
   boi.forward_dt ,boi.invupid,boi.ANY_REMARKS from  bnf_onlineedp_inf boi
   WHERE   last_day(trunc(boi.month_dt)) =$P{PINVMONTH}  )sq
   WHERE    mq.off_cd = sq.off_cd (+) order by state]]>
		</queryString>
		<field name="SRNO" class="java.math.BigDecimal"/>
		<field name="STATE" class="java.lang.String"/>
		<field name="OFF_NAME1" class="java.lang.String"/>
		<field name="OFF_CD" class="java.math.BigDecimal"/>
		<field name="ZONE" class="java.lang.String"/>
		<field name="INVUPID" class="java.math.BigDecimal"/>
		<field name="DT" class="java.lang.String"/>
		<field name="KVICEDP" class="java.math.BigDecimal"/>
		<field name="KVIBEDP" class="java.math.BigDecimal"/>
		<field name="DICEDP" class="java.math.BigDecimal"/>
		<field name="COIREDP" class="java.math.BigDecimal"/>
		<field name="NO_OFAPP" class="java.math.BigDecimal"/>
		<field name="INV_NO" class="java.lang.String"/>
		<field name="UPDOC_EDP" class="java.lang.String"/>
		<field name="TOTAL_AMT" class="java.math.BigDecimal"/>
		<field name="INV_DATE" class="java.lang.String"/>
		<field name="FORWARD_DT" class="java.sql.Timestamp"/>
		<field name="FOPAY_DT" class="java.lang.String"/>
		<field name="FOPAY_AMT" class="java.math.BigDecimal"/>
		<field name="FO_DISALLOWMENT" class="java.math.BigDecimal"/>
		<field name="TDS_AMT" class="java.math.BigDecimal"/>
		<field name="PAYDETAILS" class="java.lang.String"/>
		<field name="ANY_REMARKS" class="java.lang.String"/>
	</subDataset>
	<parameter name="PMINVDT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 1 FROM DUAL]]>
	</queryString>
	<field name="1" class="java.math.BigDecimal"/>
